@Logic
script StageManager extends Logic

	-- 전투 유형(CombatStageType): normal / elite / shop / boss (elite_stage_design_spec §1)
	@Sync
	property string StageType = "normal"

	@Sync
	property integer SpawnedCount = 0

	@Sync
	property integer KilledCount = 0

	@Sync
	property boolean StageActive = false

	-- 서버: 현재 스테이지 적 구성 [{model, x, y}]
	property any composition = nil

	property integer spawnSerial = 0

	-- 진입 유예: 이 시각(ServerElapsedSeconds)까지 적 행동 정지 (스폰 캠핑 방지)
	property number combatGraceUntil = -999.0

	-- 일시정지: true면 IsGraceActive가 항상 true → 전 적 AI 정지 (ESC 일시정지 메뉴, 서버 권위).
	property boolean combatPaused = false

	-- 클라: 보상 UI 컨트롤러 참조 (RewardController가 등록)
	property any rewardUI = nil

	-- 클라: 게임오버 UI 컨트롤러 참조
	property any gameOverUI = nil

	-- 클라: 풀스크린 검정 페이드 오버레이 참조(FadeOverlay가 OnBeginPlay에서 등록). 사망→부활 화면 전환.
	@HideFromInspector property any fadeOverlay = nil

	-- 클라: 회귀 연출 오버레이(RegressionOverlay가 OnBeginPlay에서 등록). 게임오버/클리어 버튼이 조회. (MR-AE)
	@HideFromInspector property any regressionOverlay = nil

	-- 서버: 추적 중인 플레이어 엔티티 (1인 1런 전제, 멀티맵 조회용)
	property any trackedPlayer = nil

	-- 서버: 맵 전환 대기 상태 (전투 스테이지 진입 시 맵 도착 폴링)
	property boolean awaitingMap = false

	-- 서버: 이번 ResetStage가 "새 스테이지 진입"인지 여부. true=진입(아이템 슬롯 스냅샷) / false=사망 재시작(스냅샷 복구).
	-- StartStageAt/StartStage 진입점에서 true로 세팅, ResetStage가 소비 후 false로 되돌린다.
	property boolean freshStage = false

	property string pendingMapId = ""

	-- 이번 스테이지의 실제 맵 이름 (일반=테마맵 / 보스=map03 / 상점=map04). 1회 확정, GetMap까지 유지.
	@Sync
	property string CurrentMapId = ""

	-- 서버: 이번 스테이지 플레이어 스폰 월드좌표 (Stage의 SpawnPointPosition에서 산출 / 보스·상점=(0,0.3)).
	property number curSpawnX = 0.0
	property number curSpawnY = 0.3

	-- 서버: 도착 후 동작 ("node"=Stage 스캔+노드선택 / "spawn"=ResetStage). 맵 진입 폴링용.
	property string pendingAfterArrival = ""

	-- 서버: 이번 노드에서 선택된 Stage 컨테이너 이름.
	property string pendingStage = ""

	-- 서버: 테마맵 스캔 캐시 { stageName -> {sx, sy, monsters=[{model,x,y}]} } + 순서배열 + 스캔완료 맵이름.
	property any stageData = nil
	property any stageOrder = nil
	property string preppedMap = ""
	-- 서버: 맵별 영속 스캔 캐시 { mapName -> { stageData, stageOrder } }. @Logic이라 세션 내내 유지.
	-- 마커는 첫 prep 때 1회 영구삭제되고 다시 안 생기므로, 재방문 시 재스캔하면 0마리가 된다.
	-- → 재방문은 재스캔 대신 이 캐시를 복원해야 한다 (재진입 스폰버그 근본 해결).
	property any preppedCache = nil

	@ExecSpace("ServerOnly")
	method void OnPlayerReady(Entity player)
		-- 첫 플레이어 입장 → 추적만 등록. 런은 로비 "구하러 가기"(RequestStartRun)에서 시작 (MR-L 로비 도입).
		self.trackedPlayer = player
		log("[StageManager] player ready -> waiting at lobby (run not auto-started)")
	end

	@ExecSpace("Server")
	method void RequestStartRun()
		-- 로비 "구하러 가기" → 런 시작 + 거울던전식 층 진행 (StartRun + 상점가격 초기화 + 1층 테마 선택).
		if _GameStateManager.RunActive then return end
		if self:GetPlayer() == nil then
			log_warning("[StageManager] RequestStartRun ignored — no tracked player yet")
			return
		end
		_GameStateManager:StartRun()
		_RunTimer:StartRun()
		_ShopManager:ResetPrices()
		_FloorManager:StartGameFlow()
		log("[StageManager] run started from lobby")
	end

	@ExecSpace("ServerOnly")
	method Entity GetPlayer()
		-- 추적 중인 플레이어 (멀티맵 조회: FloorManager/RewardManager가 맵 무관하게 사용).
		if self.trackedPlayer ~= nil and isvalid(self.trackedPlayer) then return self.trackedPlayer end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void MovePlayerToMap(string mapId)
		-- 플레이어를 대상 맵으로 이동 (이미 그 맵이면 생략). ★대상 맵은 아직 비활성이라 여기서
		-- GetEntityByPath로 조회하면 LEA-3004(PhysicsSimulator)가 뜬다 → 임시 좌표로만 진입하고,
		-- 정확한 스폰포인트 좌표는 도착 후 ResetStage→ClientStageReset가 활성 맵에서 해소한다.
		local player = self:GetPlayer()
		if player == nil then return end
		local cm = player.CurrentMap
		if cm ~= nil and isvalid(cm) and cm.Name == mapId then return end
		if self.StageType == "boss" then
			-- 보스맵은 SpawnLocation 엔티티로 크로스맵 이동 (맵마다 지면높이 달라 고정좌표 불가, 임시낙하 방지).
			player.PlayerComponent:MoveToEntityByPath("/maps/" .. mapId .. "/SpawnLocation")
		else
			player.PlayerComponent:MoveToMapPosition(mapId, Vector2(0, 0.3))
		end
		log("[StageManager] moving player -> " .. mapId)
	end

	@ExecSpace("ServerOnly")
	method void EnterMapForTheme()
		-- 테마 확정 후: 테마맵으로 1회 진입 → 도착 시 Stage 스캔 + 노드선택. (이미 그 맵이면 즉시 처리)
		local mapId = _GameConstants:MapForTheme(_FloorManager.CurrentTheme)
		self.CurrentMapId = mapId
		self.StageType = "normal"
		local player = self:GetPlayer()
		local cm = nil
		if player ~= nil then cm = player.CurrentMap end
		if player ~= nil and cm ~= nil and isvalid(cm) and cm.Name == mapId then
			self:PrepareStages(cm)
			_FloorManager:OnMapReady()
		else
			self.pendingMapId = mapId
			self.pendingAfterArrival = "node"
			self.awaitingMap = true
			self:MovePlayerToMap(mapId)
		end
		log("[StageManager] EnterMapForTheme -> " .. mapId)
	end

	@ExecSpace("ServerOnly")
	method void PrepareStages(Entity map)
		-- 테마맵 활성 상태에서 1회: Stage* 컨테이너별 (플레이어 스폰 + 몬스터 위치·종류) 캐시 후 프로토타입 전멸.
		if map == nil or isvalid(map) == false then return end
		if self.preppedCache == nil then self.preppedCache = {} end
		if self.preppedMap == map.Name then
			-- 이미 활성 맵: 현재 stageData/stageOrder가 이 맵 것 → 그대로 사용(연속 스테이지).
			log("[StageManager] PrepareStages 캐시 유지(active) map=" .. map.Name)
			return
		end
		-- ★맵별 영속 캐시 복원: 예전에 prep한 맵을 다시 밟은 경우, 재스캔하면 마커가 이미 삭제됐어 0마리가 된다.
		--   재스캔 대신 첫 prep 때 저장해둔 캐시를 되살린다 (보스 처치→테마교체→재방문 / ESC→재진입 전부 해결).
		local cached = self.preppedCache[map.Name]
		if cached ~= nil then
			self.stageData = cached.stageData
			self.stageOrder = cached.stageOrder
			self.preppedMap = map.Name
			log("[StageManager] PrepareStages 캐시 복원(restore) map=" .. map.Name .. " stages=" .. tostring(#self.stageOrder))
			return
		end
		self.stageData = {}
		self.stageOrder = {}
		local totalMobs = 0
		for _, child in ipairs(map.Children:ToTable()) do
			local n = child.Name
			if n ~= nil and string.sub(n, 1, 5) == "Stage" then
				local sx = 0.0
				local sy = 0.3
				-- 스폰포인트: 이름이 "SpawnPointPosition"으로 시작하는 자식(접미사 _1/_2… 허용) 중 첫째.
				local sp = nil
				for _, c in ipairs(child.Children:ToTable()) do
					if c.Name ~= nil and string.sub(c.Name, 1, 18) == "SpawnPointPosition" then
						sp = c
						break
					end
				end
				if sp ~= nil and isvalid(sp) then
					local p = sp.TransformComponent.WorldPosition
					sx = p.x
					sy = p.y
					-- 스폰 마커는 위치 참조용(modelId=spriterenderer, 빈 SpriteRUID) → 런타임엔 흰 박스로 렌더되므로 렌더만 끈다.
					local sr = sp.SpriteRendererComponent
					if isvalid(sr) then sr.Enable = false end
				end
				local mons = {}
				local hcs = child:GetChildComponentsByTypeName("script.EnemyHealth", true)
				for _, hc in ipairs(hcs) do
					local e = hc.Entity
					if isvalid(e) then
						-- ★ 배치된 마커의 "실제 모델"을 스폰해야 변종(MeleeEnemy 복제로 클립·수치만 바꾼 적)이 그대로 나온다.
						--   컴포넌트 타입으로 베이스만 추론하면 변종이 meleeenemy/rangedenemy로 납작해짐(버그). 이름=모델명 규약으로 실제 id 해석.
						-- 테마 스킨 우선: 이 테마의 melee/ranged 슬롯을 지정 잡몹으로 대체. 지정 없으면 배치된 실제 모델(이름 해석).
						local model = self:ThemeSkinModel(e)
						if model == nil then model = self:ResolveMarkerModel(e) end
						local wp = e.TransformComponent.WorldPosition
						table.insert(mons, { model = model, x = wp.x, y = wp.y })
					end
				end
				self.stageData[n] = { sx = sx, sy = sy, monsters = mons }
				totalMobs = totalMobs + #mons
				table.insert(self.stageOrder, n)
				log("[StageManager] stage '" .. n .. "' spawn=(" .. tostring(sx) .. "," .. tostring(sy) .. ") mobs=" .. tostring(#mons))
			end
		end
		-- 프로토타입(및 잔존 flat 적) 전멸 — 실제 전투 적은 캐시에서 fresh 스폰.
		local all = map:GetChildComponentsByTypeName("script.EnemyHealth", true)
		local destroyed = 0
		for _, hc in ipairs(all) do
			if isvalid(hc.Entity) then
				hc.Entity:Destroy()
				destroyed = destroyed + 1
			end
		end
		self.preppedMap = map.Name
		-- 첫 스캔 결과를 맵별 영속 캐시에 저장 → 다음 방문은 복원으로 처리(재스캔 금지).
		self.preppedCache[map.Name] = { stageData = self.stageData, stageOrder = self.stageOrder }
		log("[StageManager] PrepareStages map=" .. map.Name .. " stages=" .. tostring(#self.stageOrder) .. " cachedMobs=" .. tostring(totalMobs) .. " destroyedMarkers=" .. tostring(destroyed))
		-- ★재진입 스폰버그 스모킹건: Stage 컨테이너는 있는데(=stages>0) 캐시된 몹이 0마리면,
		--   이 맵의 마커가 "이전 prep/이전 세션"에서 이미 삭제된 뒤 재스캔된 것 (preppedMap 가드 우회 경로).
		if #self.stageOrder > 0 and totalMobs == 0 then
			log_error("[StageManager] ★재진입 스폰버그: map='" .. map.Name .. "' prep했으나 캐시몹 0마리 (마커 이미 삭제됨, 재스캔 무의미). destroyedMarkers=" .. tostring(destroyed))
		end
	end

	@ExecSpace("ServerOnly")
	method string BareModelId(string id)
		-- GetModelIdByName은 "model://<id>" 형태 반환 → SpawnByModelId용 bare id로 정규화(코드베이스 통일). 접두사 없으면 그대로.
		if string.sub(id, 1, 8) == "model://" then return string.sub(id, 9) end
		return id
	end

	@ExecSpace("ServerOnly")
	method string ThemeSkinModel(Entity e)
		-- 테마별 잡몹 스킨: 현재 테마의 melee 슬롯/ranged 슬롯을 지정 모델로 대체.
		-- 슬롯 = 마커의 AI 컴포넌트(EnemyMelee=근접 슬롯 / EnemyRanged=원거리 슬롯). 둘 다 아니면 스킨 안 함(nil).
		-- 지정 모델은 이름으로 조회(GetModelIdByName + BareModelId). 미지정 테마/모델은 nil → 호출부가 이름 기반 폴백.
		local isMelee = e:GetComponent("script.EnemyMelee") ~= nil
		local isRanged = e:GetComponent("script.EnemyRanged") ~= nil
		if isMelee == false and isRanged == false then return nil end
		local theme = _FloorManager.CurrentTheme
		local name = nil
		if theme == "orbis" then
			if isRanged then name = "RangedEnemy_Pixie" else name = "MeleeEnemy_Lioner" end
		elseif theme == "elnath" then
			if isRanged then name = "ChaserEnemy_Pepe" else name = "MeleeEnemy_WhiteFang" end
		elseif theme == "deepmine" then
			if isRanged then name = "RangedEnemy_Boogie" else name = "ChaserEnemy_JuniorBulldog" end
		end
		if name == nil then return nil end
		local id = _EntryService:GetModelIdByName(name)
		if id ~= nil and id ~= "" then return self:BareModelId(id) end
		return nil
	end

	@ExecSpace("ServerOnly")
	method string ResolveMarkerModel(Entity e)
		-- 배치된 마커의 실제 model id를 엔티티 이름(=모델명 규약)으로 해석 → 변종(MeleeEnemy 복제) 그대로 스폰.
		-- 이름 직접 조회 → 끝의 _<숫자> 접미사 제거 후 재조회 → 실패 시 컴포넌트 타입 베이스 폴백.
		local name = e.Name
		if name ~= nil and name ~= "" then
			local id = _EntryService:GetModelIdByName(name)
			if id ~= nil and id ~= "" then return self:BareModelId(id) end
			-- 끝의 _<숫자> 접미사 제거 후 재조회 (MeleeEnemy_1 → MeleeEnemy / MeleeEnemy_Lioner_2 → MeleeEnemy_Lioner)
			local base = string.match(name, "^(.-)_%d+$")
			if base ~= nil then
				local id2 = _EntryService:GetModelIdByName(base)
				if id2 ~= nil and id2 ~= "" then return self:BareModelId(id2) end
			end
		end
		if e:GetComponent("script.EnemyRanged") ~= nil then return "rangedenemy" end
		if e:GetComponent("script.EnemyChaser") ~= nil then return "chaserenemy" end
		return "meleeenemy"
	end

	@ExecSpace("ServerOnly")
	method void StartStageAt(string stageName)
		-- 노드에서 고른 Stage로 진입 (맵 전환 없음, 이미 테마맵): 그 Stage 스폰포인트 + 몬스터 재스폰.
		self:StartThemedStageAt(stageName, "normal")
	end

	@ExecSpace("ServerOnly")
	method void StartEliteStageAt(string stageName)
		-- 엘리트 전투 진입: 선택된 일반 스테이지의 맵·스폰·편성을 그대로 재사용하고 전투 유형만 elite (spec §7 —
		-- 별도 StartStage("elite")로 편성을 재추첨하지 않는다). 보정은 스폰 전에 StageType으로 확정 →
		-- EnemyHealth/EliteModifier가 초기화 시점에 층→합연산→시각 순서로 적용.
		self:StartThemedStageAt(stageName, "elite")
	end

	@ExecSpace("ServerOnly")
	method boolean IsEliteActive()
		-- 현재 전투 유형이 엘리트인지 (적 초기화/이동속도 배율이 폴링). 사망 재시작도 StageType이 유지돼 그대로 성립.
		return self.StageType == "elite"
	end

	@ExecSpace("ServerOnly")
	method number EliteSpeedMult()
		-- 엘리트 이동속도 배율: 적 AI가 이동 계산에만 곱한다(원본 MoveSpeed 불변 — spec §7).
		if self.StageType == "elite" then return _GameConstants.EliteSpeedMult end
		return 1.0
	end

	@ExecSpace("ServerOnly")
	method void StartThemedStageAt(string stageName, string stageType)
		-- 테마맵 내 Stage 컨테이너 기반 전투 진입 공통 경로 (normal/elite).
		self.StageType = stageType
		self.StageActive = false
		self.freshStage = true
		self.pendingStage = stageName
		_GameStateManager:RefillLives()
		local sd = nil
		if self.stageData ~= nil then sd = self.stageData[stageName] end
		if sd ~= nil then
			self.composition = sd.monsters
			self.curSpawnX = sd.sx
			self.curSpawnY = sd.sy
			-- ★ sd는 있는데(=stage 키 존재) monsters가 빈 배열이면 RollComposition fallback도 안 타고 조용히 0마리 스폰 = 재진입 버그의 실제 순간.
			if self.composition == nil or #self.composition == 0 then
				log_error("[StageManager] ★재진입 스폰버그(실행 시점): stage '" .. tostring(stageName) .. "' 캐시몹 0마리 -> 스폰 안 됨. preppedMap='" .. tostring(self.preppedMap) .. "' (이 맵 마커가 이미 삭제된 뒤 재스캔된 상태)")
			end
		else
			log_warning("[StageManager] stage '" .. tostring(stageName) .. "' not cached — fallback RollComposition")
			self.composition = self:RollComposition()
			self.curSpawnX = 0.0
			self.curSpawnY = 0.3
		end
		self:ResetStage()
		log("[StageManager] StartStageAt " .. tostring(stageName) .. " type=" .. stageType .. " mobs=" .. tostring(#self.composition))
	end

	@ExecSpace("ServerOnly")
	method void StartStage(string stageType, string spawnPointName)
		-- 보스/상점 스테이지 진입: 전용 맵(map03/map04)으로 이동 → 도착 후 스폰. (일반 스테이지는 StartStageAt 경유)
		self.StageType = stageType
		self.StageActive = false
		self.freshStage = true
		self.curSpawnX = 0.0
		self.curSpawnY = 0.3
		_GameStateManager:RefillLives()
		-- 맵 결정: 일반=현재 테마 맵 / 보스=map03 / 상점=map04. 1회 확정해 GetMap까지 동일 맵 보장.
		local mapId = ""
		if stageType == "boss" then
			-- 보스맵 = 현재 테마 레벨맵 + "_Boss" (예: DeepMineLevel_Boss). 테마별 전용 보스맵.
			mapId = _GameConstants:BossMapForTheme(_FloorManager.CurrentTheme)
		elseif stageType == "shop" then
			mapId = _GameConstants.MapShop
		else
			mapId = _GameConstants:MapForTheme(_FloorManager.CurrentTheme)
		end
		self.CurrentMapId = mapId
		-- 상점: 적 스폰 없이 맵 이동만 (상점 UI는 FloorManager가 표시).
		if stageType == "shop" then
			self.awaitingMap = false
			self:MovePlayerToMap(mapId)
			log("[StageManager] stage START type=shop map=" .. mapId)
			return
		end
		-- 전투(일반/보스): 구성 롤.
		if stageType == "boss" then
			-- 보스 스테이지: 테마별 전용 보스 1기 (오르비스=엘리쟈 / 엘나스=스노우맨 / 폐광=자쿰). 미지정 시 기본 더미.
			local theme = _FloorManager.CurrentTheme
			local bossModel = "bossenemy"
			if theme == "orbis" then
				bossModel = "bosselija"
			elseif theme == "elnath" then
				bossModel = "bosssnowman"
			elseif theme == "deepmine" then
				bossModel = "bosszakum"
			end
			log("[StageManager] boss model for theme '" .. tostring(theme) .. "' = " .. bossModel)
			-- 위치는 placeholder — PrepareBossMap가 보스맵 SpawnLocation/마커 기준으로 확정한다.
			self.composition = { { model = bossModel, x = 0.0, y = 0.0 } }
		else
			self.composition = self:RollComposition()
		end
		-- 이미 대상 맵이면 즉시 스폰, 아니면 이동 후 도착 폴링.
		local player = self:GetPlayer()
		local cm = nil
		if player ~= nil then cm = player.CurrentMap end
		if player ~= nil and cm ~= nil and isvalid(cm) and cm.Name == mapId then
			if stageType == "boss" then self:PrepareBossMap(cm) end
			self:ResetStage()
		else
			self.pendingMapId = mapId
			self.pendingAfterArrival = "spawn"
			self.awaitingMap = true
			self:MovePlayerToMap(mapId)
		end
		log("[StageManager] stage START type=" .. stageType .. " map=" .. mapId .. " lives=" .. tostring(_GameStateManager.CurrentLives))
	end

	method void OnUpdate(number delta)
		-- 서버: 맵 전환 완료를 폴링 → 도착 시 적 스폰 (전투 스테이지).
		if self:IsServer() == false then return end
		if self.awaitingMap == false then return end
		local player = self:GetPlayer()
		if player == nil then return end
		local cm = player.CurrentMap
		if cm == nil or isvalid(cm) == false then return end
		if cm.Name == self.pendingMapId then
			self.awaitingMap = false
			log("[StageManager] arrived at " .. self.pendingMapId .. " after=" .. self.pendingAfterArrival)
			if self.pendingAfterArrival == "node" then
				self:PrepareStages(cm)
				_FloorManager:OnMapReady()
			else
				if self.StageType == "boss" then self:PrepareBossMap(cm) end
				self:ResetStage()
			end
		end
	end

	@ExecSpace("ServerOnly")
	method table RollComposition()
		-- 일반 스테이지 적 구성 랜덤 롤 (근/원거리 조합, 스폰 포인트 고정 — map01 기준).
		local points = {
			{ x = 5.5, y = 0.4 },
			{ x = 7.5, y = 0.4 },
			{ x = -5.5, y = 0.4 },
			{ x = 8.5, y = 0.4 },
		}
		local count = 3 + _UtilLogic:RandomIntegerRange(0, 1)
		local comp = {}
		for i = 1, count do
			-- 랜덤 풀: 근접 / 원거리 / 추적(chaser). 35% 원거리, 25% 추적, 나머지 근접.
			local modelId = "meleeenemy"
			local r = _UtilLogic:RandomDouble()
			if r < 0.35 then modelId = "rangedenemy"
			elseif r < 0.6 then modelId = "chaserenemy" end
			local p = points[((i - 1) % #points) + 1]
			table.insert(comp, { model = modelId, x = p.x, y = p.y })
		end
		return comp
	end

	@ExecSpace("ServerOnly")
	method void ResetStage()
		-- 단일 초기화 함수 (A-5): 잔존 적/투사체 소멸 → 슬로우 해제 → 카운터 초기화 → 재스폰 → 플레이어 위치 리셋.
		local map = self:GetMap()
		if map == nil then return end
		-- (1) 잔존 적 소멸
		local enemies = map:GetChildComponentsByTypeName("script.EnemyHealth", true)
		for _, compAny in ipairs(enemies) do
			---@type EnemyHealth
			local comp = compAny
			if isvalid(comp.Entity) then comp.Entity:Destroy() end
		end
		-- (2) 비행 중 투사체 소멸
		local projs = map:GetChildComponentsByTypeName("script.Projectile", true)
		for _, compAny in ipairs(projs) do
			---@type Projectile
			local comp = compAny
			if isvalid(comp.Entity) then comp.Entity:Destroy() end
		end
		-- (2.5) 파괴된 오브젝트(Breakable: 구름/나뭇가지 등) 복구 — 재시작/진입 시 파괴 전 상태로 초기화.
		local breakables = map:GetChildComponentsByTypeName("script.Breakable", true)
		for _, compAny in ipairs(breakables) do
			---@type Breakable
			local comp = compAny
			if isvalid(comp.Entity) then comp:Reset() end
		end
		-- (2.7) 잔존 예고 게이지 + 적 공격 판정 레코드 정리 — 파괴된 보스/적의 진행 중이던 패턴(예고·판정)이
		--   재시작 스테이지로 새는 것 방지. 예고/판정은 적 엔티티 수명과 분리된 전역 리스트라 여기서 중앙 정리해야 한다.
		_TelegraphService:ClearAllForMap(map)
		_CombatPrimitives:ClearEnemyAttacks(map)
		-- (2.8) 재생 중인 전투 이펙트 제거 — 보스 임팩트/빔처럼 instigator=맵이라 적 파괴 후에도 재생이 긴(느리게 터지는)
		--   이펙트가 재시작 화면에 남는 것 방지. 클라별 추적 시리얼(_EffectTable.Track)을 일괄 RemoveEffect.
		local fxUsers = _UserService:GetUsersByMapComponent(map.MapComponent)
		if fxUsers ~= nil then
			for _, u in ipairs(fxUsers) do
				local upc = u.PlayerComponent
				if upc ~= nil then self:ClientClearCombatFx(upc.UserId) end
			end
		end
		-- (3) 슬로우 모션 + 전장 효과 강제 해제
		_SlowMotion:ClearAllServer()
		_BattlefieldFx:ClearAllServer()
		-- (4) 카운터 초기화
		self.SpawnedCount = 0
		self.KilledCount = 0
		-- (5) 적 재스폰 (초기 구성)
		if self.composition ~= nil and self.StageType ~= "shop" then
			for _, c in ipairs(self.composition) do
				self.spawnSerial += 1
				local name = "E" .. tostring(self.spawnSerial)
				-- +SpawnYLift: 발판 아래로 미세하게 박힌 마커도 발판 위에서 스폰되게 보정 (중력이 안착시킴).
				local e = _SpawnService:SpawnByModelId(c.model, name, Vector3(c.x, c.y + _GameConstants.SpawnYLift, 0), map)
				if e == nil then
					log_error("[StageManager] spawn failed: " .. c.model)
				else
					self.SpawnedCount += 1
					-- 구성에 hp 오버라이드가 있으면 적용 (보스 플레이스홀더 등)
					if c.hp ~= nil then
						---@type EnemyHealth
						local hpComp = e:GetComponent("script.EnemyHealth")
						if hpComp ~= nil then
							hpComp.MaxHP = c.hp
							hpComp.HP = c.hp
						end
					end
				end
			end
		end
		-- (6) 플레이어 위치/상태 리셋 + 능력 사용 횟수 초기화 + 일회성 아이템 슬롯 스냅샷/복구
		local users = _UserService:GetUsersByMapComponent(map.MapComponent)
		if users ~= nil then
			for _, u in ipairs(users) do
				local pc = u.PlayerComponent
				if pc ~= nil then
					self:ClientStageReset(self.curSpawnX, self.curSpawnY, pc.UserId)
					-- 낙사 복귀: 엔진 내장 낙사 리스폰 목적지를 이번 스테이지 스폰포인트로 지정(미지정 시 원점 0,0,0으로 떨어짐).
					-- 맵마다 지면높이가 달라도 스테이지 스폰좌표를 그대로 쓰므로 정확. RespawnDuration을 낮춰 빠르게 복귀.
					pc.RespawnPosition = Vector3(self.curSpawnX, self.curSpawnY, 0)
					pc.RespawnDuration = _GameConstants.FallRespawnDuration
				end
				---@type PlayerAbility
				local ability = u:GetComponent("script.PlayerAbility")
				if ability ~= nil then
					ability:ResetUses(self.StageType)
				end
				-- 아이템 슬롯: 진입=현 상태 스냅샷 / 사망 재시작=진입 시점으로 복구 (소모 아이템 되돌림).
				---@type PlayerItems
				local items = u:GetComponent("script.PlayerItems")
				if items ~= nil then
					if self.freshStage then
						items:SnapshotSlots()
					else
						items:RestoreSlots()
					end
				end
			end
		end
		-- 진입 처리 완료 → 이후 ResetStage(사망 재시작)는 복구 경로.
		self.freshStage = false
		self.StageActive = true
		self.combatGraceUntil = _WallClock:ServerNow() + 1.5
		-- 런 타이머 활성화(전투 스테이지 진입 = 첫 조작가능 순간). shop은 ResetStage를 안 타므로 여기 도달=전투.
		_RunTimer:SetActive(true)
		-- ★소프트락 안전망: 전투 스테이지인데 실제 스폰된 적이 0마리면 클리어 판정(KilledCount>=SpawnedCount)의
		--   트리거인 OnEnemyKilled가 영영 호출되지 않아 스테이지가 영구히 안 끝난다(진행 불가).
		--   빈 구성/전량 스폰 실패(재진입 캐시 손상 등)의 최후 방어선으로, 지연 후 자동 클리어를 예약해 흐름을 보장한다.
		if self.StageType ~= "shop" and self.SpawnedCount == 0 then
			log_error("[StageManager] ★스폰 0마리 감지 -> 소프트락 방지 자동클리어 예약 (type=" .. tostring(self.StageType) .. " stage=" .. tostring(self.pendingStage) .. ")")
			self.StageActive = false
			_RunTimer:SetActive(false)
			_TimerService:SetTimerOnce(function()
				if _GameStateManager.RunActive then self:StageClear() end
			end, _GameConstants.StageEndDelay)
		end
		log("[StageManager] ResetStage done: spawned=" .. tostring(self.SpawnedCount))
	end

	@ExecSpace("ServerOnly")
	method boolean IsGraceActive()
		-- 진입 유예 중인지 (적 AI가 폴링). grace는 "리셋"(윈드업 취소·조준 해제)을 유발하므로 일시정지와 분리 — pause는 IsCombatPaused로 별도 프리즈.
		return _WallClock:ServerNow() < self.combatGraceUntil
	end

	@ExecSpace("ServerOnly")
	method boolean IsCombatPaused()
		-- 일시정지 중인지 (적 AI/투사체가 폴링). grace와 달리 상태를 리셋하지 않고 '프리즈'만 — 재개 시 진행 중 공격 그대로 이어감.
		return self.combatPaused
	end

	@ExecSpace("Server")
	method void RequestSetPaused(boolean paused)
		-- 클라 일시정지 메뉴 → (1) 동작 정지(combatPaused: 적 AI/투사체 프리즈) + (2) 게임 시계 정지(WallClock: 모든 서버 타이머 프리즈).
		if _GameStateManager.RunActive == false and _TutorialManager.TutorialActive == false then return end
		self.combatPaused = paused
		_WallClock:SetServerPaused(paused)
		log("[StageManager] combatPaused = " .. tostring(paused))
	end

	@ExecSpace("Server")
	method void RequestAbandonToLobby()
		-- 일시정지 메뉴 "타이틀로 돌아가기" → 진행 런 포기: 런/스테이지 종료 + 잔존 적/투사체 정리.
		self.combatPaused = false
		_WallClock:SetServerPaused(false)
		self.StageActive = false
		_GameStateManager.RunActive = false
		-- 런 포기: 타이머만 정지(기록 미제출 — 사망/클리어만 기록, 기획서 §4.3).
		_RunTimer:StopRun()
		-- 런 포기도 런 종료 → 콤보 초기화.
		_ComboManager:ResetAll()
		local map = self:GetMap()
		if map ~= nil and isvalid(map) then
			local enemies = map:GetChildComponentsByTypeName("script.EnemyHealth", true)
			for _, compAny in ipairs(enemies) do
				---@type EnemyHealth
				local comp = compAny
				if isvalid(comp.Entity) then comp.Entity:Destroy() end
			end
			local projs = map:GetChildComponentsByTypeName("script.Projectile", true)
			for _, compAny in ipairs(projs) do
				---@type Projectile
				local comp = compAny
				if isvalid(comp.Entity) then comp.Entity:Destroy() end
			end
		end
		log("[StageManager] run abandoned -> lobby")
	end

	@ExecSpace("ServerOnly")
	method Entity GetMap()
		-- 이번 스테이지에서 확정된 맵 (StartStage가 CurrentMapId에 저장: 일반=테마맵 / 보스=map03 / 상점=map04).
		if self.CurrentMapId == "" then return nil end
		return _EntityService:GetEntityByPath("/maps/" .. self.CurrentMapId)
	end

	@ExecSpace("ServerOnly")
	method Vector2 ResolveSpawnLocation(Entity map)
		-- 맵의 SpawnLocation 엔티티(MSW 표준 스폰포인트) 월드좌표. 없으면 (0, 0.3).
		if map ~= nil and isvalid(map) then
			local sl = map:GetChildByName("SpawnLocation", true)
			if sl ~= nil and isvalid(sl) then
				local p = sl.TransformComponent.WorldPosition
				return Vector2(p.x, p.y)
			end
		end
		return Vector2(0.0, 0.3)
	end

	@ExecSpace("ServerOnly")
	method void PrepareBossMap(Entity map)
		-- 보스맵 도착 1회: 플레이어 스폰 = 맵 SpawnLocation, 보스 스폰 = authored 적 마커(EnemyHealth) 좌표.
		-- 보스는 "몬스터처럼" 맵에 배치 → 여기서 위치만 읽어 테마 보스 모델을 그 자리에 스폰하고 마커는 제거.
		-- (ResetStage step(1)이 EnemyHealth를 전멸시키므로, 마커 좌표는 반드시 여기서 먼저 캐시해야 한다.)
		if map == nil or isvalid(map) == false then return end
		local sp = self:ResolveSpawnLocation(map)
		self.curSpawnX = sp.x
		self.curSpawnY = sp.y
		local bx = sp.x + 4.0
		local by = sp.y
		local hcs = map:GetChildComponentsByTypeName("script.EnemyHealth", true)
		if hcs ~= nil and #hcs > 0 then
			local first = hcs[1].Entity
			if isvalid(first) then
				local wp = first.TransformComponent.WorldPosition
				bx = wp.x
				by = wp.y
			end
			for _, hc in ipairs(hcs) do
				if isvalid(hc.Entity) then hc.Entity:Destroy() end
			end
			log("[StageManager] boss marker -> spawn (" .. tostring(bx) .. "," .. tostring(by) .. ")")
		else
			log("[StageManager] no boss marker -> fallback near SpawnLocation (" .. tostring(bx) .. "," .. tostring(by) .. ")")
		end
		if self.composition ~= nil then
			for _, c in ipairs(self.composition) do
				c.x = bx
				c.y = by
			end
		end
	end

	@ExecSpace("Client")
	method void ClientStageReset(number sx, number sy)
		-- 클라: 서버가 산출한 스폰 월드좌표로 텔레포트 + 전투 컨텍스트 복귀 + 타임스케일 보정.
		local player = _UserService.LocalPlayer
		if player ~= nil then
			player.MovementComponent:SetWorldPosition(Vector2(sx, sy))
			-- 종료 텀 동안 잠갔던 이동 컨트롤러 복원 (스테이지 재개 시점).
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) then pcc.Enable = true end
			-- 대시 충전 만충 리셋 (DashCount는 클라 전용 → 서버 ResetStage가 직접 못 씀, 여기서 처리).
			---@type PlayerDash
			local dash = player:GetComponent("script.PlayerDash")
			if dash ~= nil then dash:ResetForStage() end
		end
		-- 사망 부활 시 검게 했던 화면을 다시 밝게 (신규 진입이면 이미 투명이라 무해).
		if self.fadeOverlay ~= nil and isvalid(self.fadeOverlay) then
			self.fadeOverlay:FromBlack()
		end
		_UtilLogic:SetClientTimeScale(1.0)
		_InputRouter:SetContext("Combat")
		-- 스테이지 준비 완료 → 로딩화면 숨김(선택/전환 커버 종료).
		_SelectBackdrop:HideLoading()
	end

	@ExecSpace("Client")
	method void ClientFreezePlayer()
		-- 스테이지 종료 텀 동안 로컬 플레이어 이동/액션 정지: 이동 컨트롤러 비활성 + 라우터 비전투 컨텍스트(대시·공격 차단).
		-- 복원은 재개 시 ClientStageReset(이동 컨트롤러) / 각 UI 컨텍스트 전환이 담당.
		local player = _UserService.LocalPlayer
		if player ~= nil and isvalid(player) then
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) then pcc.Enable = false end
		end
		_InputRouter:SetContext("Frozen")
	end

	@ExecSpace("Client")
	method void ClientFadeToBlack()
		-- 사망(부활) 화면 전환: 풀스크린 검정 오버레이를 검게. 복원(FromBlack)은 ClientStageReset이 담당.
		if self.fadeOverlay ~= nil and isvalid(self.fadeOverlay) then
			self.fadeOverlay:ToBlack()
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEnemyKilled(string enemyKind)
		-- 처치 카운트. 스폰 수 == 처치 수 → 클리어 (stage_design §2.3.5).
		if self.StageActive == false then return end
		self.KilledCount += 1
		_GameStateManager.RunKills += 1
		log("[StageManager] kill " .. tostring(self.KilledCount) .. "/" .. tostring(self.SpawnedCount) .. " (" .. enemyKind .. ")")
		if self.KilledCount >= self.SpawnedCount then
			-- 클리어 텀: 마지막 적 처치 후 곧바로 보상 팝업을 띄우지 않고 같은 텀을 둔 뒤 StageClear.
			-- 즉시 StageActive=false로 중복 클리어/피격 차단 + grace 연장(적 프리즈) + 플레이어 이동 정지.
			self.StageActive = false
			-- 마지막 적 처치 = 전투 종료 → 런 타이머 정지(보상/노드/상점/다음스테이지 로딩 동안 미누적).
			_RunTimer:SetActive(false)
			self.combatGraceUntil = _WallClock:ServerNow() + _GameConstants.StageEndDelay + 1.5
			local cp = self:GetPlayer()
			if cp ~= nil and cp.PlayerComponent ~= nil then self:ClientFreezePlayer(cp.PlayerComponent.UserId) end
			_TimerService:SetTimerOnce(function()
				if _GameStateManager.RunActive then self:StageClear() end
			end, _GameConstants.StageEndDelay)
		end
	end

	@ExecSpace("ServerOnly")
	method void StageClear()
		-- 스테이지 클리어: 메소 일괄 지급 + 보상 롤 + 보상 UI 표시.
		self.StageActive = false
		local mesoGain = 0
		if self.StageType == "boss" then
			_GameStateManager.BossClears += 1
			mesoGain = _GameStateManager.BossClears * _GameConstants.MesoPerBossClear
		elseif self.StageType == "elite" then
			-- 엘리트: 일반과 분리 집계(spec §3.3). 메소는 일반 경로와 같은 누진식 — 전투 클리어 수(일반+엘리트) 기준.
			_GameStateManager.EliteClears += 1
			mesoGain = (_GameStateManager.NormalClears + _GameStateManager.EliteClears) * _GameConstants.MesoPerNormalClear
		else
			_GameStateManager.NormalClears += 1
			mesoGain = _GameStateManager.NormalClears * _GameConstants.MesoPerNormalClear
		end
		_GameStateManager:AddMeso(mesoGain)
		local rewards = _RewardManager:RollRewards(self.StageType)
		-- 엘리트 전용 보상: 메소·일반 추첨 "이후" 판정/적용 (spec §4.1 순서). 표시 문자열을 보상 UI로 전달.
		local eliteInfo = ""
		if self.StageType == "elite" then
			eliteInfo = _RewardManager:GrantEliteRewards()
		end
		log("[StageManager] STAGE CLEAR! type=" .. self.StageType .. " meso+" .. tostring(mesoGain) .. " stat=" .. tostring(rewards.stat) .. " item=" .. tostring(rewards.item) .. " ability=" .. tostring(rewards.ability) .. " elite=" .. eliteInfo)
		-- 보상 UI (클라). map이 nil(CurrentMapId 미설정/경로조회 실패)이어도 크래시 없이 추적 플레이어로 폴백,
		-- 그래도 대상이 없으면 보상 없이 진행 위임(런 스톨 방지).
		local map = self:GetMap()
		local users = nil
		if map ~= nil and isvalid(map) then
			users = _UserService:GetUsersByMapComponent(map.MapComponent)
		end
		local pc = nil
		if users ~= nil and #users > 0 then
			pc = users[1].PlayerComponent
		else
			local tp = self:GetPlayer()
			if tp ~= nil then pc = tp.PlayerComponent end
		end
		if pc ~= nil then
			self:ClientShowReward(mesoGain, rewards.stat, rewards.item, rewards.ability, eliteInfo, pc.UserId)
		else
			log_error("[StageManager] StageClear: 보상 대상 플레이어 없음 -> 자동 진행")
			self:RequestProceedNext()
		end
	end

	@ExecSpace("Client")
	method void ClientShowReward(number mesoGain, boolean statReward, boolean itemReward, boolean abilityReward, string eliteInfo)
		-- 클라: 보상 팝업 표시 + 입력 컨텍스트 전환. eliteInfo=엘리트 전용 보상 표시 문자열("" = 비엘리트).
		_InputRouter:SetContext("Reward")
		if self.rewardUI ~= nil then
			self.rewardUI:Open(mesoGain, statReward, itemReward, abilityReward, eliteInfo)
		else
			log_warning("[StageManager] rewardUI not registered — auto-proceed")
			self:RequestProceedNext()
		end
	end

	@ExecSpace("Server")
	method void RequestProceedNext()
		-- 보상 수령 완료 → 층 진행 매니저에 위임 (노드맵/상점/보스/다음층 분기).
		log("[StageManager] reward done -> floor flow (" .. self.StageType .. ")")
		_FloorManager:OnStageRewardDone(self.StageType)
	end

	@ExecSpace("ServerOnly")
	method void OnPlayerDeath(Entity player)
		-- 사망 처리: 목숨 1 감소 후 재시작 / 목숨 0에서 사망 시 게임 오버 (player_design §1.4).
		if self.StageActive == false then return end
		-- 사망 순간 런 타이머 정지(부활 페이드 동안 미누적; 부활 시 ResetStage가 재활성).
		_RunTimer:SetActive(false)
		-- 콤보 한 단계 하락(D/무등급이면 해제). 잔여시간은 12초로 재설정되고,
		-- 감소는 RunTimer.Active 게이팅에 의해 전투 재개 시점부터 다시 흐른다 (combo_doc §6).
		_ComboManager:OnPlayerDeath()
		-- 사망(회귀) 효과음 — 죽은 플레이어 클라에서 1회 재생 (목숨 잔여 무관).
		local deadPc = player.PlayerComponent
		if deadPc ~= nil then self:ClientPlayerDeathSfx(deadPc.UserId) end
		-- 종료 텀 동안 이동 정지 (부활/게임오버 공통). 재개는 ClientStageReset이 복원.
		if deadPc ~= nil then self:ClientFreezePlayer(deadPc.UserId) end
		if _GameStateManager.CurrentLives > 0 then
			_GameStateManager.CurrentLives -= 1
			local hold = _GameConstants.DeathFadeHold
			local fade = _GameConstants.ScreenFadeDuration
			log("[StageManager] player died -> lives=" .. tostring(_GameStateManager.CurrentLives) .. ", revive seq (hold " .. tostring(hold) .. "s → fade)")
			-- 사망 연출 순서: (0) 죽은 걸 보여주는 정지 텀(hold, 이동정지·화면 그대로)
			--   → (1) 화면 검게(ToBlack) → (2) 검은 화면에서 리스폰(텔레포트) → ClientStageReset이 밝게(FromBlack).
			-- grace는 전체 시퀀스(hold+fade) 동안 적 프리즈 유지.
			self.StageActive = false
			self.combatGraceUntil = _WallClock:ServerNow() + hold + fade + 1.5
			local uid = ""
			if deadPc ~= nil then uid = deadPc.UserId end
			-- (1) hold 후 화면 검게
			_TimerService:SetTimerOnce(function()
				if uid ~= "" then self:ClientFadeToBlack(uid) end
			end, hold)
			-- (2) 완전히 검어진 뒤 리스폰 → ClientStageReset이 FromBlack (게임오버/런 종료 시 스킵).
			_TimerService:SetTimerOnce(function()
				if _GameStateManager.RunActive then self:ResetStage() end
			end, hold + fade)
		else
			-- 실패(목숨 0) 텀: 같은 텀 뒤에 게임오버 처리. 그 사이 전투 정지 + 적 프리즈.
			self.StageActive = false
			self.combatGraceUntil = _WallClock:ServerNow() + _GameConstants.StageEndDelay + 1.5
			_TimerService:SetTimerOnce(function()
				if _GameStateManager.RunActive then self:GameOver() end
			end, _GameConstants.StageEndDelay)
		end
	end

	@ExecSpace("Client")
	method void ClientPlayerDeathSfx()
		-- 클라: 플레이어 사망(회귀) 효과음 1회.
		_SoundManager:PlaySFXKey("sfx_player_death")
	end

	@ExecSpace("Client")
	method void ClientClearCombatFx()
		-- 클라: 추적 중인 전투 이펙트(보스 임팩트/빔 등 맵 앵커) 일괄 제거. ResetStage step(2.8)이 호출.
		_EffectTable:ClearTracked()
	end

	@ExecSpace("ServerOnly")
	method void GameOver()
		-- 게임 오버: 런 종료 + 진행도 기반 영구 강화 점수 적립 + 클라 게임오버 화면.
		self.StageActive = false
		_GameStateManager.RunActive = false
		-- 런 타이머 종료 + 베스트 기록 판정/저장/리더보드 등록(사망 종료 → bossCleared=false).
		local runTime = _RunTimer:StopRun()
		-- 런 종료 → 콤보 전량 초기화(다음 런으로 이어지지 않음, 영구저장 없음 — combo_doc §6).
		_ComboManager:ResetAll()
		_RecordStorage:SubmitRun(_GameStateManager.CurrentFloor, _FloorManager.NormalsClearedThisFloor, _FloorManager.ShopDoneThisFloor, false, runTime)
		local score = _GameStateManager.NormalClears + _GameStateManager.EliteClears * 2 + _GameStateManager.BossClears * 3
		_MetaProgression:AwardScore(score)
		log("[StageManager] GAME OVER (normalClears=" .. tostring(_GameStateManager.NormalClears) .. " score+" .. tostring(score) .. ")")
		-- 게임오버 화면(클라). map nil이어도 크래시 없이 추적 플레이어로 폴백.
		local map = self:GetMap()
		local users = nil
		if map ~= nil and isvalid(map) then
			users = _UserService:GetUsersByMapComponent(map.MapComponent)
		end
		local pc = nil
		if users ~= nil and #users > 0 then
			pc = users[1].PlayerComponent
		else
			local tp = self:GetPlayer()
			if tp ~= nil then pc = tp.PlayerComponent end
		end
		if pc ~= nil then
			self:ClientShowGameOver(score, pc.UserId)
		else
			log_error("[StageManager] GameOver: 화면 표시 대상 플레이어 없음")
		end
	end

	@ExecSpace("Client")
	method void ClientShowGameOver(integer score)
		-- 클라: 게임오버 팝업 + 입력 차단.
		_InputRouter:SetContext("GameOver")
		_UtilLogic:SetClientTimeScale(1.0)
		if self.gameOverUI ~= nil then
			self.gameOverUI:Open(score)
		else
			log_warning("[StageManager] gameOverUI not registered")
		end
	end

	@ExecSpace("Server")
	method void RequestRestartRun()
		-- 게임오버/게임클리어 화면에서 재시작.
		log("[StageManager] run restart requested")
		_GameStateManager:StartRun()
		_RunTimer:StartRun()
		_ShopManager:ResetPrices()
		_FloorManager:StartGameFlow()
	end

end
