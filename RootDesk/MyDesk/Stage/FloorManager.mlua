@Logic
script FloorManager extends Logic

	-- theme / normal / shop / boss / clear
	@Sync
	property string PhaseName = "theme"

	@Sync
	property integer NormalsClearedThisFloor = 0

	@Sync
	property boolean ShopDoneThisFloor = false

	-- 서버: 사용된 테마 (게임 판 단위)
	property any usedThemes = nil

	-- 서버: 이번 노드 선택의 분기별 스폰포인트 이름 [branch1, branch2, branch3] (테마맵에서 3개 추출)
	property any nodeSpawnChoices = nil

	-- 서버: 현재 테마의 스테이지 덱(셔플된 미방문 스테이지 이름 배열). 노드마다 상단 최대 3장을 후보로 제시,
	-- 선택(방문)된 스테이지는 덱에서 제거. 덱이 완전히 비면(0장) 원상복구(전체)하고 다시 셔플. 테마(층) 단위.
	-- ★ UI는 항상 3개 문 → 덱에 2·1장만 남아도 후보 배열은 3개로 패딩(남은 카드 중복 노출). 1장이면 세 문 모두 그 스테이지.
	property any deck = nil

	-- 서버: 직전에 방문(클리어)한 스테이지 이름. 덱 리셔플 직후 상단 3장에서 밀어내 연속 동일 스테이지를 방지.
	property string lastPlayedStage = ""

	-- 서버: 현재 진행 중(선택된) 일반 스테이지 이름. ★덱 제거는 "클리어" 시에만 → 사망·재시작은 덱 유지.
	property string currentStageName = ""

	@Sync
	property string CurrentTheme = ""

	-- 클라 UI 컨트롤러 참조
	property any themeUI = nil

	property any nodeUI = nil

	property any shopUI = nil

	property any gameClearUI = nil

	@ExecSpace("ServerOnly")
	method void StartGameFlow()
		-- 새 런: 1층 테마 선택부터 (stage_design §2.2.1).
		self.usedThemes = {}
		self.deck = nil
		self.lastPlayedStage = ""
		self.NormalsClearedThisFloor = 0
		self.ShopDoneThisFloor = false
		self.CurrentTheme = ""
		self.PhaseName = "theme"
		self:ShowThemeSelect()
	end

	@ExecSpace("ServerOnly")
	method void ShowThemeSelect()
		-- 미플레이 테마만 표시 (오르비스 / 엘나스 / 폐광 3종 중 미사용분 — 거울던전식).
		local orbisUsed = self.usedThemes ~= nil and self.usedThemes["orbis"] == true
		local elnathUsed = self.usedThemes ~= nil and self.usedThemes["elnath"] == true
		local deepmineUsed = self.usedThemes ~= nil and self.usedThemes["deepmine"] == true
		local pc = self:FirstPlayerComponent()
		if pc ~= nil then
			self:ClientShowThemeSelect(not orbisUsed, not elnathUsed, not deepmineUsed, pc.UserId)
		end
	end

	@ExecSpace("Client")
	method void ClientShowThemeSelect(boolean orbisAvailable, boolean elnathAvailable, boolean deepmineAvailable)
		-- 클라: 3테마 선택 팝업. UI 미등록 시 첫 가용 테마 자동 선택.
		_InputRouter:SetContext("Node")
		if self.themeUI ~= nil then
			self.themeUI:Open(orbisAvailable, elnathAvailable, deepmineAvailable)
		else
			log_warning("[FloorManager] themeUI not registered — auto first available")
			if orbisAvailable then
				self:RequestSelectTheme("orbis")
			elseif elnathAvailable then
				self:RequestSelectTheme("elnath")
			else
				self:RequestSelectTheme("deepmine")
			end
		end
	end

	@ExecSpace("Server")
	method void RequestSelectTheme(string themeId)
		-- 테마 확정 → 테마맵 1회 진입 (도착 후 Stage 스캔 + 노드선택은 OnMapReady에서).
		if self.usedThemes == nil then self.usedThemes = {} end
		self.usedThemes[themeId] = true
		self.CurrentTheme = themeId
		-- 새 테마 진입 → 스테이지 덱 초기화(테마 단위로 미방문 스테이지 관리).
		self.deck = nil
		self.lastPlayedStage = ""
		self.NormalsClearedThisFloor = 0
		self.ShopDoneThisFloor = false
		log("[FloorManager] theme selected: " .. themeId .. " (floor " .. tostring(_GameStateManager.CurrentFloor) .. ")")
		-- 테마 확정 → 해당 레벨 BGM 시작 (로비에서 StopBGM된 상태를 여기서 채운다).
		local bgmPc = self:FirstPlayerComponent()
		if bgmPc ~= nil then self:ClientPlayThemeBgm(themeId, bgmPc.UserId) end
		_StageManager:EnterMapForTheme()
	end

	@ExecSpace("Client")
	method void ClientPlayThemeBgm(string themeId)
		-- 클라: 테마별 레벨 BGM 재생. 키 규칙 bgm_<themeId> (bgm_orbis / bgm_elnath / bgm_deepmine).
		local key = "bgm_" .. themeId
		_SoundManager:PlayBGMKey(key)
		log("[FloorManager] theme BGM -> " .. key)
	end

	@ExecSpace("Client")
	method void ClientPlayBossBgm(string themeId)
		-- 클라: 보스 스테이지 진입 시 테마별 보스 BGM으로 전환. 키 규칙 bgm_<themeId>_boss.
		-- 보스 클리어 후 다음 층 테마 선택 시 ClientPlayThemeBgm이 다시 일반 BGM으로 덮는다.
		local key = "bgm_" .. themeId .. "_boss"
		_SoundManager:PlayBGMKey(key)
		log("[FloorManager] boss BGM -> " .. key)
	end

	@ExecSpace("ServerOnly")
	method void OnMapReady()
		-- StageManager가 테마맵 진입+Stage 스캔 완료 후 호출 → 노드 진행 시작.
		self:NextNode()
	end

	@ExecSpace("ServerOnly")
	method void NextNode()
		-- 노드 진행: 일반 N회(3분기 1택) → 상점(고정) → 보스(고정) (stage_design §2.2.3).
		local required = _GameConstants:NormalStagesForFloor(_GameStateManager.CurrentFloor)
		local pc = self:FirstPlayerComponent()
		if self.NormalsClearedThisFloor < required then
			self.PhaseName = "normal"
			-- 노드 3분기 = 테마맵의 스폰포인트 3개 추출 (branchIdx → 스폰포인트).
			self:PrepareNodeSpawns()
			if pc ~= nil then
				-- 분자=현재 스테이지 번호, 분모=보스전까지 전체(일반 required + 상점 1 + 보스 1).
				self:ClientShowNodeSelect(self.NormalsClearedThisFloor + 1, required + 2, pc.UserId)
			end
		elseif self.ShopDoneThisFloor == false then
			self.PhaseName = "shop"
			_StageManager:StartStage("shop", "")
			if pc ~= nil then
				self:ClientShowShop(pc.UserId)
			end
		else
			self.PhaseName = "boss"
			log("[FloorManager] BOSS node (floor " .. tostring(_GameStateManager.CurrentFloor) .. ")")
			-- 보스 스테이지 진입 → 보스 BGM으로 전환.
			if pc ~= nil then self:ClientPlayBossBgm(self.CurrentTheme, pc.UserId) end
			_StageManager:StartStage("boss", "")
		end
	end

	@ExecSpace("ServerOnly")
	method void PrepareNodeSpawns()
		-- 노드 분기 = 스테이지 덱 상단 최대 3장. (StageManager가 스캔한 stageOrder 기반, 맵 active 캐시라 조회 안전)
		-- ★ 덱 = 셔플된 미방문 스테이지. 남은 장수 < 3 이면 전체를 원상복구+셔플(직전 방문 스테이지는 상단 3장에서 밀어냄).
		local order = _StageManager.stageOrder
		local all = {}
		if order ~= nil then
			for _, n in ipairs(order) do table.insert(all, n) end
		end
		if #all == 0 then table.insert(all, "Stage1") end
		-- 덱이 없거나 완전히 소진(0장) → 원상복구 후 셔플. (2·1장 남은 상태는 그대로 두어 후보 2·1개로 노출)
		if self.deck == nil or #self.deck == 0 then
			self.deck = self:BuildShuffledDeck(all)
			log("[FloorManager] 덱 소진 -> 원상복구+셔플 (cards=" .. tostring(#self.deck) .. " last=" .. tostring(self.lastPlayedStage) .. ")")
		end
		-- 상단 최대 3장의 서로 다른 스테이지를 peek. (실제 제거는 방문 시 RequestSelectNode에서 덱 1장만)
		-- ★ UI는 항상 3개 문 → 후보 배열은 3개로 고정. 덱에 2·1장만 남으면 남은 카드로 순환 패딩(중복 노출).
		local uniq = #self.deck
		if uniq > 3 then uniq = 3 end
		local chosen = {}
		for i = 1, uniq do
			table.insert(chosen, self.deck[i])
		end
		-- 3개 미만이면 남은(uniq개) 카드를 순환하며 채워 항상 3개로. 1장이면 [A,A,A].
		local pad = 0
		while #chosen < 3 and uniq > 0 do
			chosen[#chosen + 1] = self.deck[(pad % uniq) + 1]
			pad += 1
		end
		self.nodeSpawnChoices = chosen
		log("[FloorManager] node choices: 3 (uniq=" .. tostring(uniq) .. " first=" .. tostring(chosen[1]) .. ") deck=" .. tostring(#self.deck))
	end

	@ExecSpace("ServerOnly")
	method table BuildShuffledDeck(table src)
		-- src를 복사해 Fisher-Yates 셔플한 새 덱 반환. 직전 방문 스테이지(lastPlayedStage)가 상단 3장에
		-- 들어오면(전체 4장 이상일 때) 4번째와 스왑해 3장 밖으로 밀어내 리셔플 직후 연속 동일 스테이지를 방지.
		local deck = {}
		for _, n in ipairs(src) do table.insert(deck, n) end
		for i = #deck, 2, -1 do
			local j = _UtilLogic:RandomIntegerRange(1, i)
			local tmp = deck[i]
			deck[i] = deck[j]
			deck[j] = tmp
		end
		if self.lastPlayedStage ~= "" and #deck > 3 then
			for i = 1, 3 do
				if deck[i] == self.lastPlayedStage then
					deck[i] = deck[4]
					deck[4] = self.lastPlayedStage
					break
				end
			end
		end
		return deck
	end

	@ExecSpace("Client")
	method void ClientShowNodeSelect(integer stageNo, integer totalStages)
		-- 클라: 3분기 노드 선택 팝업 (현재는 전부 일반 스테이지 — 임시 구현).
		_InputRouter:SetContext("Node")
		if self.nodeUI ~= nil then
			self.nodeUI:Open(stageNo, totalStages)
		else
			log_warning("[FloorManager] nodeUI not registered — auto branch 1")
			self:RequestSelectNode(1)
		end
	end

	@ExecSpace("Server")
	method void RequestSelectNode(integer branchIdx)
		-- 분기 선택 → 해당 Stage에서 일반 스테이지 시작 (branchIdx → nodeSpawnChoices의 Stage 이름).
		local stageName = "Stage1"
		if self.nodeSpawnChoices ~= nil then
			local idx = branchIdx
			if idx < 1 or idx > #self.nodeSpawnChoices then idx = 1 end
			stageName = self.nodeSpawnChoices[idx]
		end
		-- ★ 진행 중 스테이지만 기록. 덱 제거는 "클리어" 시점(OnStageRewardDone)에만 — 사망·재시작은 덱 유지.
		self.currentStageName = stageName
		log("[FloorManager] node branch " .. tostring(branchIdx) .. " -> stage " .. tostring(stageName))
		_StageManager:StartStageAt(stageName)
	end

	@ExecSpace("Client")
	method void ClientShowShop()
		-- 클라: 상점 팝업.
		_InputRouter:SetContext("Shop")
		if self.shopUI ~= nil then
			self.shopUI:Open()
		else
			log_warning("[FloorManager] shopUI not registered — auto leave")
			self:RequestLeaveShop()
		end
	end

	@ExecSpace("Server")
	method void RequestLeaveShop()
		-- 상점 나가기 → 보스 노드 (stage_design §2.4.2).
		self.ShopDoneThisFloor = true
		log("[FloorManager] shop left -> boss node")
		self:NextNode()
	end

	@ExecSpace("Server")
	method void DebugWarpBoss()
		-- [치트] 숫자키 6 → 현재 층 보스 스테이지로 즉시 점프 (테스트용; NextNode의 보스 분기와 동일). CheatMode 가드.
		if _GameConstants.CheatMode == false then return end
		if _GameStateManager.RunActive == false then
			log_warning("[FloorManager] DebugWarpBoss ignored — run not active")
			return
		end
		self.ShopDoneThisFloor = true
		self.PhaseName = "boss"
		log("[FloorManager] CHEAT warp -> BOSS (floor " .. tostring(_GameStateManager.CurrentFloor) .. ")")
		local pc = self:FirstPlayerComponent()
		if pc ~= nil then self:ClientPlayBossBgm(self.CurrentTheme, pc.UserId) end
		_StageManager:StartStage("boss", "")
	end

	@ExecSpace("ServerOnly")
	method void OnStageRewardDone(string stageType)
		-- 보상 수령 완료 후 진행 (StageManager.RequestProceedNext가 호출).
		if stageType == "boss" then
			if _GameStateManager.CurrentFloor >= _GameConstants.MaxFloors then
				self:GameClear()
			else
				_GameStateManager.CurrentFloor += 1
				self.NormalsClearedThisFloor = 0
				self.ShopDoneThisFloor = false
				self.PhaseName = "theme"
				log("[FloorManager] floor cleared -> floor " .. tostring(_GameStateManager.CurrentFloor) .. " theme select")
				self:ShowThemeSelect()
			end
		else
			self.NormalsClearedThisFloor += 1
			-- ★ 방문 처리(클리어 기준): 클리어한 스테이지를 덱에서 제거. 사망 재시작은 이 경로로 안 옴 → 덱 유지.
			self:MarkStageCleared(self.currentStageName)
			log("[FloorManager] normal stage done (" .. tostring(self.NormalsClearedThisFloor) .. "/" .. tostring(_GameConstants:NormalStagesForFloor(_GameStateManager.CurrentFloor)) .. ") cleared=" .. tostring(self.currentStageName) .. " deck=" .. tostring(self:DeckCount()))
			self:NextNode()
		end
	end

	@ExecSpace("ServerOnly")
	method void MarkStageCleared(string stageName)
		-- 클리어한 일반 스테이지를 덱에서 1장 제거(방문=클리어) + 직전 방문 기록(리셔플 가드용).
		if stageName == nil or stageName == "" then return end
		if self.deck ~= nil then
			for i = #self.deck, 1, -1 do
				if self.deck[i] == stageName then
					table.remove(self.deck, i)
					break
				end
			end
		end
		self.lastPlayedStage = stageName
	end

	@ExecSpace("ServerOnly")
	method integer DeckCount()
		-- 로그용: 현재 덱 장수(nil 안전).
		if self.deck == nil then return 0 end
		return #self.deck
	end

	@ExecSpace("ServerOnly")
	method void GameClear()
		-- 전층 클리어: 게임 클리어 화면 + 영구 강화 점수 (Phase 7).
		self.PhaseName = "clear"
		_GameStateManager.RunActive = false
		local score = _GameStateManager.NormalClears + _GameStateManager.BossClears * 3
		log("[FloorManager] GAME CLEAR! score=" .. tostring(score))
		_MetaProgression:AwardScore(score)
		local pc = self:FirstPlayerComponent()
		if pc ~= nil then
			self:ClientShowGameClear(score, pc.UserId)
		end
	end

	@ExecSpace("Client")
	method void ClientShowGameClear(integer score)
		-- 클라: 게임 클리어 팝업.
		_InputRouter:SetContext("GameOver")
		_UtilLogic:SetClientTimeScale(1.0)
		if self.gameClearUI ~= nil then
			self.gameClearUI:Open(score)
		else
			log_warning("[FloorManager] gameClearUI not registered")
		end
	end

	@ExecSpace("ServerOnly")
	method PlayerComponent FirstPlayerComponent()
		-- 1인 1런: 추적 중인 플레이어의 PlayerComponent (멀티맵 — 현재 위치 무관).
		local player = _StageManager:GetPlayer()
		if player == nil then return nil end
		return player.PlayerComponent
	end

end
