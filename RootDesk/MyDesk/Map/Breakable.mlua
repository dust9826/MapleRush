@Component
script Breakable extends Component

	-- 기본 공격 1대에 파괴되는 장식 오브젝트(오르비스 구름 / 폐광 나뭇가지 등). 파괴 시 자기 스프라이트를 파편으로 흩뿌린다.
	-- ★ 파괴 트리거는 PlayerCombat 기본공격 박스뿐(CombatPrimitives:BreakBreakablesInBox). 대시/아이템/투사체로는 안 부서진다.
	--
	-- 히트박스: 엔티티에 붙은 '박스 콜라이더'에 자동으로 맞춘다 (수동 수치 튜닝 불필요).
	--   우선순위 (1) TriggerComponent(박스콜라이더) → (2) HitComponent(박스) → (3) 콜라이더 없으면 아래 수동값 폴백.
	--   콜라이더 박스는 IsLegacy=false면 BoxSize×Scale+ColliderOffset로 오브젝트 크기에 딱 맞는다 → Maker에서 오브젝트에 맞춰 그리면 끝.

	-- 이미 파괴됐는지 (중복 파괴/판정 방지). @Sync — 클라도 상태 참조 가능.
	@Sync
	property boolean IsBroken = false

	-- 폴백 판정 박스(콜라이더가 없을 때만 사용). 반폭/반높이(월드유닛). 0 이하면 0.5.
	property number FallbackHW = 0.5

	property number FallbackHH = 0.5

	-- 폴백 박스 중심 Y 오프셋(콜라이더 없을 때만).
	property number FallbackYOffset = 0.0

	-- 파편 파티클 스프라이트: 비우면 자기 SpriteRUID 사용(자기 조각이 흩날림 — 권장). 지정 시 그 스프라이트로.
	property string DebrisSprite = ""

	-- 파편 스케일.
	property number DebrisScale = 1.0

	-- 파괴 연출이 보이도록 엔티티 소멸을 이만큼 지연(초). 스프라이트는 즉시 숨김.
	-- ※ 스테이지 재시작 복구를 위해 이제 엔티티를 삭제하지 않는다(숨김만) → 이 값은 현재 미사용(호환용 유지).
	property number DestroyDelay = 0.2

	-- 서버: 파괴 시 비운 CustomFoothold edge 백업(재시작 복구용). CFC 없는 오브젝트면 계속 nil.
	@HideFromInspector property any footholdBackup = nil

	-- ★충돌(솔리드 벽) 처리는 이 스크립트가 하지 않는다 — DashBlock 그룹의 일반 기능이다.
	--   플레이어=PlayerSolid, 적=EnemyHealth, 투사체=Projectile 이 각자 _CombatPrimitives:ResolveSolid / SegmentHitsBlocker 로
	--   모든 DashBlock 콜라이더의 측면을 막고(윗면은 FootholdComponent), 대시는 PlayerDash가 ray-clamp 한다.
	--   Breakable의 역할은 '공격당하면 부서지고, 파괴 시 자기 DashBlock 콜라이더 BoxSize를 0으로 만들어 충돌을 끄는 것'뿐.

	-- 파괴 시 통과시켜줄 하위 DashBlockRegion(대시 불가 존)의 복구 BoxSize. 부서지면 (0,0)로 줄여 대시 통과, 복구 시 이 값으로 되돌린다.
	-- ★ 자식으로 매단 DashBlockRegion만 대상(맵에서 이 오브젝트 밑에 자식으로 배치). DashBlock 콜라이더 그룹만 골라 조절 → 자기 히트박스는 안 건드림.
	property Vector2 DashRegionBoxSize = Vector2(0.5, 0.5)

	-- 오브젝트 '자신'에 붙은 DashBlock 솔리드 콜라이더의 원본 BoxSize 백업(파괴 시 0으로, 복구 시 이 값으로).
	-- ★단일 진실원: 오브젝트 자체 TriggerComponent를 DashBlock 그룹에 넣으면 GetHitbox(걷기·투사체·파괴판정) + 대시 클램프가
	--   같은 콜라이더 하나를 읽는다. 파괴 시 이 박스를 0으로 만들면 4종 차단이 한 번에 풀린다(BoxSize는 @Sync라 전 클라 자동 반영).
	--   OnBeginPlay에서 authored 크기를 캡처해 두어 파괴↔복구 시 @Sync 레이스로 0을 백업하는 사고를 방지. (-1,-1)=미캡처/솔리드 없음.
	@HideFromInspector property Vector2 selfSolidBackup = Vector2(-1, -1)

	-- DashBlock 솔리드 콜라이더(오브젝트 자신 또는 자식 DashBlockRegion) 캐시 — GetHitbox가 매 프레임 자식 탐색하지 않도록.
	@HideFromInspector property any solidTriggerCache = nil

	method void OnBeginPlay()
		-- 오브젝트 자신의 DashBlock 솔리드 콜라이더 원본 크기를 캡처(서버·클라 각자). 없으면 (-1,-1) 유지.
		local grp = CollisionGroups[_GameConstants.DashBlockGroup]
		if grp == nil then return end
		local stc = self.Entity.TriggerComponent
		if isvalid(stc) and stc.CollisionGroup ~= nil and stc.CollisionGroup.Id == grp.Id then
			if stc.BoxSize.x > 0 and stc.BoxSize.y > 0 then
				self.selfSolidBackup = stc.BoxSize
			end
		end
	end

	method any FindSolidTrigger()
		-- 오브젝트의 DashBlock 솔리드 콜라이더(자신 TriggerComponent 또는 자식 DashBlockRegion)를 반환. 없으면 nil.
		-- ★단일 진실원: 이 콜라이더를 걷기·투사체·파괴판정(GetHitbox)이 쓰면 대시(ClampRayToCurrentRoom)·근접LOS(SegmentHitsBlocker)와 정확히 같은 박스가 된다.
		--   기존엔 걷기가 0.5 폴백을 써서 대시 벽(예: 자식 4.11×3.68 스케일 = 2.06×1.84)보다 작아 옆구리로 걸어 들어가지던 불일치를 제거.
		if isvalid(self.solidTriggerCache) then return self.solidTriggerCache end
		local grp = CollisionGroups[_GameConstants.DashBlockGroup]
		if grp == nil then return nil end
		local own = self.Entity.TriggerComponent
		if isvalid(own) and own.CollisionGroup ~= nil and own.CollisionGroup.Id == grp.Id then
			self.solidTriggerCache = own
			return own
		end
		local kids = self.Entity:GetChildComponentsByTypeName("MOD.Core.TriggerComponent", true)
		if kids ~= nil then
			for _, tcAny in ipairs(kids) do
				---@type TriggerComponent
				local tc = tcAny
				if isvalid(tc) and tc.CollisionGroup ~= nil and tc.CollisionGroup.Id == grp.Id then
					self.solidTriggerCache = tc
					return tc
				end
			end
		end
		return nil
	end

	method any GetHitbox()
		-- 파괴 판정 박스 {cx,cy,hw,hh}. 박스 콜라이더에 자동 핏 → 없으면 수동 폴백. (서버/클라 공용 순수 계산)
		local e = self.Entity
		local tf = e.TransformComponent
		local p = tf.WorldPosition
		local sc = tf.Scale
		-- (0) DashBlock 솔리드 콜라이더 우선 (대시·근접 LOS와 같은 박스로 통일). 콜라이더 자기 엔티티의 Transform으로 박스 산출(자식 스케일 반영).
		local st = self:FindSolidTrigger()
		if st ~= nil and st.BoxSize.x > 0 and st.BoxSize.y > 0 then
			local stf = st.Entity.TransformComponent
			local sp = stf.WorldPosition
			local ssc = stf.Scale
			local sbs = st.BoxSize
			local soff = st.ColliderOffset
			return { cx = sp.x + soff.x * ssc.x, cy = sp.y + soff.y * ssc.y, hw = sbs.x * math.abs(ssc.x) * 0.5, hh = sbs.y * math.abs(ssc.y) * 0.5 }
		end
		-- (1) TriggerComponent = 박스콜라이더. BoxSize>0이면 오브젝트에 맞춰 그린 박스 그대로 사용.
		local tc = e.TriggerComponent
		if isvalid(tc) and tc.BoxSize.x > 0 and tc.BoxSize.y > 0 then
			local bs = tc.BoxSize
			local off = tc.ColliderOffset
			return { cx = p.x + off.x * sc.x, cy = p.y + off.y * sc.y, hw = bs.x * math.abs(sc.x) * 0.5, hh = bs.y * math.abs(sc.y) * 0.5 }
		end
		-- (2) HitComponent(박스). 전투용 콜라이더를 그대로 히트박스로.
		local hc = e.HitComponent
		if isvalid(hc) and hc.BoxSize.x > 0 and hc.BoxSize.y > 0 then
			local bs = hc.BoxSize
			local off = hc.ColliderOffset
			return { cx = p.x + off.x * sc.x, cy = p.y + off.y * sc.y, hw = bs.x * math.abs(sc.x) * 0.5, hh = bs.y * math.abs(sc.y) * 0.5 }
		end
		-- (3) 폴백: 수동값 (콜라이더 미부착 오브젝트).
		local bhw = self.FallbackHW
		local bhh = self.FallbackHH
		if bhw <= 0 then bhw = 0.5 end
		if bhh <= 0 then bhh = 0.5 end
		return { cx = p.x, cy = p.y + self.FallbackYOffset, hw = bhw, hh = bhh }
	end

	@ExecSpace("ServerOnly")
	method void Break(string source)
		-- 서버 권위 파괴: 중복 방지 → 파편 연출 브로드캐스트(히트박스 중심) → 소멸.
		if self.IsBroken then return end
		if isvalid(self.Entity) == false then return end
		self.IsBroken = true
		local hb = self:GetHitbox()
		local z = self.Entity.TransformComponent.WorldPosition.z
		local ruid = self.DebrisSprite
		if ruid == "" then
			local sp = self.Entity.SpriteRendererComponent
			if isvalid(sp) then ruid = sp.SpriteRUID end
		end
		self:PlayDebris(Vector3(hb.cx, hb.cy, z), ruid)
		-- 파괴 가능 벽: CustomFootholdComponent가 있으면 edge를 백업 후 비워 길을 연다(재시작 시 복구).
		local cfc = self.Entity.CustomFootholdComponent
		if isvalid(cfc) then
			self:BackupFootholds(cfc)
			cfc.edgeLists:Clear()
		end
		-- 하위 DashBlockRegion(대시 불가 존)을 열어 대시가 통과하게 한다(서버측). 클라측은 IsBroken 동기화로 OnSyncProperty에서 반영.
		self:ApplyDashRegions(true)
		-- ★ Destroy 하지 않는다 — 스테이지 재시작 시 Reset()으로 되살리려면 엔티티가 살아있어야 한다.
		--   시각 제거는 PlayDebris가 스프라이트를 숨겨 처리. 솔리드 차단(걷기·대시·투사체·근접)은 위 ApplyDashRegions가
		--   DashBlock 콜라이더 BoxSize를 0으로 만들어 해제 → 일반 충돌 시스템(ResolveSolid/SegmentHitsBlocker/대시 clamp)이 자동 통과.
		log("[Breakable] " .. self.Entity.Name .. " broke by " .. source)
	end

	@ExecSpace("ServerOnly")
	method void Reset()
		-- 스테이지 재시작/진입 시 파괴 상태 복구: 다시 파괴 가능 + DashBlock 콜라이더 복원(→솔리드 차단 부활) + 스프라이트 재표시 + 풋홀드 복원.
		if isvalid(self.Entity) == false then return end
		if self.IsBroken == false then return end
		self.IsBroken = false
		local cfc = self.Entity.CustomFootholdComponent
		if isvalid(cfc) then self:RestoreFootholds(cfc) end
		-- 하위 DashBlockRegion 복구(서버측). 클라측은 IsBroken 동기화로 OnSyncProperty에서 반영.
		self:ApplyDashRegions(false)
		self:ShowSprite()
		log("[Breakable] " .. self.Entity.Name .. " reset (restored)")
	end

	@ExecSpace("Multicast")
	method void ShowSprite()
		-- 전 클라: 파괴 때 숨겼던 스프라이트를 다시 표시.
		if isvalid(self.Entity) == false then return end
		local sp = self.Entity.SpriteRendererComponent
		if isvalid(sp) then sp.Enable = true end
	end

	method void ApplyDashRegions(boolean broken)
		-- 하위(자식) DashBlock 그룹 TriggerComponent들의 BoxSize를 조절. broken=true면 (0,0)로 대시 통과, false면 DashRegionBoxSize로 복구.
		-- ★대시 사거리 클램프는 클라에서 평가(PlayerDash → ClampRayToCurrentRoom, ClientOnly)하므로 클라 BoxSize가 실제로 반영돼야 한다.
		--   이 메서드는 서버(Break/Reset)와 클라(OnSyncProperty 동기화)에서 각각 자기 쪽 TriggerComponent에 적용된다.
		if isvalid(self.Entity) == false then return end
		local grp = CollisionGroups[_GameConstants.DashBlockGroup]
		if grp == nil then return end
		-- (0) 오브젝트 '자신'의 DashBlock 솔리드 콜라이더 토글 (단일 진실원 = 걷기·대시·투사체·파괴판정 공용 박스).
		local stc = self.Entity.TriggerComponent
		if isvalid(stc) and stc.CollisionGroup ~= nil and stc.CollisionGroup.Id == grp.Id then
			if broken then
				stc.BoxSize = Vector2(0, 0)
			elseif self.selfSolidBackup.x >= 0 then
				stc.BoxSize = self.selfSolidBackup
			end
		end
		-- (1) 하위(자식) DashBlockRegion 그룹 콜라이더 토글 (벽 오브젝트가 자식 대시존을 매단 레거시 구성 지원).
		local triggers = self.Entity:GetChildComponentsByTypeName("MOD.Core.TriggerComponent", true)
		if triggers == nil then return end
		for _, tcAny in ipairs(triggers) do
			---@type TriggerComponent
			local tc = tcAny
			if isvalid(tc) and tc.CollisionGroup ~= nil and tc.CollisionGroup.Id == grp.Id then
				if broken then
					tc.BoxSize = Vector2(0, 0)
				else
					tc.BoxSize = self.DashRegionBoxSize
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- IsBroken 동기화 시 클라의 하위 DashBlockRegion을 실제 파괴 상태에 맞춘다(대시 클램프는 클라 평가 + 뒤늦게 접속/맵 재진입한 클라도 반영).
		if name == "IsBroken" then self:ApplyDashRegions(value == true) end
	end

	method void BackupFootholds(any cfc)
		-- edgeLists(풋홀드 세그먼트)를 순수 테이블로 1회 백업 (재시작 복원용).
		if self.footholdBackup ~= nil then return end
		local backup = {}
		local segs = cfc.edgeLists:ToTable()
		for _, seg in ipairs(segs) do
			local pts = seg:ToTable()
			if #pts >= 2 then table.insert(backup, { pts[1], pts[2] }) end
		end
		self.footholdBackup = backup
	end

	method void RestoreFootholds(any cfc)
		-- 백업된 풋홀드 세그먼트를 edgeLists에 재삽입 (현재 비어있을 때만).
		if self.footholdBackup == nil then return end
		if cfc.edgeLists.Count > 0 then return end
		for _, seg in ipairs(self.footholdBackup) do
			cfc.edgeLists:Add({ seg[1], seg[2] })
		end
	end

	@ExecSpace("Multicast")
	method void PlayDebris(Vector3 pos, string spriteRuid)
		-- 전 클라: 파괴 지점에 파편 파티클(자기 스프라이트 조각 흩뿌림) + 스프라이트 즉시 숨김.
		local instigator = nil
		if isvalid(self.Entity) then
			-- 파티클 수명이 이 엔티티 소멸(DestroyDelay)에 끊기지 않도록 instigator는 맵으로.
			instigator = self.Entity.CurrentMap
			-- 즉시 시각 제거(실제 엔티티 소멸은 서버가 DestroyDelay 후 처리).
			local sp = self.Entity.SpriteRendererComponent
			if isvalid(sp) then sp.Enable = false end
		end
		if instigator == nil or isvalid(instigator) == false then return end
		local sc = self.DebrisScale
		local options = {}
		if spriteRuid ~= nil and spriteRuid ~= "" then
			_ParticleService:PlaySpriteParticle(SpriteParticleType.Burst, spriteRuid, instigator, pos, 0, Vector3(sc, sc, 1), false, options)
		else
			_ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, instigator, pos, 0, Vector3(sc, sc, 1), false, options)
		end
	end

end
