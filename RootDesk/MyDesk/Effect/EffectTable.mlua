@Logic
script EffectTable extends Logic

	-- key -> { ruid, pr, sf, ef, ox, oy, sx, sy, rot } 레코드 캐시.
	-- 서버/클라 각자 OnBeginPlay에서 EffectTable 데이터셋(=effect_list CSV)을 로드.
	-- 이펙트의 RUID + 재생옵션 + 위치 + 크기 + 회전을 코드 하드코딩 없이 CSV(EffectTable.csv) 편집만으로 튜닝하는 조회 계층.
	--   playrate      : 재생 속도 배율(1=기본, 2=2배속, 0.5=느림). 이펙트가 느리게/길게 뜰 때 올림.
	--   startframe    : 시작 프레임(0=처음부터). 앞쪽 빈 프레임을 잘라 "선딜처럼 보이는" 지연 제거.
	--   endframe      : 끝 프레임(-1=끝까지). 뒤에 늘어지는 꼬리 제거.
	--   offx/offy     : 위치 오프셋(월드유닛). 각 이펙트 기준점(플레이어/히트박스/투사체/보스)에 더해짐. 0=그대로.
	--   scalex/scaley : 크기. scaley 비우면 scalex와 동일(균일). 자쿰 빔처럼 길이≠두께일 때만 scaley 지정. 비면 1.
	--   rot           : 회전 오프셋(도). 정적 이펙트는 이 값이 곧 회전, 방향성 이펙트(공격/대시/만지)는 계산각에 가산(에셋 각도 보정).
	@HideFromInspector property any rows = nil

	method void OnBeginPlay()
		-- 이펙트 테이블 로드(서버·클라 공용). 이후 _EffectTable:Clip(key) / :Options(key) 로 조회.
		self:Reload()
	end

	method void Reload()
		-- EffectTable 데이터셋 → {key = {ruid, pr, sf, ef}} 캐시 구축. 데이터셋 없거나 빈 셀은 스킵.
		self.rows = {}
		local ds = _DataService:GetTable("EffectTable")
		if ds == nil then
			log_error("[EffectTable] dataset 'EffectTable' not found — 이펙트 재생 불가 (Maker refresh 필요할 수 있음)")
			return
		end
		local n = ds:GetRowCount()
		local loaded = 0
		local i = 1
		while i <= n do
			local key = ds:GetCell(i, "key")
			local ruid = ds:GetCell(i, "ruid")
			if key ~= nil and key ~= "" and ruid ~= nil and ruid ~= "" then
				local rec = { ruid = ruid }
				-- playrate: 값이 있고 >0 이면 저장(1도 무해하나 명시).
				local pr = tonumber(ds:GetCell(i, "playrate"))
				if pr ~= nil and pr > 0 then rec.pr = pr end
				-- startframe: >0 일 때만(0=기본, 스킵 없음).
				local sf = tonumber(ds:GetCell(i, "startframe"))
				if sf ~= nil and sf > 0 then rec.sf = math.floor(sf) end
				-- endframe: >=0 일 때만(-1/빈칸=끝까지, 트림 없음).
				local ef = tonumber(ds:GetCell(i, "endframe"))
				if ef ~= nil and ef >= 0 then rec.ef = math.floor(ef) end
				-- 위치 오프셋(빈칸/미지정=0).
				rec.ox = tonumber(ds:GetCell(i, "offx")) or 0
				rec.oy = tonumber(ds:GetCell(i, "offy")) or 0
				-- 크기(빈칸=1). scaley 비면 scalex와 동일(균일 스케일).
				rec.sx = tonumber(ds:GetCell(i, "scalex")) or 1
				local syRaw = tonumber(ds:GetCell(i, "scaley"))
				if syRaw ~= nil and syRaw > 0 then rec.sy = syRaw else rec.sy = rec.sx end
				-- 회전 오프셋(도, 빈칸=0).
				rec.rot = tonumber(ds:GetCell(i, "rot")) or 0
				self.rows[key] = rec
				loaded += 1
			end
			i += 1
		end
		log("[EffectTable] loaded " .. tostring(loaded) .. "/" .. tostring(n) .. " effect clips")
	end

	method string Clip(string key)
		-- key로 이펙트 RUID 조회. 미등록/미로드 시 "" 반환(호출부가 빈 클립 가드) + 1회성 경고.
		if self.rows == nil then
			return ""
		end
		local rec = self.rows[key]
		if rec == nil then
			log_warning("[EffectTable] unknown effect key '" .. tostring(key) .. "'")
			return ""
		end
		return rec.ruid
	end

	method any Options(string key)
		-- key의 재생 옵션(PlayRate/StartFrameIndex/EndFrameIndex)이 담긴 새 options 테이블 반환.
		-- 호출부는 이 테이블에 FlipX/Alpha 등을 추가로 얹어 _EffectService:PlayEffect의 options로 넘기면 됨.
		-- CSV에서 기본값(playrate 1 / startframe 0 / endframe -1)이면 해당 키는 생략되어 엔진 기본 동작.
		local opts = {}
		if self.rows == nil then return opts end
		local rec = self.rows[key]
		if rec == nil then return opts end
		if rec.pr ~= nil then opts["PlayRate"] = rec.pr end
		if rec.sf ~= nil then opts["StartFrameIndex"] = rec.sf end
		if rec.ef ~= nil then opts["EndFrameIndex"] = rec.ef end
		return opts
	end

	method Vector2 Offset(string key)
		-- key의 위치 오프셋(offx,offy) 반환. 호출부가 이펙트 기준점에 더해 최종 위치를 만든다. 미등록 시 (0,0).
		if self.rows == nil then return Vector2(0, 0) end
		local rec = self.rows[key]
		if rec == nil then return Vector2(0, 0) end
		return Vector2(rec.ox, rec.oy)
	end

	method Vector2 Scale(string key)
		-- key의 크기(scalex, scaley) 반환. 호출부는 Vector3(sc.x, sc.y, 1)로 사용. 미등록 시 (1,1).
		if self.rows == nil then return Vector2(1, 1) end
		local rec = self.rows[key]
		if rec == nil then return Vector2(1, 1) end
		return Vector2(rec.sx, rec.sy)
	end

	method number Rot(string key)
		-- key의 회전 오프셋(도) 반환. 정적 이펙트=이 값, 방향성 이펙트=계산각에 가산. 미등록 시 0.
		if self.rows == nil then return 0 end
		local rec = self.rows[key]
		if rec == nil then return 0 end
		return rec.rot
	end

end
