@Logic
script SoundManager extends Logic

	-- 사운드 볼륨(0.0~1.0). 클라이언트 전용 환경설정 값.
	-- 배경음은 _SoundService:SetBGMVolume 전역 API로 즉시 반영한다.
	-- 효과음은 전역 볼륨 API가 없어, 모든 효과음을 PlaySFX 단일 진입점으로 보내
	-- 저장된 sfxVolume을 곱해 적용한다. (직접 _SoundService:PlaySound를 부르면 볼륨 설정이 무시됨)
	property number bgmVolume = 1.0

	property number sfxVolume = 1.0

	-- BGM 페이드 인/아웃 길이(초). 엔진 기본 크로스페이드는 조절 불가라 SoundManager가 마스터 볼륨 램프로 직접 관리.
	-- 핵심: 새 곡은 PlayBGM에 '정상 볼륨'을 넘겨 확실히 재생시키고, 마스터 볼륨만 0→정상으로 램프해 페이드인한다.
	-- (PlayBGM에 볼륨 0을 넘기면 엔진이 트랙을 재생하지 않아 소리가 안 나옴 → 절대 0으로 시작하지 말 것.)
	property number BgmFadeInTime = 0.2

	property number BgmFadeOutTime = 0.2

	-- 현재 페이드 배수(0~1). 실제 엔진 BGM 볼륨 = bgmVolume × fadeMul. OnUpdate에서 프레임 단위로 갱신.
	@HideFromInspector
	property number fadeMul = 1.0

	-- 페이드 상태 머신: "" 유휴 / "out" 페이드아웃 중 / "in" 페이드인 중. OnUpdate가 진행(논블로킹 — wait 미사용).
	@HideFromInspector
	property string fadePhase = ""

	-- 페이드아웃 완료 후 재생할 곡 RUID(전환). ""이면 페이드아웃 후 그냥 정지.
	@HideFromInspector
	property string pendingRuid = ""

	-- 현재 재생 중(또는 시작 중)인 BGM RUID. 같은 곡을 다시 요청하면 재시작하지 않고 그대로 이어가기 위한 판정용(KeepBGM).
	-- StartNewBgm에서 세팅, 완전 정지 시 "". 스토리 중반 BGM==타이틀 BGM일 때 컷씬 종료 후 매끄러운 연결에 사용.
	@HideFromInspector
	property string currentBgmRuid = ""

	-- 사운드 키→RUID 맵. SoundTable.userdataset(=docs/sound.csv 이관)에서 시작 시 로드.
	-- 사운드를 추가/교체하려면 CSV만 편집하면 됨(코드 수정 0). enabled=TRUE + RUID 있는 행만 등록.
	@HideFromInspector
	property any sfxMap = nil

	property any clickHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 사운드 테이블 로드 → 볼륨 반영 → 전역 클릭 후킹 → 프리로드.
		self:LoadTable()
		self.fadeMul = 1.0
		self:ApplyBgmVolume()
		self.clickHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnGlobalKeyDown)
		self:PreloadSounds()
		log("[SoundManager] init bgm=" .. tostring(self.bgmVolume) .. " sfx=" .. tostring(self.sfxVolume))
	end

	@ExecSpace("ClientOnly")
	method void LoadTable()
		-- SoundTable(UserDataSet)을 키→RUID 맵으로 구축. enabled=TRUE이고 RUID가 있는 행만.
		self.sfxMap = {}
		local ds = _DataService:GetTable("SoundTable")
		if ds == nil then
			log("[SoundManager] SoundTable NOT FOUND — 사운드 재생 불가")
			return
		end
		local n = ds:GetRowCount()
		local loaded = 0
		for i = 1, n do
			local key = ds:GetCell(i, "key")
			local ruid = ds:GetCell(i, "ruid")
			local enabled = ds:GetCell(i, "enabled")
			if key ~= nil and key ~= "" and ruid ~= nil and ruid ~= "" and enabled == "TRUE" then
				self.sfxMap[key] = ruid
				loaded += 1
			end
		end
		log("[SoundManager] SoundTable loaded: " .. tostring(loaded) .. "/" .. tostring(n) .. " keys")
	end

	@ExecSpace("ClientOnly")
	method string Ruid(string key)
		-- 키에 매핑된 RUID 반환. 없거나 비활성/미지정이면 "".
		if self.sfxMap == nil then return "" end
		local r = self.sfxMap[key]
		if r == nil then return "" end
		return r
	end

	@ExecSpace("ClientOnly")
	method void PreloadSounds()
		-- 등록된 모든 사운드 RUID를 미리 로드해 첫 재생 지연 제거.
		if self.sfxMap == nil then return end
		local cnt = 0
		for _, ruid in pairs(self.sfxMap) do
			_SoundService:LoadSound(ruid)
			cnt += 1
		end
		log("[SoundManager] preloaded " .. tostring(cnt) .. " sounds")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 전역 클릭 후킹 해제.
		if self.clickHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.clickHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnGlobalKeyDown(KeyDownEvent event)
		-- 좌클릭이면서 포인터가 UI 위일 때만 클릭음(월드 클릭은 무음).
		if event.key == KeyboardKey.Mouse0 and _InputService:IsPointerOverUI() then
			self:PlaySFXKey("sfx_ui_click")
		end
	end

	@ExecSpace("ClientOnly")
	method number GetBgmVolume()
		-- 현재 배경음 볼륨 반환.
		return self.bgmVolume
	end

	@ExecSpace("ClientOnly")
	method number GetSfxVolume()
		-- 현재 효과음 볼륨 반환.
		return self.sfxVolume
	end

	@ExecSpace("ClientOnly")
	method void SetBgmVolume(number v)
		-- 배경음 볼륨 설정 + 엔진에 즉시 반영(현재 페이드 배수 유지).
		self.bgmVolume = self:Clamp01(v)
		self:ApplyBgmVolume()
		log("[SoundManager] SetBgmVolume -> " .. tostring(self.bgmVolume))
	end

	@ExecSpace("ClientOnly")
	method void SetSfxVolume(number v)
		-- 효과음 볼륨 설정. 이후 PlaySFX 호출부터 반영된다.
		self.sfxVolume = self:Clamp01(v)
		log("[SoundManager] SetSfxVolume -> " .. tostring(self.sfxVolume))
	end

	@ExecSpace("ClientOnly")
	method void PlaySFXKey(string key)
		-- 효과음 키 재생(권장 진입점). SoundTable에서 RUID 조회 후 재생.
		self:PlaySFX(self:Ruid(key))
	end

	@ExecSpace("ClientOnly")
	method void PlayBGMKey(string key)
		-- 배경음 키 재생(권장 진입점).
		self:PlayBGM(self:Ruid(key))
	end

	@ExecSpace("ClientOnly")
	method void PlaySFX(string ruid)
		-- 효과음 RUID 직접 재생. 저장된 sfxVolume 적용. (가능하면 PlaySFXKey 사용)
		if ruid == nil or ruid == "" then return end
		_SoundService:PlaySound(ruid, self.sfxVolume)
	end

	@ExecSpace("ClientOnly")
	method void ApplyBgmVolume()
		-- 실제 엔진 BGM 볼륨 = 사용자 설정(bgmVolume) × 페이드 배수(fadeMul).
		_SoundService:SetBGMVolume(self.bgmVolume * self.fadeMul)
	end

	@ExecSpace("ClientOnly")
	method void StartNewBgm(string ruid)
		-- 새 곡을 마스터 볼륨 0 상태에서 '정상 볼륨'으로 재생 시작(트랙 실제 재생) → 이후 OnUpdate가 페이드인.
		-- (PlayBGM에 볼륨 0을 넘기면 엔진이 트랙을 재생하지 않으므로 반드시 bgmVolume을 넘긴다.)
		_SoundService:StopBGM(true)
		self.currentBgmRuid = ruid                   -- 현재 곡 추적(KeepBGM 판정용)
		self.fadeMul = 0.0
		self:ApplyBgmVolume()                        -- SetBGMVolume(0): 시작 순간 무음
		_SoundService:PlayBGM(ruid, self.bgmVolume)
		self:ApplyBgmVolume()                        -- PlayBGM이 마스터를 바꿨을 수 있어 0으로 재확정
		if self.BgmFadeInTime > 0 then
			self.fadePhase = "in"
		else
			self.fadeMul = 1.0
			self:ApplyBgmVolume()
			self.fadePhase = ""
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayBGM(string ruid)
		-- 배경음 전환 요청(논블로킹). 재생 중이면 페이드아웃 예약(완료 후 pendingRuid 재생), 아니면 즉시 시작+페이드인.
		-- 실제 램프는 OnUpdate가 프레임 단위로 진행 → 호출부(OnUpdate/RPC)를 절대 블로킹하지 않음.
		if ruid == nil or ruid == "" then return end
		-- ★KeepBGM: 요청한 곡이 지금 재생 중인 곡과 같으면 재시작하지 않고 그대로 이어간다(처음부터 재생/끊김 방지).
		--   스토리 중반 BGM이 타이틀 BGM과 같은 경우, 컷씬 종료 후 타이틀 화면에서 같은 곡이 매끄럽게 이어짐.
		if ruid == self.currentBgmRuid and _SoundService:IsPlayBGM() then
			-- 같은 곡인데 마침 페이드아웃/정지가 예약돼 있었다면 취소하고 정상 볼륨으로 되돌린다(이어가기).
			if self.fadePhase == "out" then
				self.pendingRuid = ""
				self.fadePhase = "in"
			end
			return
		end
		if _SoundService:IsPlayBGM() and self.BgmFadeOutTime > 0 then
			self.pendingRuid = ruid
			self.fadePhase = "out"      -- OnUpdate가 fadeMul을 0까지 낮춘 뒤 pendingRuid를 재생
		else
			self:StartNewBgm(ruid)
		end
	end

	@ExecSpace("ClientOnly")
	method void StopBGM()
		-- 배경음 정지(논블로킹): 재생 중이면 페이드아웃 예약(pending 없음 → 완료 시 정지), 아니면 즉시 정지.
		if _SoundService:IsPlayBGM() and self.BgmFadeOutTime > 0 then
			self.pendingRuid = ""
			self.fadePhase = "out"
		else
			_SoundService:StopBGM(true)
			self.fadeMul = 1.0
			self.fadePhase = ""
			self.currentBgmRuid = ""
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- BGM 페이드 상태 머신(논블로킹). "out" → fadeMul 0까지 하강 후 정지/전환, "in" → 1까지 상승.
		if self.fadePhase == "out" then
			local d = 1.0
			if self.BgmFadeOutTime > 0 then d = delta / self.BgmFadeOutTime end
			self.fadeMul = self.fadeMul - d
			if self.fadeMul <= 0.0 then
				self.fadeMul = 0.0
				self:ApplyBgmVolume()
				if self.pendingRuid ~= "" then
					local nextRuid = self.pendingRuid
					self.pendingRuid = ""
					self:StartNewBgm(nextRuid)     -- 페이드아웃 완료 → 새 곡 시작(+페이드인 단계로 전환)
				else
					_SoundService:StopBGM(true)
					self.fadePhase = ""            -- 재생할 곡 없음 → 정지
					self.currentBgmRuid = ""
				end
			else
				self:ApplyBgmVolume()
			end
		elseif self.fadePhase == "in" then
			local d = 1.0
			if self.BgmFadeInTime > 0 then d = delta / self.BgmFadeInTime end
			self.fadeMul = self.fadeMul + d
			if self.fadeMul >= 1.0 then
				self.fadeMul = 1.0
				self.fadePhase = ""
			end
			self:ApplyBgmVolume()
		end
	end

	method number Clamp01(number v)
		-- 0.0~1.0 범위로 클램프.
		if v < 0 then return 0 end
		if v > 1 then return 1 end
		return v
	end

end
