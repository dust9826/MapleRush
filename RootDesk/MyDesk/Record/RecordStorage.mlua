@Logic
script RecordStorage extends Logic

	-- 베스트 기록(도달 층·층내 진행도·누적 시간) 영속 + 리더보드용 단일 정수 인코딩.
	-- UserDataStorage 영속(MetaProgression 패턴). 서버 권위. 로비 기록판/HUD 이전기록은 @Sync로 클라 노출.
	-- 규칙: docs/record_and_run_timer_design_doc.md §3(비교), §6(스키마/인코딩). 솔로 런 전제(GameStateManager와 동일 가정).

	-- ===== 클라 노출 베스트 (@Sync) =====
	@Sync property boolean HasRecord = false
	@Sync property integer BestFloor = 0            -- 도달 최대 층
	@Sync property integer BestStageInFloor = 0     -- 해당 층 내 클리어한 일반 스테이지 수
	@Sync property string BestPhase = ""            -- "normal" | "shop" | "boss_cleared"
	@Sync property number BestTime = 0.0            -- 위 진행도 도달까지 최소 누적 시간(초)
	-- 전 층 완주 최소 시간(초). 0 = 미완주. 랭킹 명세 §3.1의 개인 최고 기록이자 로비 '내 기록' 표시값.
	@Sync property number BestClearTime = 0.0
	-- 스테이지별 이전 최고 시간(HUD 이전기록 라인). key "floor-progress" -> 초.
	@Sync property SyncTable<string, number> StageBests

	-- ===== 서버 전용 상태 =====
	-- 최고기록 저장 키(버전 접미사). 저장된 기록을 전체 초기화하려면 이 접미사를 올린다(_v2 → _v3 …).
	--   과거 키의 blob은 고아가 되고(파괴적 삭제 아님, 되돌리면 원복), 모든 유저가 다음 로드에서 '기록 없음'으로 새로 시작.
	--   (2026-07-05 최고기록 데이터 초기화: user_best_record → _v2)
	property string SaveKey = "user_best_record_v2"

	property string ownerUserId = ""
	property boolean loaded = false
	property integer bestScore = 0
	property integer totalRuns = 0
	property any stageCache = nil                   -- 서버 직렬화 소스(plain table). StageBests(@Sync)로 미러.

	-- 클라: 로비 컨트롤러 참조(리더보드 결과 전달용). LobbyController가 OnBeginPlay에서 등록.
	@HideFromInspector property any lobbyUI = nil

	-- 인코딩 밴드 (기획서 §6.3). TIME_MAX = 10^8 센티초 상한.
	property integer TIME_MAX = 100000000

	method void EnsureCache()
		-- stageCache lazy 초기화(LoadFor가 OnBeginPlay보다 먼저 불려도 안전).
		if self.stageCache == nil then self.stageCache = {} end
	end

	@ExecSpace("ServerOnly")
	method void LoadFor(string userId)
		-- 유저 입장 시 1회 로드(캐시 우선, datastorage.md §4.1). blob 1키(SaveKey)로 저장.
		if self.loaded and self.ownerUserId == userId then return end
		self.ownerUserId = userId
		self:EnsureCache()
		---@type UserDataStorage
		local storage = _DataStorageService:GetUserDataStorage(userId)
		local err, raw = storage:GetAndWait(self.SaveKey)
		if err == 0 and raw ~= nil and raw ~= "" then
			local rec = _UtilLogic:StringToTable(raw)
			if rec ~= nil then
				self:ApplyRecord(rec)
			else
				self:ResetRecord()
			end
		else
			self:ResetRecord()
		end
		self.loaded = true
		log("[RecordStorage] loaded: hasRecord=" .. tostring(self.HasRecord) .. " floor=" .. tostring(self.BestFloor) .. " prog=" .. tostring(self.BestStageInFloor) .. " time=" .. tostring(self.BestTime) .. " score=" .. tostring(self.bestScore) .. " (err=" .. tostring(err) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ResetRecord()
		-- 기록 없음 상태로 초기화.
		self.HasRecord = false
		self.BestFloor = 0
		self.BestStageInFloor = 0
		self.BestPhase = ""
		self.BestTime = 0.0
		self.bestScore = 0
		self.BestClearTime = 0.0
		self.totalRuns = 0
		self.stageCache = {}
		-- StageBests(@Sync)는 세션 시작 시 비어 있고 로드는 유저당 1회 → 별도 clear 불필요(솔로 전제).
	end

	@ExecSpace("ServerOnly")
	method void ApplyRecord(any rec)
		-- 로드된 blob 테이블을 @Sync 프로퍼티 + stageCache/StageBests에 반영.
		self.bestScore = math.floor(tonumber(rec.bestScore) or 0)
		self.HasRecord = self.bestScore > 0
		self.BestFloor = math.floor(tonumber(rec.maxFloor) or 0)
		self.BestStageInFloor = math.floor(tonumber(rec.maxStageInFloor) or 0)
		self.BestPhase = tostring(rec.bestFloorPhase or "")
		self.BestTime = tonumber(rec.bestTime) or 0.0
		self.BestClearTime = tonumber(rec.bestClearTime) or 0.0
		self.totalRuns = math.floor(tonumber(rec.totalRuns) or 0)
		self.stageCache = {}
		if rec.stageRecords ~= nil then
			for k, v in pairs(rec.stageRecords) do
				local key = tostring(k)
				local val = tonumber(v) or 0.0
				self.stageCache[key] = val
				self.StageBests[key] = val
			end
		end
	end

	method integer ComputeStageProgress(integer normalsCleared, boolean shopDone, boolean bossCleared)
		-- 층 내 진행 순번 단조 인코딩(기획서 §8.1 제안): normals*2 + shop + boss*100.
		local p = normalsCleared * 2
		if shopDone then p = p + 1 end
		if bossCleared then p = p + 100 end
		return p
	end

	method integer EncodeScore(integer floor, integer stageProgress, number timeSec)
		-- (층, 진행도, 시간) → 단일 정수(기획서 §6.3). 층↑ > 진행도↑ > 시간↓ 순.
		local centis = math.floor(timeSec * 100)
		if centis < 0 then centis = 0 end
		if centis > self.TIME_MAX - 1 then centis = self.TIME_MAX - 1 end
		return floor * 100000000000 + stageProgress * 100000000 + (self.TIME_MAX - centis)
	end

	method integer DecodeFloor(integer score)
		-- 인코딩 점수에서 층 복원(리더보드 타 유저 표시용).
		return score // 100000000000
	end

	method number DecodeTime(integer score)
		-- 인코딩 점수에서 누적 시간(초) 복원.
		local rem = score % 100000000000
		local band = rem % 100000000
		local centis = self.TIME_MAX - band
		return centis / 100.0
	end

	method integer EncodeRankScore(number clearTime)
		-- ★ 리더보드 순위 점수(랭킹 명세 §3.2 재정의). 완주 시간 하나만으로 비교한다 — 플레이 수/콤보/처치 수 미반영.
		--   SortableDataStorage는 내림차순 정렬이므로 (10^8 - 센티초)로 뒤집어 "짧을수록 큰 점수"로 만든다.
		--   미완주(clearTime<=0)는 0을 반환하고 호출부가 제출을 건너뛴다(패키지도 score<=0은 목록에서 제외).
		--   0.01초 단위 저장이라 완전히 같은 시간 = 완전히 같은 점수 → 패키지 RankMode=Rank가 공동 순위를 부여한다.
		if clearTime <= 0 then return 0 end
		local centis = math.floor(clearTime * 100)
		if centis < 0 then centis = 0 end
		if centis > self.TIME_MAX - 1 then centis = self.TIME_MAX - 1 end
		return self.TIME_MAX - centis
	end

	method number DecodeRankClearTime(integer score)
		-- 순위 점수에서 완주 시간(초) 복원(EncodeRankScore의 역). 유효하지 않은 점수면 -1.
		if score <= 0 or score > self.TIME_MAX then return -1.0 end
		return (self.TIME_MAX - score) / 100.0
	end

	@ExecSpace("ServerOnly")
	method void StampStage(integer floor, integer progressAfterClear, number elapsed)
		-- 스테이지 클리어 시점 누적시간을 (층-진행도) 키로 최소값 기록(HUD 이전기록 라인용). 인메모리만, 런 종료 때 flush.
		self:EnsureCache()
		local key = tostring(floor) .. "-" .. tostring(progressAfterClear)
		local prev = self.stageCache[key]
		if prev == nil or elapsed < prev then
			self.stageCache[key] = elapsed
			self.StageBests[key] = elapsed
		end
	end

	@ExecSpace("ServerOnly")
	method boolean SubmitRun(integer floor, integer normalsCleared, boolean shopDone, boolean bossCleared, number elapsed)
		-- 런 종료(사망/클리어) 시 로컬 기록 처리와 글로벌 제출을 분리한다(랭킹 명세 §6-1).
		--   ① 로컬 베스트 기록(층/진행도/시간)은 미완주 런에서도 항상 갱신 — 자기경쟁 표시용.
		--   ② 전 층 완주(fullClear)일 때만 BestClearTime 갱신 + 리더보드 제출. 게임 오버는 글로벌 랭킹에 남지 않는다.
		--   반환값: 로컬 신기록이면 true.
		self.totalRuns = self.totalRuns + 1

		-- ① 로컬 베스트(도달 층/진행도/최소시간) — 종전 로직 유지(리더보드와 별개, 로비·HUD 표시용).
		local progress = self:ComputeStageProgress(normalsCleared, shopDone, bossCleared)
		local progressScore = self:EncodeScore(floor, progress, elapsed)
		local isNew = progressScore > self.bestScore
		if isNew then
			self.bestScore = progressScore
			self.HasRecord = true
			self.BestFloor = floor
			self.BestStageInFloor = normalsCleared
			if bossCleared then
				self.BestPhase = "boss_cleared"
			elseif shopDone then
				self.BestPhase = "shop"
			else
				self.BestPhase = "normal"
			end
			self.BestTime = elapsed
			log("[RecordStorage] NEW LOCAL RECORD floor=" .. tostring(floor) .. " prog=" .. tostring(progress) .. " time=" .. tostring(elapsed))
		end

		-- ② 전 층 완주만 글로벌 대상. bossCleared=true는 최종 층 클리어에서만 전달됨(FloorManager.GameClear).
		local fullClear = bossCleared and floor >= _GameConstants.MaxFloors
		if fullClear then
			if self.BestClearTime <= 0 or elapsed < self.BestClearTime then
				self.BestClearTime = elapsed
				log("[RecordStorage] NEW BEST CLEAR TIME=" .. tostring(elapsed))
			end
			-- 이번 런이 개인 베스트보다 느려도 현재 베스트로 제출한다(첫 제출이 ProfileCode 미확정 등으로 실패했던 경우 복구용).
			--   SetScoreAndWait(force=false)가 기존 점수 이하는 무시하므로 중복 등록 비용은 없다.
			self:SubmitToLeaderboard(self:EncodeRankScore(self.BestClearTime))
		else
			log("[RecordStorage] 미완주 런 — 글로벌 리더보드 제출 안 함 (floor=" .. tostring(floor) .. " boss=" .. tostring(bossCleared) .. ")")
		end

		self:Persist()
		return isNew
	end

	@ExecSpace("ServerOnly")
	method void Persist()
		-- blob 1키 저장(이벤트 드리븐 — 런 종료 시 1회). value ≤ 4KB 목표(datastorage.md).
		if self.ownerUserId == "" then return end
		self:EnsureCache()
		local sr = {}
		for k, v in pairs(self.stageCache) do
			sr[k] = v
		end
		local rec = {
			maxFloor = self.BestFloor,
			maxStageInFloor = self.BestStageInFloor,
			bestFloorPhase = self.BestPhase,
			bestTime = self.BestTime,
			bestScore = self.bestScore,
			bestClearTime = self.BestClearTime,
			totalRuns = self.totalRuns,
			stageRecords = sr,
		}
		local blob = _UtilLogic:TableToString(rec)
		---@type UserDataStorage
		local storage = _DataStorageService:GetUserDataStorage(self.ownerUserId)
		storage:SetAsync(self.SaveKey, blob, function(errorCode, value)
			if errorCode ~= 0 then log_warning("[RecordStorage] save failed (err=" .. tostring(errorCode) .. ")") end
		end)
	end

	@ExecSpace("ServerOnly")
	method void SubmitToLeaderboard(integer score)
		-- 글로벌 리더보드 등록(ranking-basic-package). score=EncodeRankScore(완주 시간) — 전 층 완주 런에서만 호출된다.
		-- force=false라 기존 점수보다 클 때(=더 빠른 완주)만 갱신된다. tag=닉네임(§3.3 목록 표시용).
		if score <= 0 then
			log_warning("[RecordStorage] leaderboard submit skipped — 완주 점수 아님(score=" .. tostring(score) .. ")")
			return
		end
		if self.ownerUserId == "" then return end
		if _RankingDataStorageLogic.IsInit == false then
			log_warning("[RecordStorage] leaderboard not init — submit skipped")
			return
		end
		local player = _UserService:GetUserEntityByUserId(self.ownerUserId)
		if player == nil or isvalid(player) == false then return end
		local pc = player.PlayerComponent
		if isvalid(pc) == false then return end
		local profileCode = pc.ProfileCode
		if profileCode == nil or profileCode == "" then
			log_warning("[RecordStorage] leaderboard submit skipped — ProfileCode 없음(신기록 미등록)")
			return
		end
		local tag = pc.Nickname
		if tag == nil then tag = "" end
		local cycleIndex = _RankingDataStorageLogic.ConfigData:GetCycleIndex(_DateTimeLogic:GetTimeElapsed())
		local ok = _RankingDataStorageLogic:SetScoreAndWait(cycleIndex, profileCode, score, tag, false)
		log("[RecordStorage] leaderboard submit score=" .. tostring(score) .. " tag=" .. tag .. " ok=" .. tostring(ok))
		if ok then
			-- ★ 등록 직후 랭킹 테이블 재빌드 + 캐시 클리어. 안 하면 방금 점수가 다음 갱신주기(기본 30분)/캐시(10분)까지
			--   상위N 리스트·내 순위에 반영 안 됨(=로비에서 '등록 안 된 것처럼' 보임). 런 종료 시에만(매 프레임 X) 호출이라 비용 허용.
			_RankingDataStorageLogic:UpdateDataTable()
			_RankingDataCacheLogic:Clear()
		end
	end

	@ExecSpace("Server")
	method void RequestLeaderboard(integer topN)
		-- 로비(클라) 요청 → 내 순위 + 상위 topN 조회 → 클라로 푸시(§8.2).
		if _RankingDataStorageLogic.IsInit == false then return end
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if player == nil or isvalid(player) == false then return end
		local pc = player.PlayerComponent
		if isvalid(pc) == false then return end
		local profileCode = pc.ProfileCode
		if profileCode == nil or profileCode == "" then
			-- ProfileCode 미확정: 빈 결과로 응답(로비가 '조회 중'에서 벗어나도록).
			self:ClientReceiveLeaderboard(0, {}, senderUserId)
			return
		end
		local cycleIndex = _RankingDataStorageLogic.ConfigData:GetCycleIndex(_DateTimeLogic:GetTimeElapsed())
		-- 내 순위 — 미완주자는 애초에 리더보드에 등록되지 않으므로 조회해도 Rank=0(로비가 안내 문구로 처리).
		--   BestClearTime은 싱글턴 소유자(ownerUserId)의 값이라 요청자와 다를 수 있다(MetaProgression의 senderUserId 가드와 동일 이슈).
		--   따라서 '요청자 == 소유자'일 때만 미완주 조기 반환으로 DataStorage 조회를 아끼고, 그 외에는 정상 조회한다.
		local myRank = 0
		local skipQuery = (senderUserId == self.ownerUserId) and self.BestClearTime <= 0
		if skipQuery == false then
			local myData = _RankingDataCacheLogic:GetMyRankingDataAndWait(profileCode, cycleIndex)
			if myData ~= nil then myRank = myData.Rank end
		end
		-- 상위 topN → 표시용 행 문자열 배열(RPC는 table). 행은 "순위. 플레이어명   완주시간"만 담는다(§3.3).
		local validPageNo = _RankingDataStorageLogic:GetValidPageNo(1, topN)
		local list = _RankingDataStorageLogic:GetRankingDataList(validPageNo, topN)
		local rows = {}
		local rowCount = 0
		for i = 1, #list do
			---@type RankingData
			local d = list[i]
			local clearTime = self:DecodeRankClearTime(d.Score)
			-- 완주 점수로 디코드되지 않는 행(구 인코딩 잔존 데이터 등)은 목록에서 제외한다.
			if clearTime >= 0 then
				local name = d.Tag
				if name == nil or name == "" then name = "익명" end
				rowCount = rowCount + 1
				rows[rowCount] = tostring(d.Rank) .. ".  " .. name .. "   " .. self:FormatBest(clearTime)
			end
		end
		log("[RecordStorage] leaderboard rows=" .. tostring(rowCount) .. " myRank=" .. tostring(myRank) .. " myClear=" .. tostring(self.BestClearTime))
		self:ClientReceiveLeaderboard(myRank, rows, senderUserId)
	end

	@ExecSpace("Client")
	method void ClientReceiveLeaderboard(integer myRank, table rows)
		-- 클라: 등록된 로비 컨트롤러에 전달(§5.1 순위 라인 + 상위 리스트).
		if self.lobbyUI ~= nil and isvalid(self.lobbyUI) then
			---@type LobbyController
			local lc = self.lobbyUI
			lc:ShowLeaderboard(myRank, rows)
		end
	end

	method string FormatBest(number sec)
		-- MM:SS.CC (1시간 초과 시 HH:MM:SS.CC). 기획서 §3.4 베스트 표시.
		local total = math.floor(sec * 100 + 0.5)
		local cc = total % 100
		local totalSec = (total - cc) // 100
		local s = totalSec % 60
		local m = (totalSec // 60) % 60
		local h = totalSec // 3600
		if h > 0 then
			return string.format("%d:%02d:%02d.%02d", h, m, s, cc)
		end
		return string.format("%02d:%02d.%02d", m, s, cc)
	end

	method string FormatClock(number sec)
		-- MM:SS (1시간 초과 시 HH:MM:SS). 기획서 §3.4 인게임 표시(매초 갱신).
		local totalSec = math.floor(sec)
		local s = totalSec % 60
		local m = (totalSec // 60) % 60
		local h = totalSec // 3600
		if h > 0 then
			return string.format("%d:%02d:%02d", h, m, s)
		end
		return string.format("%02d:%02d", m, s)
	end

end
