@Component
script PlayerItems extends Component

	-- 슬롯 1~5: "" / "rock"(짱돌) / "smoke"(연막탄) / "flash"(섬광탄). 슬롯4·5는 itemcap 메타 강화로 해금.
	@Sync
	property string Slot1 = ""

	@Sync
	property string Slot2 = ""

	@Sync
	property string Slot3 = ""

	@Sync
	property string Slot4 = ""

	@Sync
	property string Slot5 = ""

	-- 클라: 활성 슬롯 (0 = 없음). 한 번에 한 슬롯만 (player_design §7.3).
	property integer ActiveSlot = 0

	-- 서버: 스테이지 진입 시점 슬롯 스냅샷 (사망 재시작 시 복구용 — 대시 만충과 동일한 "자원 복구" 개념).
	@HideFromInspector property string snapSlot1 = ""
	@HideFromInspector property string snapSlot2 = ""
	@HideFromInspector property string snapSlot3 = ""
	@HideFromInspector property string snapSlot4 = ""
	@HideFromInspector property string snapSlot5 = ""

	property any routerHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 로컬 플레이어만 라우터 구독 (숫자키 1~3 + primary).
		if self.Entity ~= _UserService.LocalPlayer then return end
		self.routerHandler = _InputRouter:ConnectEvent(RouterActionEvent, self.OnRouterAction)
		log("[PlayerItems] OnBeginPlay: router connected")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 라우터 구독 해제.
		if self.routerHandler ~= nil then
			_InputRouter:DisconnectEvent(RouterActionEvent, self.routerHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로컬 플레이어 짱돌 조준 예고: rock 슬롯 활성 & 전투 중 & 비대시일 때 커서 방향 레인(적 예고 렌더러 재사용, 게이지 없음). 아니면 숨김.
		if self.Entity ~= _UserService.LocalPlayer then return end
		local show = false
		if _InputRouter:IsCombat() and self.ActiveSlot > 0 and self:GetSlot(self.ActiveSlot) == "rock" then
			---@type PlayerDash
			local dash = self.Entity:GetComponent("script.PlayerDash")
			if dash == nil or dash.IsDashing == false then show = true end
		end
		if show then
			local pos = self.Entity.TransformComponent.WorldPosition
			local center = Vector2(pos.x, pos.y + _GameConstants.PlayerCenterYOffset)
			local cursor = _InputRouter:CursorWorld()
			local dir = _CombatPrimitives:DirectionTo(center, cursor)
			_TelegraphRenderer:DrawAimLane(center, _GameConstants.GizmoRangedLaneLength, _GameConstants.GizmoRangedLaneWidth, dir.x, dir.y)
		else
			_TelegraphRenderer:HideAimLane()
		end
	end

	method string GetSlot(integer idx)
		-- 슬롯 내용 조회 (읽기 전용 — 서버/클라 공통. @Sync라 양측에서 유효).
		if idx == 1 then return self.Slot1 end
		if idx == 2 then return self.Slot2 end
		if idx == 3 then return self.Slot3 end
		if idx == 4 then return self.Slot4 end
		if idx == 5 then return self.Slot5 end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void SetSlot(integer idx, string val)
		-- 슬롯 값 쓰기 (서버 전용 — @Sync 갱신). GrantItem/RequestUseItem 내부용.
		if idx == 1 then self.Slot1 = val
		elseif idx == 2 then self.Slot2 = val
		elseif idx == 3 then self.Slot3 = val
		elseif idx == 4 then self.Slot4 = val
		elseif idx == 5 then self.Slot5 = val
		end
	end

	method integer MaxItems()
		-- 현재 최대 아이템 보관 수 = 기본 + itemcap 메타 강화, 물리 슬롯 5개 상한. 서버/클라 공통(둘 다 @Sync Levels 접근).
		local m = _PlayerConfig.BaseMaxItems + _MetaProgression:GetBonusItemCap()
		if m > 5 then m = 5 end
		return m
	end

	method boolean HasFreeSlot()
		-- 현재 최대 보관 수(MaxItems, itemcap 해금 슬롯 포함) 안에 빈 슬롯이 하나라도 있는지.
		-- GrantItem과 동일 기준. 서버/클라 공통(@Sync 슬롯 + MaxItems). 상점/보상 '가득' 판정의 단일 진실원.
		local maxItems = self:MaxItems()
		for idx = 1, maxItems do
			if self:GetSlot(idx) == "" then return true end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void OnRouterAction(RouterActionEvent event)
		-- 숫자키: 활성화 토글 / 활성 상태 좌클릭: 커서 방향 사용 (평타보다 우선 — F4).
		if event.action == "item1" then
			self:ToggleSlot(1)
		elseif event.action == "item2" then
			self:ToggleSlot(2)
		elseif event.action == "item3" then
			self:ToggleSlot(3)
		elseif event.action == "item4" then
			self:ToggleSlot(4)
		elseif event.action == "item5" then
			self:ToggleSlot(5)
		elseif event.action == "primary" and self.ActiveSlot > 0 then
			-- 대시 이동 중 사용 불가 (§7.4)
			---@type PlayerDash
			local dash = self.Entity:GetComponent("script.PlayerDash")
			if dash ~= nil and dash.IsDashing == true then return end
			local slot = self.ActiveSlot
			-- 아이템별 사용 효과음 (sound.csv #46/#47/#48). 슬롯은 토글 시 비어있지 않음이 보장됨.
			local kind = self:GetSlot(slot)
			if kind == "rock" then
				_SoundManager:PlaySFXKey("sfx_item_rock")
			elseif kind == "smoke" then
				_SoundManager:PlaySFXKey("sfx_item_smoke")
			elseif kind == "flash" then
				_SoundManager:PlaySFXKey("sfx_item_flash")
			end
			self.ActiveSlot = 0
			self:RequestUseItem(slot, event.worldPos.x, event.worldPos.y)
		end
	end

	@ExecSpace("ClientOnly")
	method void ToggleSlot(integer idx)
		-- 같은 키 재입력 → 비활성화 / 다른 키 → 해당 슬롯으로 전환. 빈 슬롯 무시.
		if self:GetSlot(idx) == "" then
			log("[PlayerItems] slot " .. tostring(idx) .. " is empty")
			return
		end
		if self.ActiveSlot == idx then
			self.ActiveSlot = 0
			log("[PlayerItems] slot " .. tostring(idx) .. " deactivated")
		else
			self.ActiveSlot = idx
			log("[PlayerItems] slot " .. tostring(idx) .. " ACTIVE (" .. self:GetSlot(idx) .. ")")
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsItemActive()
		-- 평타 차단용: 아이템 활성화 중인지 (PlayerCombat이 조회).
		return self.ActiveSlot > 0
	end

	@ExecSpace("Server")
	method void RequestUseItem(integer slotIdx, number targetX, number targetY)
		-- 서버 검증 + 아이템 효과 발동 + 슬롯 비움 (stage_design §3.2.2). 전투 스테이지 또는 튜토리얼(연습장)에서만.
		if _StageManager.StageActive == false and _TutorialManager.TutorialActive == false then return end
		local itemId = self:GetSlot(slotIdx)
		if itemId == "" then return end
		-- 슬롯 소모
		self:SetSlot(slotIdx, "")

		local pos = self.Entity.TransformComponent.WorldPosition
		local center = Vector2(pos.x, pos.y + 0.5)

		if itemId == "rock" then
			-- 짱돌: 커서 방향 투사체, ATK×300%, 적 투사체 사양 재사용
			local map = self.Entity.CurrentMap
			if isvalid(map) then
				local dir = _CombatPrimitives:DirectionTo(center, Vector2(targetX, targetY))
				local spawnPos = Vector3(center.x + dir.x * 0.4, center.y + dir.y * 0.4, 0)
				local proj = _SpawnService:SpawnByModelId("enemyprojectile", "rock_" .. tostring(_UtilLogic:RandomInteger()), spawnPos, map)
				if proj ~= nil then
					---@type Projectile
					local comp = proj:GetComponent("script.Projectile")
					if comp ~= nil then
						comp:Launch(dir.x, dir.y, _GameConstants.ProjectileSpeed, _GameStateManager.AttackStat * _PlayerConfig.DmgRockPct, false)
						comp.OwnerSide = "player"
						log("[PlayerItems] ROCK thrown (dmg=" .. tostring(_GameStateManager.AttackStat * _PlayerConfig.DmgRockPct) .. ")")
					end
				end
			end
		elseif itemId == "smoke" then
			_BattlefieldFx:ActivateSmoke(center, _GameConstants.SmokeDuration)
		elseif itemId == "flash" then
			_BattlefieldFx:ActivateStun(_GameConstants.FlashStunDuration)
		end
	end

	@ExecSpace("ServerOnly")
	method void SnapshotSlots()
		-- 스테이지 진입 시 현재 슬롯 상태 저장 (사망 재시작 시 이 상태로 복구).
		self.snapSlot1 = self.Slot1
		self.snapSlot2 = self.Slot2
		self.snapSlot3 = self.Slot3
		self.snapSlot4 = self.Slot4
		self.snapSlot5 = self.Slot5
		log("[PlayerItems] snapshot slots: '" .. self.snapSlot1 .. "' '" .. self.snapSlot2 .. "' '" .. self.snapSlot3 .. "' '" .. self.snapSlot4 .. "' '" .. self.snapSlot5 .. "'")
	end

	@ExecSpace("ServerOnly")
	method void RestoreSlots()
		-- 사망 재시작 시 스테이지 진입 시점 슬롯으로 복구 (소모한 일회성 아이템을 되돌림).
		self.Slot1 = self.snapSlot1
		self.Slot2 = self.snapSlot2
		self.Slot3 = self.snapSlot3
		self.Slot4 = self.snapSlot4
		self.Slot5 = self.snapSlot5
		log("[PlayerItems] restore slots: '" .. self.Slot1 .. "' '" .. self.Slot2 .. "' '" .. self.Slot3 .. "' '" .. self.Slot4 .. "' '" .. self.Slot5 .. "'")
	end

	@ExecSpace("ServerOnly")
	method boolean GrantItem(string itemId)
		-- 빈 슬롯에 아이템 지급 (현재 최대치 MaxItems까지만). 가득 차면 false (버리기/교체 UI는 추후).
		local maxItems = self:MaxItems()
		for idx = 1, maxItems do
			if self:GetSlot(idx) == "" then
				self:SetSlot(idx, itemId)
				log("[PlayerItems] granted: " .. itemId .. " -> slot " .. tostring(idx) .. " (max=" .. tostring(maxItems) .. ")")
				return true
			end
		end
		log("[PlayerItems] inventory full — item lost: " .. itemId .. " (max=" .. tostring(maxItems) .. ")")
		return false
	end

end
