@Component
script PlayerCombat extends Component

	property number lastAttackTime = -999.0

	-- 마지막 평타의 커서 좌/우 방향(+1 우 / -1 좌). 클라 기즈모가 평타 박스 그릴 때 사용. @Sync 불필요(로컬 클라 내 쓰기/읽기).
	property number lastAttackFacingX = 1

	-- 마지막 평타의 커서 방향 벡터(정규화). 클라 기즈모가 회전 평타 박스(OBB)를 그릴 때 사용. @Sync 불필요.
	property number lastAttackDirX = 1
	property number lastAttackDirY = 0

	property any routerHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 로컬 플레이어에게만 입력 라우터 구독.
		if self.Entity ~= _UserService.LocalPlayer then return end
		self.routerHandler = _InputRouter:ConnectEvent(RouterActionEvent, self.OnRouterAction)
		log("[PlayerCombat] OnBeginPlay: router connected (local player)")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 라우터 구독 해제.
		if self.routerHandler ~= nil then
			_InputRouter:DisconnectEvent(RouterActionEvent, self.routerHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRouterAction(RouterActionEvent event)
		-- primary(좌클릭) → 평타 시도. debugSlow(G키) → 슬로우모션 강제 발동(테스트용).
		if event.action == "primary" then
			self:TryAttack(event.worldPos)
		elseif event.action == "debugSlow" then
			log("[PlayerCombat] debugSlow requested (G key)")
			self:RequestDebugSlow()
		end
	end

	@ExecSpace("Server")
	method void RequestDebugSlow()
		-- 테스트용: 조건 무시하고 슬로우모션 즉시 발동 (서버 권위로 Activate 호출).
		-- 릴리스(CheatMode=false)에선 클라 입력 게이트를 우회한 요청도 서버에서 무시.
		if _GameConstants.CheatMode == false then return end
		_SlowMotion:Activate(self.Entity)
	end

	@ExecSpace("ClientOnly")
	method void TryAttack(Vector2 targetWorldPos)
		-- 평타: 쿨타임 0.5s(실제 시간), 대시 이동 중 불가. 판정은 서버에 요청.
		if not _WallClock:IsExpired(self.lastAttackTime, _PlayerConfig.AttackCooldown) then return end
		---@type PlayerDash
		local dash = self.Entity:GetComponent("script.PlayerDash")
		if dash ~= nil and dash.IsDashing == true then return end
		-- 아이템 활성화 중 좌클릭 = 아이템 사용 (평타 차단 — player_design §7.4)
		---@type PlayerItems
		local items = self.Entity:GetComponent("script.PlayerItems")
		if items ~= nil and items:IsItemActive() == true then return end
		self.lastAttackTime = _WallClock:Now()
		local pos = self.Entity.TransformComponent.WorldPosition
		local dir = _CombatPrimitives:DirectionTo(Vector2(pos.x, pos.y), targetWorldPos)
		log("[PlayerCombat] attack! dir=(" .. string.format("%.2f", dir.x) .. "," .. string.format("%.2f", dir.y) .. ")")
		self:PlayAttackMotion(dir)
		self:PlayAttackEffect(dir, pos)
		_SoundManager:PlaySFXKey("sfx_attack")
		if dir.x < 0 then self.lastAttackFacingX = -1 else self.lastAttackFacingX = 1 end
		self.lastAttackDirX = dir.x
		self.lastAttackDirY = dir.y
		self:RequestAttack(dir.x, dir.y, _UtilLogic.ServerElapsedSeconds)
	end

	@ExecSpace("ClientOnly")
	method void PlayAttackMotion(Vector2 dir)
		-- 좌클릭 공격 모션: 네이티브 공격 액션(ActionAttack)을 호출해 아바타 공격 스윙을 재생한다.
		-- Ctrl 공격과 동일 경로라 컨트롤러가 ATTACK→ATTACK_WAIT→IDLE 복귀를 관리(별도 원복 불필요).
		-- 데미지는 우리 커스텀 전투(RequestAttack)가 담당 — ActionAttack이 emit하는 PlayerActionEvent는 핸들러가 없어 무해.
		-- 로컬 플레이어 전용(TryAttack 게이트 통과분만 호출).
		local pc = self.Entity.PlayerControllerComponent
		if isvalid(pc) == false then
			log("[PlayerCombat] no PlayerControllerComponent — attack motion skipped")
			return
		end
		-- 스윙 방향을 커서 좌/우에 맞춤(가로 성분이 유의미할 때만; 수직 조준은 현재 facing 유지).
		if dir.x > 0.05 then
			pc.LookDirectionX = 1
		elseif dir.x < -0.05 then
			pc.LookDirectionX = -1
		end
		pc:ActionAttack()
	end

	@ExecSpace("ClientOnly")
	method void PlayAttackEffect(Vector2 dir, Vector3 pos)
		-- 좌클릭 공격 이펙트: 플레이어 중심에서 커서 방향으로 1.2 유닛 앞에 회전 재생. 회전은 방향(±90°) 기준, FlipX는 에셋 방향 보정(좌우 반전).
		local flipX = dir.x < 0
		local rot = 0.0
		if dir.x > 0 then
			rot = math.deg(math.atan(dir.y, dir.x))
		else
			rot = math.deg(math.atan(-dir.y, -dir.x))
		end
		-- 중심을 바라보는 방향으로 전방 오프셋만큼 이동 + 아래로 약간 하강 (칼이 몸 앞 아래에서 나가는 느낌)
		local off = _GameConstants.AttackEffectForwardOffset
		local cy = pos.y + _GameConstants.PlayerCenterYOffset - _GameConstants.AttackEffectDownOffset
		local fo = _EffectTable:Offset("attack")
		local center = Vector3(pos.x + dir.x * off + fo.x, cy + dir.y * off + fo.y, pos.z)
		local clip = _EffectTable:Clip("attack")
		if clip == "" then return end
		local sc = _EffectTable:Scale("attack")
		local options = _EffectTable:Options("attack")
		options["Alpha"] = _GameConstants.AttackEffectAlpha
		options["FlipX"] = flipX
		_EffectService:PlayEffect(clip, self.Entity, center, rot + _EffectTable:Rot("attack"), Vector3(sc.x, sc.y, 1), false, options)
	end

	@ExecSpace("Server")
	method void RequestAttack(number dirX, number dirY, number inputServerTime)
		-- 서버 권위 평타 판정: 커서 방향으로 회전한 전방 박스(OBB, 이펙트와 동일 방향). ATK×100% + 자동 패링(무효화/투사체 반사).
		local pos = self.Entity.TransformComponent.WorldPosition
		local f = _PlayerConfig.PlayerAttackBoxForward
		local hw = f * 0.5                                     -- 로컬X(전방 길이) 반폭
		local hh = _PlayerConfig.PlayerAttackBoxHeight * 0.5   -- 로컬Y(두께) 반높이
		-- 방향 정규화(0벡터 방어) + 커서 각도. 박스 중심 = 플레이어 중심에서 방향으로 hw만큼 전방(플레이어→전방 hw*2 도달, 기존 리치 유지).
		local dlen = math.sqrt(dirX * dirX + dirY * dirY)
		local nx = 1.0
		local ny = 0.0
		if dlen > 0.0001 then nx = dirX / dlen ny = dirY / dlen end
		local ang = math.atan(ny, nx)
		local cx = pos.x + nx * hw
		local cy = pos.y + _GameConstants.PlayerCenterYOffset + ny * hw
		-- 패링을 데미지보다 먼저 확정한다. 한 방 처치가 먼저 Die→CancelAttacksBySource를 호출하면
		-- 같은 공격의 유효한 패링 레코드까지 취소되어 parry=0이 되는 순서 회귀를 막는다.
		local reflectDamage = _GameStateManager.AttackStat * _PlayerConfig.DmgReflectPct
		local inputAge = _WallClock:NetworkInputAge(inputServerTime)
		local parried = _CombatPrimitives:TryParryOBB(self.Entity.CurrentMap, cx, cy, hw, hh, ang, reflectDamage, inputAge)
		local damage = _GameStateManager.AttackStat * _PlayerConfig.DmgAttackPct
		local hitCount = _CombatPrimitives:DamageEnemiesInOBB(self.Entity.CurrentMap, cx, cy, hw, hh, ang, damage, "attack")
		-- 패링 성공(근접 무효화/투사체 반사) 시 공격 위치에 CircleBurst 파티클 1회 — 요청 클라에만.
		if parried > 0 then
			local pc2 = self.Entity.PlayerComponent
			if isvalid(pc2) then self:PlayParryBurst(cx, cy, pos.z, pc2.UserId) end
		end
		-- 기본 공격으로 파괴 가능 장식 오브젝트(구름/나뭇가지 등) 파괴. ★기본공격 전용 훅(대시/아이템/투사체로는 안 부서짐). 회전 박스(OBB)로 판정.
		local broke = _CombatPrimitives:BreakBreakablesInOBB(self.Entity.CurrentMap, cx, cy, hw, hh, ang, "attack")
		log("[PlayerCombat] server attack resolved: hit=" .. tostring(hitCount) .. " parried=" .. tostring(parried) .. " broke=" .. tostring(broke) .. " dmg=" .. tostring(damage))
	end

	@ExecSpace("Client")
	method void PlayParryBurst(number x, number y, number z)
		-- 패링 성공 연출: 공격 위치에 BasicParticle CircleBurst 1회(비루프=자동 소멸). 클라 비주얼.
		-- (targetUserId는 호출부 마지막 인자로 전달 — 선언 파라미터 아님.)
		_ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, Vector3(x, y, z), 0, Vector3(1, 1, 1), false)
	end

end
