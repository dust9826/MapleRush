@Component
script PlayerHit extends Component

	property number lastHitServer = -999.0

	@Sync
	property boolean IsDead = false

	-- 사망 유예(러브샷/RPC 순서 역전 방지): 피격을 제한된 네트워크 보정 시간 뒤 확정한다. 그 사이 가해 적이 죽으면
	-- 사망을 취소 → "죽인 적한테는 나도 안 죽는다"(동귀어진 무승부는 플레이어 승). 근접/접촉/보스 공용.
	@HideFromInspector property boolean pendingDeath = false

	-- 유예 중인 가해 적 엔티티(생존 판정용) + 로그용 소스 태그.
	@HideFromInspector property any pendingAttacker = nil

	@HideFromInspector property string pendingSource = ""

	@HideFromInspector property number pendingHitAt = -999.0

	@HideFromInspector property number pendingResolveAt = -999.0

	@ExecSpace("ServerOnly")
	method void RequestHit(string source, Entity attacker)
		-- 1피격 즉사 요청. 실제 사망은 LoveShotGrace 뒤 OnUpdate에서 확정한다. attacker=가해 적 엔티티(없으면 nil).
		-- 즉시 판정 후 예약하고, 확정 시 처치 상태와 뒤늦게 도착한 대시/능력 입력 구간을 다시 확인한다.
		if self.IsDead then return end
		if self.pendingDeath then return end
		-- 튜토리얼: 플레이어는 죽지 않는다 (명시적 무적 가드).
		if _TutorialManager.TutorialActive then return end
		if _StageManager.StageActive == false then return end
		local now = _WallClock:ServerNow()
		if now - self.lastHitServer < 0.2 then return end
		---@type PlayerDash
		local dash = self.Entity:GetComponent("script.PlayerDash")
		if dash ~= nil and dash:IsInvincibleNow() == true then
			log("[PlayerHit] hit IGNORED (dash i-frame) from " .. source)
			return
		end
		---@type PlayerAbility
		local ability = self.Entity:GetComponent("script.PlayerAbility")
		if ability ~= nil and ability:IsAbilityInvincible() == true then
			log("[PlayerHit] hit IGNORED (ability invincible) from " .. source)
			return
		end
		-- 부동심 보험: 죽을 피격을 1회 흡수(횟수 소모 + 0.5s 무적 + 슬로우). 흡수 시 사망하지 않음.
		if ability ~= nil and ability:TryConsumeImmovable() == true then
			self.lastHitServer = now
			log("[PlayerHit] hit ABSORBED (immovable) from " .. source)
			return
		end
		-- 피격 확정 예약. 네트워크 보정 상한만큼 기다려 처치/대시/능력 RPC의 순서 역전을 흡수한다.
		self.pendingDeath = true
		self.pendingAttacker = attacker
		self.pendingSource = source
		self.pendingHitAt = now
		self.pendingResolveAt = now + _GameConstants.LoveShotGrace
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 유예된 피격 확정: 네트워크 순서가 뒤집힌 처치/대시/능력 요청까지 반영한 뒤 최종 판정한다.
		if self.pendingDeath == false then return end
		if _WallClock:ServerNow() < self.pendingResolveAt then return end
		self.pendingDeath = false
		local attacker = self.pendingAttacker
		local src = self.pendingSource
		local hitAt = self.pendingHitAt
		self.pendingAttacker = nil
		self.pendingSource = ""
		self.pendingHitAt = -999.0
		self.pendingResolveAt = -999.0
		---@type PlayerDash
		local dash = self.Entity:GetComponent("script.PlayerDash")
		if dash ~= nil and dash:IsInvincibleAt(hitAt) == true then
			log("[PlayerHit] deferred hit IGNORED (dash input preceded hit) from " .. src)
			return
		end
		---@type PlayerAbility
		local ability = self.Entity:GetComponent("script.PlayerAbility")
		if ability ~= nil and ability:IsAbilityInvincibleAt(hitAt) == true then
			log("[PlayerHit] deferred hit IGNORED (ability input preceded hit) from " .. src)
			return
		end
		-- 가해 적이 파괴됨 → 러브샷 취소 (탄 소멸/몹 소멸 케이스).
		if attacker ~= nil and isvalid(attacker) == false then
			log("[PlayerHit] love-tap avoided: attacker gone (" .. src .. ")")
			return
		end
		-- 가해 적이 EnemyHealth 사망 상태 → 러브샷 취소 (같은 순간 플레이어가 처치).
		if attacker ~= nil and isvalid(attacker) then
			---@type EnemyHealth
			local ehp = attacker:GetComponent("script.EnemyHealth")
			if ehp ~= nil and ehp.IsDead == true then
				log("[PlayerHit] love-tap avoided: attacker died same tick (" .. src .. ")")
				return
			end
		end
		self.lastHitServer = hitAt
		log("[PlayerHit] PLAYER HIT by " .. src .. " -> death (1-hit rule)")
		_StageManager:OnPlayerDeath(self.Entity)
	end

end
