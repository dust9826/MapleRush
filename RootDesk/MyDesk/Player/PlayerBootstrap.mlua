@Logic
script PlayerBootstrap extends Logic

	@EventSender("Service", "UserService")
	handler HandleUserEnter(UserEnterEvent event)
		-- 유저 입장 시 플레이어 엔티티에 전투 스크립트 부착 (Global/DefaultPlayer.model은 읽기 전용이므로 런타임 부착).
		if self:IsServer() == false then return end
		local player = _UserService:GetUserEntityByUserId(event.UserId)
		if player == nil then
			log_error("[PlayerBootstrap] player entity not found for " .. event.UserId)
			return
		end
		_MetaProgression:LoadFor(event.UserId)
		_RecordStorage:LoadFor(event.UserId)
		self:AttachCombatComponents(player)
	end

	@ExecSpace("ServerOnly")
	method void AttachCombatComponents(Entity player)
		-- PlayerCombat / PlayerDash / PlayerInputSetup 부착 (중복 방지).
		if player:GetComponent("script.PlayerCombat") == nil then
			player:AddComponent("PlayerCombat")
		end
		if player:GetComponent("script.PlayerDash") == nil then
			player:AddComponent("PlayerDash")
		end
		-- 앵커 3점 벽 충돌 체크(PlayerSolid) 비활성화 — 부착하지 않음.
		-- if player:GetComponent("script.PlayerSolid") == nil then
		-- 	player:AddComponent("PlayerSolid")
		-- end
		if player:GetComponent("script.PlayerInputSetup") == nil then
			player:AddComponent("PlayerInputSetup")
		end
		if player:GetComponent("script.PlayerHit") == nil then
			player:AddComponent("PlayerHit")
		end
		if player:GetComponent("script.PlayerAbility") == nil then
			player:AddComponent("PlayerAbility")
		end
		if player:GetComponent("script.PlayerItems") == nil then
			player:AddComponent("PlayerItems")
		end
		if _GameConstants.DrawGizmo then
			if player:GetComponent("script.PlayerDashGizmo") == nil then
				player:AddComponent("PlayerDashGizmo")
			end
			if player:GetComponent("script.CombatGizmo") == nil then
				player:AddComponent("CombatGizmo")
			end
			if player:GetComponent("script.PlayerItemGizmo") == nil then
				player:AddComponent("PlayerItemGizmo")
			end
		end
		log("[PlayerBootstrap] combat components attached to " .. player.Name)
		self:ApplyCostume(player, false)
		self:SetAttackAnimSpeed(player)
		self:EnsureDashPreview(player)
		_StageManager:OnPlayerReady(player)
		self:GrantDebugItems(player)
	end

	@ExecSpace("ServerOnly")
	method void SetAttackAnimSpeed(Entity player)
		-- 좌클릭 공격 모션 속도 2배: ATTACK 상태 매핑의 PlayRate를 기본(1.33)의 2배(2.66)로 세팅.
		-- StateToAvatarBodyActionSheet는 @Sync라 서버에서 세팅해야 전 클라 반영. 절대값이라 재입장에도 멱등.
		local asac = player.AvatarStateAnimationComponent
		if isvalid(asac) == false then
			log_warning("[PlayerBootstrap] AvatarStateAnimationComponent missing — attack anim speed skipped")
			return
		end
		asac.StateToAvatarBodyActionSheet["ATTACK"] = AvatarBodyActionElement("attack", 2.66)
		log("[PlayerBootstrap] attack anim PlayRate = 2.66 (2x) for " .. player.Name)
	end

	@ExecSpace("ServerOnly")
	method void ApplyCostume(Entity player, boolean useOwn)
		-- 코디 전환. useOwn=true → 내 계정 코디(커스텀 슬롯 비움 + UseCustomEquipOnly=false) / false → '만지' 코디(4종 + UseCustomEquipOnly=true).
		-- RUID 출처: docs/Codi/manjiRUID. @Sync 프로퍼티라 서버 세팅이 전 클라 반영. 롱코트는 상·하의 슬롯을 점유하므로 coat/pants는 비워 충돌 방지.
		local costume = player.CostumeManagerComponent
		if isvalid(costume) == false then
			log_warning("[PlayerBootstrap] CostumeManagerComponent missing — costume skipped")
			return
		end
		if useOwn then
			costume.CustomHairEquip = ""
			costume.CustomFaceEquip = ""
			costume.CustomLongcoatEquip = ""
			costume.CustomCapEquip = ""
			costume.UseCustomEquipOnly = false
			log("[PlayerBootstrap] costume = OWN(account) for " .. player.Name)
		else
			costume.CustomHairEquip = "5003729e0d77491aa4b8feeb82ead954"
			costume.CustomFaceEquip = "fcc9a22f4ad54b068116e2e5ad86bf66"
			costume.CustomLongcoatEquip = "d942441a03d0468f96c313144a7181f8"
			costume.CustomCapEquip = "946be6efb0514c2b806a3b042ce11f7a"
			costume.CustomCoatEquip = ""
			costume.CustomPantsEquip = ""
			costume.UseCustomEquipOnly = true
			log("[PlayerBootstrap] costume = MANJI for " .. player.Name)
		end
	end

	@ExecSpace("Server")
	method void RequestSetUseOwnCostume(boolean useOwn)
		-- 설정 '내 캐릭터 코디 사용' 체크박스(클라) → 요청 유저 본인의 코디 전환. senderUserId로 본인만 대상.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if player == nil then
			log_warning("[PlayerBootstrap] RequestSetUseOwnCostume — player not found")
			return
		end
		self:ApplyCostume(player, useOwn)
	end

	@ExecSpace("ServerOnly")
	method void GrantDebugItems(Entity player)
		-- 디버그(CheatMode)일 때 시작 시 아이템 3종(rock/smoke/flash) 1개씩 지급 — 이펙트/범위 테스트용. 빈 슬롯부터 채움.
		if _GameConstants.CheatMode == false then return end
		---@type PlayerItems
		local items = player:GetComponent("script.PlayerItems")
		if items == nil then return end
		items:GrantItem("rock")
		items:GrantItem("smoke")
		items:GrantItem("flash")
		log("[PlayerBootstrap] DEBUG granted rock/smoke/flash (CheatMode)")
	end

	@ExecSpace("ServerOnly")
	method void EnsureDashPreview(Entity player)
		-- 대시 조준 미리보기 라인 + 목적지 마커 스프라이트를 플레이어 자식으로 1회씩 스폰 (기본 숨김; 클라가 조준 중 제어).
		self:SpawnChildSprite(player, _GameConstants.DashPreviewModelId, _GameConstants.DashPreviewName)
		self:SpawnChildSprite(player, _GameConstants.DashDestMarkerModelId, _GameConstants.DashDestMarkerName)
		self:SpawnChildSprite(player, _GameConstants.DashRangeModelId, _GameConstants.DashRangeName)
		-- 기즈모 풀(라인/점)은 GizmoManager가 '맵 자식'으로 맵별 스폰한다(LineRenderer는 플레이어 자식이면 렌더 안 됨 — 실측). 여기선 스폰 안 함.
	end

	@ExecSpace("ServerOnly")
	method void SpawnChildSprite(Entity player, string modelId, string name)
		-- 지정 모델을 플레이어 자식으로 1회 스폰 (중복 방지).
		if player:GetChildByName(name, false) ~= nil then return end
		local e = _SpawnService:SpawnByModelId(modelId, name, Vector3(0, 0, 0), player)
		if e == nil then
			log_error("[PlayerBootstrap] child sprite spawn FAILED (model '" .. modelId .. "')")
		else
			log("[PlayerBootstrap] child sprite '" .. name .. "' spawned under " .. player.Name)
		end
	end

end
