@Component
script PlayerSolid extends Component

	-- 로컬 플레이어의 DashBlock 벽 충돌(사이드뷰 플랫포머). 위치를 밀어내지 않고,
	-- 벽에 막힌 방향의 이동속도만 방어(0)한다 → 진동/낙하리셋 없음. 반대 방향 이동은 그대로.
	-- ★윗면(올라서기)은 FootholdComponent가 담당 → 여기선 좌우(측면)만.
	-- ★대시 중엔 PlayerDash가 ray-clamp로 별도 처리 → 이 컴포넌트는 비-대시(걷기/점프)에서만.
	-- PlayerBootstrap이 서버에서 부착.

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로컬 플레이어만: 매 프레임 벽 접촉 방향을 계산해 그 방향 이동속도만 상쇄.
		if self.Entity ~= _UserService.LocalPlayer then return end
		---@type PlayerDash
		local dash = self.Entity:GetComponent("script.PlayerDash")
		if dash ~= nil and dash.IsDashing then return end
		local rb = self.Entity.RigidbodyComponent
		if isvalid(rb) == false then return end
		-- 벽 방향 플래그: left=왼쪽 벽 접촉, right=오른쪽 벽 접촉.
		local block = _CombatPrimitives:ComputeSolidBlock(self.Entity, _GameConstants.PlayerHboxHW, _GameConstants.PlayerHboxHH, _GameConstants.PlayerCenterYOffset)
		local mv = rb.MoveVelocity
		local vx = mv.x
		-- 벽 쪽으로 가려는 성분만 0 (반대 방향은 보존). y(중력/점프)는 불변.
		if block.left and vx < 0 then vx = 0 end
		if block.right and vx > 0 then vx = 0 end
		if vx ~= mv.x then rb.MoveVelocity = Vector2(vx, mv.y) end
	end

end
