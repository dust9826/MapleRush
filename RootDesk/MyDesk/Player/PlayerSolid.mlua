@Component
script PlayerSolid extends Component

	-- 로컬 플레이어를 모든 DashBlock 솔리드 콜라이더의 '측면' 밖으로 밀어낸다(사이드뷰 플랫포머 벽 충돌).
	-- ★윗면(올라서기)은 FootholdComponent가 담당 → 여기선 수평 차단만(_CombatPrimitives:ResolveSolid).
	-- ★대시 중엔 PlayerDash가 벽 ray-clamp를 하므로 이 컴포넌트는 비-대시(걷기/점프)에서만 동작한다.
	-- ★prevX(직전 프레임 X)를 넘겨 '들어온 쪽' 면으로 밀어낸다 → 좁은 벽 관통(터널링) 방지. PlayerBootstrap이 서버에서 부착.

	-- 직전 프레임의 X(진입 방향 판정). 90000=미초기화 센티널.
	@HideFromInspector property number prevX = 99999.0

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로컬 플레이어만: 매 프레임 DashBlock 콜라이더 측면 밖으로 밀어냄(진입 방향 = prevX). (v2)
		if self.Entity ~= _UserService.LocalPlayer then return end
		local curX = self.Entity.TransformComponent.WorldPosition.x
		if self.prevX > 90000 then self.prevX = curX end
		---@type PlayerDash
		local dash = self.Entity:GetComponent("script.PlayerDash")
		if dash ~= nil and dash.IsDashing then
			-- 대시 중엔 클램프 안 하되 prevX는 현재 위치로 갱신(대시 종료 직후 첫 프레임 진입방향 오판 방지).
			self.prevX = curX
			return
		end
		_CombatPrimitives:ResolveSolid(self.Entity, _GameConstants.PlayerHboxHW, _GameConstants.PlayerHboxHH, _GameConstants.PlayerCenterYOffset, self.prevX)
		-- 클램프 반영된 최종 X를 다음 프레임 진입방향 기준으로 저장.
		self.prevX = self.Entity.TransformComponent.WorldPosition.x
	end

end
