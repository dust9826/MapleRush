@Logic
script EventDiscoveryStorage extends Logic

	-- Persistent Repository for discovered event choices. Composite keys avoid cross-event ID collisions.
	property string SaveKey = "event_discovered_choices_v1"
	@HideFromInspector property string ownerUserId = ""
	@HideFromInspector property boolean loaded = false
	@HideFromInspector property any discovered = nil

	method void EnsureCache()
		if self.discovered == nil then
			self.discovered = {}
		end
	end

	method string DiscoveryKey(string eventId, string choiceId)
		return eventId .. "|" .. choiceId
	end

	@ExecSpace("ServerOnly")
	method void LoadFor(string userId)
		if self.loaded and self.ownerUserId == userId then return end
		self.ownerUserId = userId
		self.discovered = {}

		---@type UserDataStorage
		local storage = _DataStorageService:GetUserDataStorage(userId)
		local errorCode, raw = storage:GetAndWait(self.SaveKey)
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local rec = _UtilLogic:StringToTable(raw)
			if rec ~= nil and rec.choices ~= nil then
				for key, value in pairs(rec.choices) do
					if value == true then
						self.discovered[tostring(key)] = true
					end
				end
			end
		end
		self.loaded = true

		local count = 0
		for _, value in pairs(self.discovered) do
			if value == true then count += 1 end
		end
		log("[EventDiscoveryStorage] loaded count=" .. tostring(count)
			.. " (err=" .. tostring(errorCode) .. ")")
	end

	@ExecSpace("ServerOnly")
	method boolean IsDiscovered(string eventId, string choiceId)
		self:EnsureCache()
		return self.discovered[self:DiscoveryKey(eventId, choiceId)] == true
	end

	@ExecSpace("ServerOnly")
	method boolean Discover(string eventId, string choiceId)
		self:EnsureCache()
		local key = self:DiscoveryKey(eventId, choiceId)
		if self.discovered[key] == true then return false end
		self.discovered[key] = true
		self:Persist()
		log("[EventDiscoveryStorage] discovered " .. key)
		return true
	end

	@ExecSpace("ServerOnly")
	method void Persist()
		if self.ownerUserId == "" or self.loaded == false then return end
		self:EnsureCache()
		local choices = {}
		for key, value in pairs(self.discovered) do
			if value == true then choices[key] = true end
		end
		local blob = _UtilLogic:TableToString({
			version = 1,
			choices = choices,
		})
		---@type UserDataStorage
		local storage = _DataStorageService:GetUserDataStorage(self.ownerUserId)
		storage:SetAsync(self.SaveKey, blob, function(errorCode, value)
			if errorCode ~= 0 then
				log_warning("[EventDiscoveryStorage] save failed (err="
					.. tostring(errorCode) .. ")")
			end
		end)
	end

end
