@Component
script HUDController extends Component

	property TextComponent livesText = "508d0bdb-25f9-4e80-92e4-60ae101c165f"

	property SpriteGUIRendererComponent dashPip1 = "73d589cc-55af-43e2-bef7-59ba7946426a"

	property SpriteGUIRendererComponent dashPip2 = "36d524fa-b0ab-4b2b-9891-5c7754bca054"

	property SpriteGUIRendererComponent dashPip3 = "1c126357-9a5f-4728-89b9-5355ca47ce41"

	property SpriteGUIRendererComponent dashPip4 = "3e85c28f-42af-45b8-9ae9-91291b89e7b3"

	property TextComponent mesoText = "2f3eed4a-9c34-4009-b5c1-cf4a2f025d98"

	property TextComponent abilityBtnText = "01e75f7d-0475-4ec7-8e25-4226bbef1e5c"

	-- 능력 사용 피드백(중앙 플래시) — #6(MR-I) 기능 이식. 사용횟수 감소 감지 → "⚡ 능력명 사용!" 1.2s 표시.
	property TextComponent abilityCenterText = "e105adbd-6be6-4fda-acc2-505cfc14ad5c"

	@HideFromInspector property integer prevAbilityUses = -1

	@HideFromInspector property number abilityFlashUntil = -999.0

	@HideFromInspector property string abilityFlashName = ""

	property TextComponent itemText1 = "806b1d40-0be5-4407-8f8a-09f2229239e3"

	property TextComponent itemText2 = "287c275b-1f56-4a49-83a9-1d383c755f48"

	property TextComponent itemText3 = "a4531e18-c11b-4e6a-94ca-112c605f5154"

	-- 슬롯4·5는 itemcap 메타 강화로 해금. 잠금 상태면 어둡게 표시. UUID는 UIBuilder가 주입.
	property TextComponent itemText4 = "9b9cc82d-0f9c-4a17-a365-7c70da225439"

	property TextComponent itemText5 = "87fd433f-08cd-4256-a050-a3391ad5a282"

	-- 보스 오버레이 (보스 스테이지에서만 노출) — MR-K.
	property Entity bossOverlay = "8f921fca-6809-47ee-a002-b0f053bff0d8"

	property SpriteGUIRendererComponent bossHpFill = "e76fadce-6bed-4305-b1b4-52af96041575"

	property TextComponent bossHpText = "ae9f17ae-0972-4d3c-90ed-878b2a5cb797"

	property SpriteGUIRendererComponent groggyFill = "ef27eb6d-e8db-4481-b8ad-a7bf9bff19a6"

	property TextComponent groggyText = "f5c7daef-39fb-479f-8af4-df28e5fcb57c"

	-- 런 타이머 (상단중앙) — 현재 경과시간(큰 폰트) + 이전 기록(작은 폰트). 기획서 §5.2: 색변화 없음, 1초 갱신.
	property TextComponent timerText = "4fb9740f-f8ee-4c83-a4f7-ec8f7b0ae72c"

	property TextComponent timerPrevText = "dc6f01bd-2e5f-42e1-9ee3-38c1d94fb7aa"

	@HideFromInspector property integer prevTimerSecond = -1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- HUD 컨트롤러 시작 로그 (검증용).
		-- 보스 오버레이는 기본 숨김 (보스 스테이지 진입 시 OnUpdate가 노출).
		if isvalid(self.bossOverlay) then
			self.bossOverlay.Enable = false
		end
		log("[HUDController] OnBeginPlay (visual HUD)")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 실제 시간 기준 HUD 갱신 (UI는 매 프레임 폴링).
		local player = _UserService.LocalPlayer
		if player == nil then return end

		-- 목숨: 아이콘 + "× N" 텍스트.
		if isvalid(self.livesText) then
			self.livesText.Text = "× " .. tostring(_GameStateManager.CurrentLives)
		end

		-- 대시: pip 사각형 (충전=노랑 / 사용=배경색 / MaxDash 초과=숨김).
		---@type PlayerDash
		local dash = player:GetComponent("script.PlayerDash")
		if dash ~= nil then
			self:UpdateDashPip(self.dashPip1, 1, dash.DashCount, dash.MaxDash)
			self:UpdateDashPip(self.dashPip2, 2, dash.DashCount, dash.MaxDash)
			self:UpdateDashPip(self.dashPip3, 3, dash.DashCount, dash.MaxDash)
			self:UpdateDashPip(self.dashPip4, 4, dash.DashCount, dash.MaxDash)
		end

		-- 메소: 우상단 (코인 아이콘 옆).
		if isvalid(self.mesoText) then
			self.mesoText.Text = tostring(math.floor(_GameStateManager.Meso)) .. " 메소"
		end

		-- 능력: 우측 버튼 라벨 + 사용 시 중앙 플래시.
		---@type PlayerAbility
		local ability = player:GetComponent("script.PlayerAbility")
		if ability ~= nil then
			self:UpdateAbility(ability)
		end

		-- 아이템: 최대 5개 카드 라벨 + 활성 슬롯 강조. 최대치 초과 슬롯(itemcap 미해금)은 잠금 표시.
		---@type PlayerItems
		local items = player:GetComponent("script.PlayerItems")
		if items ~= nil then
			local maxItems = items:MaxItems()
			self:UpdateItemCard(self.itemText1, items.Slot1, items.ActiveSlot == 1, 1 <= maxItems)
			self:UpdateItemCard(self.itemText2, items.Slot2, items.ActiveSlot == 2, 2 <= maxItems)
			self:UpdateItemCard(self.itemText3, items.Slot3, items.ActiveSlot == 3, 3 <= maxItems)
			self:UpdateItemCard(self.itemText4, items.Slot4, items.ActiveSlot == 4, 4 <= maxItems)
			self:UpdateItemCard(self.itemText5, items.Slot5, items.ActiveSlot == 5, 5 <= maxItems)
		end

		-- 보스 HP/그로기 오버레이 (보스 스테이지에서만).
		if isvalid(self.bossOverlay) then
			self:UpdateBossOverlay(player)
		end

		-- 런 타이머 (상단중앙): 런 진행 중에만 표시, 초 단위 갱신.
		self:UpdateTimer()
	end

	@ExecSpace("ClientOnly")
	method void UpdateTimer()
		-- 현재 경과시간(MM:SS) + 이전 기록. 런 미진행 시 숨김. 표시는 초가 바뀔 때만 갱신(§3.4).
		if isvalid(self.timerText) == false then return end
		if _RunTimer.Running == false then
			self.timerText.Text = ""
			if isvalid(self.timerPrevText) then self.timerPrevText.Text = "" end
			self.prevTimerSecond = -1
			return
		end
		local now = _RunTimer:ClientElapsed()
		local sec = math.floor(now)
		if sec == self.prevTimerSecond then return end
		self.prevTimerSecond = sec
		self.timerText.Text = _RecordStorage:FormatClock(now)
		self:UpdateTimerPrev()
	end

	@ExecSpace("ClientOnly")
	method void UpdateTimerPrev()
		-- 이전 기록 라인: 현재 도달 진행도(층-진행도)의 과거 최고 시간. 없으면 비표시(기획서 §5.2).
		if isvalid(self.timerPrevText) == false then return end
		local floor = _GameStateManager.CurrentFloor
		local progress = _RecordStorage:ComputeStageProgress(_FloorManager.NormalsClearedThisFloor, _FloorManager.ShopDoneThisFloor, false)
		local key = tostring(floor) .. "-" .. tostring(progress)
		local prev = _RecordStorage.StageBests[key]
		if prev ~= nil and prev > 0 then
			self.timerPrevText.Text = _RecordStorage:FormatBest(prev)
		else
			self.timerPrevText.Text = ""
		end
	end

	-- 대시 셰브런 이미지(충전=on / 미충전=off). 캐릭터관련 에셋.
	property string dashOnRuid = "24e870107838488581f6764822a3e0e6"

	property string dashOffRuid = "1655c911993b4321a60029d048732845"

	@ExecSpace("ClientOnly")
	method void UpdateDashPip(SpriteGUIRendererComponent pip, integer idx, integer count, integer max)
		-- 대시 pip 1칸 갱신: MaxDash 초과 칸은 비활성(숨김), 그 이내에서 충전=on 셰브런 / 미충전=off 셰브런.
		if isvalid(pip) == false then return end
		if idx > max then
			-- 최대 대시 개수를 넘는 칸은 아예 비활성화(렌더 숨김).
			pip.Enable = false
			return
		end
		pip.Enable = true
		pip.Color = Color(1, 1, 1, 1)
		-- 충전 여부에 따라 on/off 이미지 스왑(값 바뀔 때만 — 매 프레임 재로드 방지).
		local want = self.dashOffRuid
		if idx <= count then want = self.dashOnRuid end
		if pip.ImageRUID == nil or pip.ImageRUID.DataId ~= want then
			pip.ImageRUID = DataRef(want)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateBossOverlay(Entity player)
		-- 보스 HP/그로기 게이지 오버레이 갱신 (보스 스테이지에서만 노출).
		local map = player.CurrentMap
		if isvalid(map) == false then
			self.bossOverlay.Enable = false
			return
		end
		local list = map:GetChildComponentsByTypeName("script.EnemyHealth", true)
		for _, compAny in ipairs(list) do
			---@type EnemyHealth
			local comp = compAny
			if isvalid(comp.Entity) and comp.EnemyKind == "boss" and comp.IsDead == false then
				-- 보스 발견: 오버레이 노출 + HP 바 갱신.
				self.bossOverlay.Enable = true
				local ratio = 0
				if comp.MaxHP > 0 then ratio = comp.HP / comp.MaxHP end
				if ratio < 0 then ratio = 0 elseif ratio > 1 then ratio = 1 end
				if isvalid(self.bossHpFill) then self.bossHpFill.FillAmount = ratio end
				if isvalid(self.bossHpText) then
					self.bossHpText.Text = tostring(math.floor(comp.HP)) .. " / " .. tostring(math.floor(comp.MaxHP))
				end
				-- 보스별 HP바 프레임(초상화+라벨 포함) 스왑 — BossKind로 선택.
				self:UpdateBossFrame(comp.Entity)
				-- 그로기 게이지 + 상태 연출.
				---@type GroggyGauge
				local gg = comp.Entity:GetComponent("script.GroggyGauge")
				self:UpdateGroggy(gg)
				return
			end
		end
		-- 보스 없음: 오버레이 숨김.
		self.bossOverlay.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void UpdateBossFrame(Entity bossEntity)
		-- 보스별 HP바 프레임 이미지 스왑(BossKind → RUID). 값 바뀔 때만 갱신.
		if isvalid(self.bossOverlay) == false then return end
		---@type BossController
		local bc = bossEntity:GetComponent("script.BossController")
		if bc == nil then return end
		local want = ""
		if bc.BossKind == "zakum" then
			want = "399ade3ce39c410aaa2ca2c48c6bb99c"
		elseif bc.BossKind == "elija" then
			want = "8829c8420c7c4b6096663de0fcb81050"
		elseif bc.BossKind == "snowman" then
			want = "d5bfc98793be4affa511375becd46741"
		end
		if want == "" then return end
		local rend = self.bossOverlay.SpriteGUIRendererComponent
		if isvalid(rend) and (rend.ImageRUID == nil or rend.ImageRUID.DataId ~= want) then
			rend.ImageRUID = DataRef(want)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateGroggy(GroggyGauge gg)
		-- 그로기 바 갱신: 평상시=충전 비율, 그로기 상태=가득 채움 + 점멸 연출.
		if gg == nil then
			if isvalid(self.groggyFill) then self.groggyFill.FillAmount = 0 end
			if isvalid(self.groggyText) then self.groggyText.Text = "" end
			return
		end
		if gg.IsGroggy == true then
			-- 그로기 발동: 가득 + 흰/노랑 점멸로 강조.
			if isvalid(self.groggyFill) then
				self.groggyFill.FillAmount = 1
				local on = (math.floor(_UtilLogic.ElapsedSeconds * 6) % 2) == 0
				if on then
					self.groggyFill.Color = Color(1, 1, 1, 1)
				else
					self.groggyFill.Color = Color(0.98, 0.66, 0.12, 1)
				end
			end
			if isvalid(self.groggyText) then self.groggyText.Text = "그로기!" end
		else
			-- 평상시: 충전 비율 표시.
			local pct = 0
			local ratio = 0
			if gg.GaugeMax > 0 then
				ratio = gg.Gauge / gg.GaugeMax
				if ratio < 0 then ratio = 0 elseif ratio > 1 then ratio = 1 end
				pct = math.floor(ratio * 100)
			end
			if isvalid(self.groggyFill) then
				self.groggyFill.FillAmount = ratio
				self.groggyFill.Color = Color(0.98, 0.66, 0.12, 1)
			end
			if isvalid(self.groggyText) then self.groggyText.Text = "그로기 " .. tostring(pct) .. "%" end
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateAbility(PlayerAbility ability)
		-- 능력을 텍스트 대신 아이콘으로 표시(사용 가능=기본 / 사용횟수 0=비활성 아이콘). 능력 없으면 아이콘 숨김.
		local id = ability.AbilityId
		local uses = ability.UsesLeft
		self.prevAbilityUses = uses
		-- 라벨 텍스트 제거(아이콘으로 대체).
		if isvalid(self.abilityBtnText) then self.abilityBtnText.Text = "" end
		if isvalid(self.abilityCenterText) then self.abilityCenterText.Text = "" end
		-- 능력 버튼 아이콘 갱신.
		if isvalid(self.abilityBtnText) == false then return end
		local ico = self.abilityBtnText.Entity:GetChildByName("Ico")
		if isvalid(ico) == false then return end
		if id == "" then
			ico.Enable = false
			return
		end
		ico.Enable = true
		local ir = self:AbilityIcon(id, uses > 0)
		if ir == "" then return end
		local isr = ico.SpriteGUIRendererComponent
		if isvalid(isr) and (isr.ImageRUID == nil or isr.ImageRUID.DataId ~= ir) then isr.ImageRUID = DataRef(ir) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateItemCard(TextComponent text, string itemId, boolean active, boolean visible)
		-- 아이템 카드 1칸 갱신: 라벨 + 활성 슬롯은 카드 배경을 금색으로 강조.
		-- 현재 최대 보관 수(itemcap)를 넘는 슬롯은 카드 자체를 미노출(잠금 표시 X).
		if isvalid(text) == false then return end
		local card = text.Entity
		if visible == false then
			if isvalid(card) then card.Enable = false end
			return
		end
		if isvalid(card) then card.Enable = true end
		-- 라벨 텍스트 대신 아이템 아이콘 표시. 빈 슬롯이면 아이콘 숨김.
		text.Text = ""
		local ico = card:GetChildByName("Ico")
		if isvalid(ico) then
			local ir = self:ItemIcon(itemId)
			if ir == "" then
				ico.Enable = false
			else
				ico.Enable = true
				local isr = ico.SpriteGUIRendererComponent
				if isvalid(isr) and (isr.ImageRUID == nil or isr.ImageRUID.DataId ~= ir) then isr.ImageRUID = DataRef(ir) end
			end
		end
		local sprite = card.SpriteGUIRendererComponent
		if isvalid(sprite) then
			if active then
				-- 활성(사용될 슬롯): 슬롯 이미지를 금색으로 틴트 + 대비용 어두운 글자.
				sprite.Color = Color(0.96, 0.78, 0.20, 1)
				text.FontColor = Color(0.10, 0.10, 0.12, 1)
			else
				-- 비활성: 슬롯 이미지 원색(흰 틴트) + 흰 글자.
				sprite.Color = Color(1, 1, 1, 1)
				text.FontColor = Color(1, 1, 1, 1)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string ItemLabel(string itemId)
		-- 아이템 슬롯 라벨 ([짱돌] 형식). 활성 표시는 카드 색으로 처리.
		if itemId == "rock" then return "짱돌"
		elseif itemId == "smoke" then return "연막"
		elseif itemId == "flash" then return "섬광"
		end
		return "-"
	end

	@ExecSpace("ClientOnly")
	method string ItemIcon(string itemId)
		-- 아이템 종류별 아이콘 RUID. 빈 슬롯("")은 "" 반환 → 아이콘 숨김.
		if itemId == "rock" then return "9f317ee0b97d44dba5f85fb352aee093"
		elseif itemId == "flash" then return "bb183c305c274a1da619165665255b9f"
		elseif itemId == "smoke" then return "dbdbb1b56ae54672ae68ac6882fff6a2"
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method string AbilityIcon(string id, boolean usable)
		-- 능력별 아이콘 RUID. usable=true→기본, false(사용횟수 0 등)→비활성 아이콘.
		if id == "invincible" then
			if usable then return "c1ad0196beed412cad77cce63d75fea8" else return "cd268905acec4ed4a7ba988c1c890245" end
		elseif id == "clearProjectiles" then
			-- 참공: 기본 아이콘 미제공 → 마우스오버 아이콘을 기본으로 대용.
			if usable then return "8bf6011177e7458fb4e536ccc312104d" else return "440b5586b8ff4062b1d7cb04c4c53ab4" end
		elseif id == "immovable" then
			if usable then return "4b190775131740bfa2def611eb34c3f5" else return "b9779b8a88a1421bb83d4c357fea47ff" end
		elseif id == "manji" then
			if usable then return "4c316227ade8479eb7cb1c03566f2676" else return "72e38d824ac04a75ac053e92612cb36b" end
		elseif id == "spin" then
			if usable then return "55aadc0ec19b4124a0cca1eb7a4056fa" else return "2e815a776c4a4a28974c0bd9208d8c75" end
		end
		return ""
	end

end
