@Component
script LobbyController extends Component

	-- 로비 루트 (전체 토글) + 4개 메뉴 버튼.
	property Entity lobbyRoot = "7bbdf71d-969c-4536-b939-4bd242c7b528"

	property ButtonComponent btnStart = "775dac4e-ef17-4c0e-b16f-28a680298ed0"

	-- "튜토리얼" 버튼 → 튜토리얼 맵 진입 (무적 연습장). 바인딩 주입.
	property ButtonComponent btnTutorial = "1188778b-16d1-41f0-9aa4-9572f2fabeeb"

	property ButtonComponent btnSettings = "e5f542ab-23f3-4958-9fcd-33ab9f6e74e2"

	property ButtonComponent btnRest = "c2e314d1-0dad-426e-8feb-8af03dc5931a"

	-- "능력치 강화" 버튼 → 메타 강화 화면(MetaUpgradeGroup) 오버레이 열기.
	property ButtonComponent btnUpgrade = "1c7f5999-d5ac-4c72-8a0c-44f01c0742be"

	property MetaUpgradeController metaCtrl = "6287c883-1d96-47f8-ac0a-cbabb609d0ed"

	-- "잠시 휴식하기" 팝업: MSW엔 스크립트 종료 API가 없어 ESC/시스템 메뉴 안내만 표시.
	property Entity restConfirm = "208f2c5e-e60b-423d-b1a7-235eac9c19dd"

	property ButtonComponent btnRestOk = "0caff84b-c10a-41d0-9f6d-c2a342f626d1"

	-- 베스트 기록판 (중앙 좌측) — 기획서 §5.1. 기록 값은 _RecordStorage @Sync에서, 순위 라인은 리더보드 연동(RT5).
	property TextComponent recordLineText = "ceab0671-e8eb-4ce1-b14e-1e2e91032c80"

	property TextComponent recordTimeText = "b0c2e9c0-4889-4e40-bf57-35d374a33983"

	property TextComponent recordRankText = "cdfc8a66-b005-435d-b89a-472feb5f789e"

	-- 글로벌 랭킹 TOP N 리스트 본문(여러 줄 1개 텍스트). §8.2 상위 10명 + 내 순위.
	property TextComponent leaderboardText = "0fc215bb-2662-4d2e-96fa-4eb8b2032df9"

	@HideFromInspector property boolean wasLobbyVisible = false

	property any hStart = nil

	property any hTutorial = nil

	property any hSettings = nil

	property any hRest = nil

	property any hUpgrade = nil

	property any hRestOk = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 메인 로비: 부팅 시 서브팝업 숨김 + 버튼 연결. 로비 표시·bgm_title·입력 컨텍스트(Lobby)는 컷씬 종료 시 CutsceneController가 담당.
		if isvalid(self.restConfirm) then self.restConfirm.Enable = false end
		if isvalid(self.lobbyRoot) then self.lobbyRoot.Enable = false end
		-- 리더보드 결과 수신용으로 자기 등록.
		_RecordStorage.lobbyUI = self
		self.hStart = self.btnStart.Entity:ConnectEvent(ButtonClickEvent, self.OnStartClick)
		self.hTutorial = self.btnTutorial.Entity:ConnectEvent(ButtonClickEvent, self.OnTutorialClick)
		self.hSettings = self.btnSettings.Entity:ConnectEvent(ButtonClickEvent, self.OnSettingsClick)
		self.hRest = self.btnRest.Entity:ConnectEvent(ButtonClickEvent, self.OnRestClick)
		self.hUpgrade = self.btnUpgrade.Entity:ConnectEvent(ButtonClickEvent, self.OnUpgradeClick)
		self.hRestOk = self.btnRestOk.Entity:ConnectEvent(ButtonClickEvent, self.OnRestOk)
		log("[LobbyController] init (hidden; cutscene will reveal lobby)")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 연결한 버튼 핸들러 전부 해제.
		if self.hStart ~= nil then self.btnStart.Entity:DisconnectEvent(ButtonClickEvent, self.hStart) end
		if self.hTutorial ~= nil then self.btnTutorial.Entity:DisconnectEvent(ButtonClickEvent, self.hTutorial) end
		if self.hSettings ~= nil then self.btnSettings.Entity:DisconnectEvent(ButtonClickEvent, self.hSettings) end
		if self.hRest ~= nil then self.btnRest.Entity:DisconnectEvent(ButtonClickEvent, self.hRest) end
		if self.hUpgrade ~= nil then self.btnUpgrade.Entity:DisconnectEvent(ButtonClickEvent, self.hUpgrade) end
		if self.hRestOk ~= nil then self.btnRestOk.Entity:DisconnectEvent(ButtonClickEvent, self.hRestOk) end
	end

	@ExecSpace("ClientOnly")
	method void OnStartClick(ButtonClickEvent event)
		-- "구하러 가기": 로비 숨김 → 서버에 런 시작 요청(StartRun + 1층 테마 선택 플로우).
		self.lobbyRoot.Enable = false
		_SoundManager:StopBGM()
		_StageManager:RequestStartRun()
		log("[LobbyController] start run requested")
	end

	@ExecSpace("ClientOnly")
	method void OnTutorialClick(ButtonClickEvent event)
		-- "튜토리얼": 로비 숨김 → 서버에 튜토리얼 시작 요청(맵 이동 + 무적 연습장).
		--   BGM은 타이틀곡(bgm_title)을 정지하지 않고 그대로 이어간다 → 튜토리얼 배경음 = 타이틀 배경음.
		self.lobbyRoot.Enable = false
		_TutorialManager:RequestStartTutorial()
		log("[LobbyController] tutorial requested")
	end

	@ExecSpace("ClientOnly")
	method void OnSettingsClick(ButtonClickEvent event)
		-- "설정": 공용 설정 창 열기 (_SettingsMenu 중개 → SettingsController).
		_SettingsMenu:Open()
		log("[LobbyController] settings opened (shared)")
	end

	@ExecSpace("ClientOnly")
	method void OnUpgradeClick(ButtonClickEvent event)
		-- "능력치 강화": 메타 강화 화면을 오버레이로 열기 (로비는 뒤에 유지).
		if isvalid(self.metaCtrl) then
			self.metaCtrl:Open()
			log("[LobbyController] meta upgrade opened")
		else
			log_error("[LobbyController] metaCtrl not bound")
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRestClick(ButtonClickEvent event)
		-- "잠시 휴식하기": MSW엔 스크립트 종료 API가 없어 ESC/시스템 메뉴 안내 팝업만 표시.
		self.restConfirm.Enable = true
		log("[LobbyController] exit guide opened")
	end

	@ExecSpace("ClientOnly")
	method void OnRestOk(ButtonClickEvent event)
		-- 안내 확인 → 팝업 닫기 (실제 종료는 ESC / 우상단 시스템 메뉴 담당).
		self.restConfirm.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로비 표시 중일 때만: 진입 순간 1회 글로벌 랭킹 조회, 매 프레임 기록판 텍스트 갱신.
		local visible = isvalid(self.lobbyRoot) and self.lobbyRoot.Enable
		if visible == false then
			self.wasLobbyVisible = false
			return
		end
		if self.wasLobbyVisible == false then
			self.wasLobbyVisible = true
			-- 로비 진입: 순위/상위10 조회(서버 → ClientReceiveLeaderboard → ShowLeaderboard).
			if isvalid(self.recordRankText) then self.recordRankText.Text = "글로벌 순위: 조회 중..." end
			if isvalid(self.leaderboardText) then self.leaderboardText.Text = "불러오는 중..." end
			_RecordStorage:RequestLeaderboard(10)
		end
		self:RefreshRecordBoard()
	end

	@ExecSpace("ClientOnly")
	method void RefreshRecordBoard()
		-- 베스트 기록판 문구 갱신 (기획서 §5.1 케이스별). 순위/리스트는 ShowLeaderboard가 담당.
		if isvalid(self.recordLineText) == false then return end
		if _RecordStorage.HasRecord == false then
			self.recordLineText.Text = "기록 없음 — 첫 도전!"
			if isvalid(self.recordTimeText) then self.recordTimeText.Text = "" end
			return
		end
		local floor = _RecordStorage.BestFloor
		local phase = _RecordStorage.BestPhase
		local label = ""
		if phase == "boss_cleared" then
			if floor >= _GameConstants.MaxFloors then
				label = "전 층 클리어"
			else
				label = tostring(floor) .. "층 클리어"
			end
		else
			label = tostring(floor) .. "층 · 스테이지 " .. tostring(_RecordStorage.BestStageInFloor)
		end
		self.recordLineText.Text = label
		if isvalid(self.recordTimeText) then
			self.recordTimeText.Text = _RecordStorage:FormatBest(_RecordStorage.BestTime)
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowLeaderboard(integer myRank, table rows)
		-- 서버가 보낸 내 순위 + 상위 리스트 표시(§8.2). rows = 표시용 행 문자열 배열.
		if isvalid(self.recordRankText) then
			if myRank > 0 then
				self.recordRankText.Text = "글로벌 순위: #" .. tostring(myRank)
			else
				self.recordRankText.Text = "글로벌 순위: 미등록"
			end
		end
		if isvalid(self.leaderboardText) then
			if rows == nil or #rows == 0 then
				self.leaderboardText.Text = "아직 랭킹 데이터가 없습니다."
			else
				self.leaderboardText.Text = table.concat(rows, "\n")
			end
		end
	end

end
