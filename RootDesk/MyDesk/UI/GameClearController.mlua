@Component
script GameClearController extends Component

	property Entity clearRoot = "eaf31109-893d-43a5-9805-62e13cc88e52"

	property TextComponent statsText = "58bce7d9-40af-406d-80a4-fd91e3bdcf7d"

	property TextComponent scoreText = "393a9a12-ca34-450e-9eab-140bfe2a85aa"

	property ButtonComponent btnRestart = "3c34751f-5e88-4f94-a614-2516d2b81735"

	-- "로비로" 버튼.
	property ButtonComponent btnLobby = "d186d353-e683-4485-9e08-15b8d8d92f83"

	property any hRestart = nil

	property any hLobby = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- FloorManager에 등록 + 숨김 + 버튼 연결.
		_FloorManager.gameClearUI = self
		if isvalid(self.clearRoot) then self.clearRoot.Enable = false end
		self.hRestart = self.btnRestart.Entity:ConnectEvent(ButtonClickEvent, self.OnRestartClick)
		self.hLobby = self.btnLobby.Entity:ConnectEvent(ButtonClickEvent, self.OnLobbyClick)
		log("[GameClearController] registered")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 해제.
		if self.hRestart ~= nil then self.btnRestart.Entity:DisconnectEvent(ButtonClickEvent, self.hRestart) end
		if self.hLobby ~= nil then self.btnLobby.Entity:DisconnectEvent(ButtonClickEvent, self.hLobby) end
	end

	@ExecSpace("ClientOnly")
	method void Open(integer score)
		-- 게임 클리어 팝업 (PDF p.14 동일 레이아웃): 도달 층 · 처치 · 메소 + 영구 강화 점수.
		self.clearRoot.Enable = true
		self.statsText.Text = "도달 " .. tostring(_GameStateManager.CurrentFloor) .. "층   ·   처치 " .. tostring(_GameStateManager.RunKills) .. "   ·   메소 " .. tostring(math.floor(_GameStateManager.Meso))
		self.scoreText.Text = "영구 강화 점수 +" .. tostring(score) .. "    (누적 " .. tostring(_MetaProgression.MetaScore) .. ")"
		log("[GameClearController] opened (score=" .. tostring(score) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void OnRestartClick(ButtonClickEvent event)
		-- 다시 도전: 팝업 닫고 회귀 연출 재생(오버레이가 새 런 시작 수행). 폴백=기존 즉시 경로.
		self.clearRoot.Enable = false
		---@type RegressionOverlay
		local ov = _StageManager.regressionOverlay
		if ov ~= nil and isvalid(ov) then
			ov:Play("restart")
		else
			_InputRouter:SetContext("Combat")
			_StageManager:RequestRestartRun()
		end
		log("[GameClearController] restart -> regression")
	end

	@ExecSpace("ClientOnly")
	method void OnLobbyClick(ButtonClickEvent event)
		-- 로비로: 팝업 닫고 회귀 연출 재생(오버레이가 로비 복귀 수행). 폴백=기존 즉시 로비 복귀.
		self.clearRoot.Enable = false
		---@type RegressionOverlay
		local ov = _StageManager.regressionOverlay
		if ov ~= nil and isvalid(ov) then
			ov:Play("lobby")
		else
			local lobby = _EntityService:GetEntityByPath("/ui/LobbyGroup/Root")
			if lobby ~= nil then lobby.Enable = true end
			_SelectBackdrop:ShowLoading(false)
			_InputRouter:SetContext("Lobby")
			_SoundManager:PlayBGMKey("bgm_title")
		end
		log("[GameClearController] lobby -> regression")
	end

end
