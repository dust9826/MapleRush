@Component
script SettingsController extends Component

	-- 공용 설정 창(로비/일시정지 공유). 로비·일시정지의 "설정" 버튼이 이 컨트롤러의 Open()을 호출해 같은 창을 띄운다.
	-- 담당: 사운드(BGM/SFX 슬라이더) + "내 캐릭터 코디 사용" 체크박스. 닫기는 자체 처리(뒤의 원래 화면 유지).

	-- 딤+패널 루트 (Open/Close로 토글). SettingsGroup은 default_show=true, 이 Root만 켜고 끈다.
	property Entity settingsRoot = "f9a8cff8-f11b-4cf8-bbdf-74a4aedf2bfa"

	property ButtonComponent btnClose = "2171285a-50f7-49f4-9c3c-f37af0a42b90"

	property SliderComponent bgmSlider = "71f90b7e-4f36-4919-8257-5f4bbb209ffc"

	property SliderComponent sfxSlider = "f42bbb5b-78c3-4827-991b-40da7e5d3e79"

	property TextComponent bgmValueText = "242ca4a5-257d-49fb-8e4b-ac2955abee99"

	property TextComponent sfxValueText = "5c2f6f3b-8e3b-4690-83f0-0c1850cd625e"

	-- "내 캐릭터 코디 사용" 체크박스(버튼). 체크=내 계정 코디 / 해제=만지. 상태는 서버 CostumeManagerComponent.UseCustomEquipOnly 권위.
	property ButtonComponent btnCostume = "a454ce10-a9ce-4ec7-97fc-5c222019b7df"

	property any hClose = nil

	property any hBgm = nil

	property any hSfx = nil

	property any hCostume = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 부팅: 중개 Logic에 자기 등록(로비/일시정지가 _SettingsMenu 통해 호출) + 창 숨김 + 버튼/슬라이더 연결.
		_SettingsMenu.ctrl = self
		if isvalid(self.settingsRoot) then self.settingsRoot.Enable = false end
		self.hClose = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClick)
		if isvalid(self.btnCostume) then
			self.hCostume = self.btnCostume.Entity:ConnectEvent(ButtonClickEvent, self.OnCostumeToggle)
		end
		if isvalid(self.bgmSlider) then
			local bv = _SoundManager:GetBgmVolume()
			self.bgmSlider.Value = bv
			self:UpdateBgmText(bv)
			self.hBgm = self.bgmSlider.Entity:ConnectEvent(SliderValueChangedEvent, self.OnBgmChanged)
		end
		if isvalid(self.sfxSlider) then
			local sv = _SoundManager:GetSfxVolume()
			self.sfxSlider.Value = sv
			self:UpdateSfxText(sv)
			self.hSfx = self.sfxSlider.Entity:ConnectEvent(SliderValueChangedEvent, self.OnSfxChanged)
		end
		log("[SettingsController] ready")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 연결 해제.
		if self.hClose ~= nil then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.hClose) end
		if self.hCostume ~= nil and isvalid(self.btnCostume) then self.btnCostume.Entity:DisconnectEvent(ButtonClickEvent, self.hCostume) end
		if self.hBgm ~= nil and isvalid(self.bgmSlider) then self.bgmSlider.Entity:DisconnectEvent(SliderValueChangedEvent, self.hBgm) end
		if self.hSfx ~= nil and isvalid(self.sfxSlider) then self.sfxSlider.Entity:DisconnectEvent(SliderValueChangedEvent, self.hSfx) end
	end

	@ExecSpace("ClientOnly")
	method boolean IsSettingsOpen()
		-- 설정 창이 열려 있는지 (일시정지 ESC 처리 등에서 사용).
		return isvalid(self.settingsRoot) and self.settingsRoot.Enable
	end

	@ExecSpace("ClientOnly")
	method void ShowSettings()
		-- 설정 창 표시 + 현재 상태 동기화(볼륨 슬라이더 + 코디 체크박스). 로비/일시정지 "설정" 버튼이 호출.
		if isvalid(self.bgmSlider) then
			local bv = _SoundManager:GetBgmVolume()
			self.bgmSlider.Value = bv
			self:UpdateBgmText(bv)
		end
		if isvalid(self.sfxSlider) then
			local sv = _SoundManager:GetSfxVolume()
			self.sfxSlider.Value = sv
			self:UpdateSfxText(sv)
		end
		self:SetCheckboxVisual(self:IsUseOwnCostume())
		if isvalid(self.settingsRoot) then self.settingsRoot.Enable = true end
	end

	@ExecSpace("ClientOnly")
	method void HideSettings()
		-- 설정 창 닫기 (뒤의 원래 화면=로비/일시정지 유지).
		if isvalid(self.settingsRoot) then self.settingsRoot.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClick(ButtonClickEvent event)
		-- 닫기 버튼.
		self:HideSettings()
	end

	@ExecSpace("ClientOnly")
	method void OnBgmChanged(SliderValueChangedEvent event)
		-- 배경음 슬라이더 → SoundManager 반영 + 텍스트.
		_SoundManager:SetBgmVolume(event.Value)
		self:UpdateBgmText(event.Value)
	end

	@ExecSpace("ClientOnly")
	method void OnSfxChanged(SliderValueChangedEvent event)
		-- 효과음 슬라이더 → SoundManager 반영 + 텍스트. (클릭음은 전역 후킹이 담당)
		_SoundManager:SetSfxVolume(event.Value)
		self:UpdateSfxText(event.Value)
	end

	@ExecSpace("ClientOnly")
	method void UpdateBgmText(number v)
		-- 배경음 현재값 % 표기.
		if isvalid(self.bgmValueText) then self.bgmValueText.Text = self:FormatPct(v) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateSfxText(number v)
		-- 효과음 현재값 % 표기.
		if isvalid(self.sfxValueText) then self.sfxValueText.Text = self:FormatPct(v) end
	end

	method string FormatPct(number v)
		-- 0.0~1.0 볼륨을 "NN%" 문자열로 변환.
		return tostring(math.floor(v * 100 + 0.5)) .. "%"
	end

	@ExecSpace("ClientOnly")
	method boolean IsUseOwnCostume()
		-- 내 계정 코디 사용 중인지 = 로컬 플레이어 CostumeManagerComponent.UseCustomEquipOnly == false (서버 권위, @Sync).
		local p = _UserService.LocalPlayer
		if isvalid(p) == false then return false end
		local cm = p.CostumeManagerComponent
		if isvalid(cm) == false then return false end
		return cm.UseCustomEquipOnly == false
	end

	@ExecSpace("ClientOnly")
	method void SetCheckboxVisual(boolean checked)
		-- 체크박스 표시: 체크=✓ + 초록 배경 / 해제=빈칸 + 회색 배경. (폰트가 ✓ 글리프를 못 그려도 배경색으로 상태 구분)
		if isvalid(self.btnCostume) == false then return end
		local e = self.btnCostume.Entity
		-- 체크칸 프레임(설정_체크칸)은 항상 흰색 원색, 체크표시(설정_체크) 이미지 자식만 토글.
		local mark = e:GetChildByName("CheckMark")
		if isvalid(mark) then mark.Enable = checked end
	end

	@ExecSpace("ClientOnly")
	method void OnCostumeToggle(ButtonClickEvent event)
		-- 체크 토글 → 서버에 코디 전환 요청. @Sync 반영 전 체크박스 즉시 갱신(낙관적).
		local newUseOwn = not self:IsUseOwnCostume()
		_PlayerBootstrap:RequestSetUseOwnCostume(newUseOwn)
		self:SetCheckboxVisual(newUseOwn)
		log("[SettingsController] costume toggle -> useOwn=" .. tostring(newUseOwn))
	end

end
