@Component
script EnemyHealth extends Component

	property number MaxHP = 30.0

	@Sync
	property number HP = 30.0

	-- melee / ranged / boss / dummy
	property string EnemyKind = "dummy"

	-- 종족 태그(pixie/lioner/pepe/whitefang/jrbulldog/boogie). 잡몹 종족 공격/사망음 키 구성용.
	-- 빈 문자열이면 종족음 미재생(제네릭 잡몹). 변종 모델(.model Values)에서 지정. 보스는 EnemyKind="boss"로 별도 처리라 미사용.
	property string Species = ""

	@Sync
	property boolean IsDead = false

	-- 피격 모션 윈도우 끝 시각(ServerElapsedSeconds). AI가 이 시각 전까지 hit 클립 재생 + 공격 중단(=피격 경직). @Sync 불필요(AI=서버).
	property number hitClipUntil = -999.0

	-- 사망 클립이 보이도록 파괴를 이 시간만큼 지연.
	property number DeadAnimDelay = 0.8

	-- 피격 스턴 시간(초): 이 동안 적이 공격 중단 + hit 모션. 인스펙터에서 적별 조정. (타격감 피격 경직 = 이 시스템으로 통합)
	property number HitStunDuration = 0.5

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 층 스케일링: 최대 체력 ×(1 + 0.2*(층-1)), 소숫점 버림 (합연산). 런 밖(튜토리얼 등)은 무배율.
		--   모델 기본 MaxHP가 완전히 적용된 뒤(OnBeginPlay)라 스폰 직후 읽기 레이스가 없다.
		local floor = 1
		if _GameStateManager.RunActive then floor = _GameStateManager.CurrentFloor end
		local scaled = math.floor(self.MaxHP * _GameConstants:EnemyHpMultForFloor(floor))
		if scaled < 1 then scaled = 1 end
		self.MaxHP = scaled
		-- HP를 최대치로 초기화.
		self.HP = self.MaxHP
		log("[EnemyHealth] spawned: " .. self.Entity.Name .. " kind=" .. self.EnemyKind .. " floor=" .. tostring(floor) .. " HP=" .. tostring(self.HP))
	end

	@ExecSpace("ServerOnly")
	method void TakeDamage(number amount, string source)
		-- 서버 권위 데미지 적용. 보스는 그로기 게이지 충전 (일반공격=데미지량 / 반사 명중=(ATK×100%)×2). HP 0 이하 시 사망.
		if self.IsDead then return end
		-- 피격 스턴/모션 윈도우 개시(AI가 공격 중단 + hit 클립). 사망 시엔 die 클립이 우선.
		self.hitClipUntil = _WallClock:ServerNow() + self.HitStunDuration
		self.HP = self.HP - amount
		log("[EnemyHealth] " .. self.Entity.Name .. " took " .. tostring(amount) .. " dmg from " .. source .. " -> HP=" .. tostring(self.HP))
		self:PlayHitEffect()
		-- 타격감: 클라 카메라 셰이크/히트스톱/타격음. (피격 경직은 위 hitClipUntil = HitStunDuration 시스템이 담당)
		_HitFeedback:OnEnemyHit(self.Entity)
		if self.EnemyKind == "boss" then
			---@type GroggyGauge
			local gg = self.Entity:GetComponent("script.GroggyGauge")
			if gg ~= nil then
				local charge = amount
				if source == "reflect" then
					charge = _GameStateManager.AttackStat * _GameConstants.GroggyParryMult
				end
				gg:Charge(charge, source)
			end
		end
		if self.HP <= 0 then
			self:Die(source)
		end
	end

	@ExecSpace("ServerOnly")
	method void Die(string source)
		-- 사망 처리. 스테이지 처치 카운트 통지 후 엔티티 소멸.
		if self.IsDead then return end
		self.IsDead = true
		log("[EnemyHealth] " .. self.Entity.Name .. " died (killed by " .. source .. ")")
		_StageManager:OnEnemyKilled(self.EnemyKind)
		-- 튜토리얼 전멸 카운트 (튜토리얼 중이 아니면 내부에서 무시).
		_TutorialManager:NotifyEnemyKilled()
		-- 보스 사망음 (테마 보스별 sfx_boss_<kind>_death).
		if self.EnemyKind == "boss" then
			---@type BossController
			local bc = self.Entity:GetComponent("script.BossController")
			if bc ~= nil and bc.BossKind ~= "" then
				self:PlayDeathSfx("sfx_boss_" .. bc.BossKind .. "_death")
			end
		else
			-- 잡몹 종족 사망음 (sfx_death_<species>). Species 미지정(제네릭)이면 PlaySpeciesSfx가 무음 처리.
			self:PlaySpeciesSfx("death")
		end
		-- 즉시 파괴하지 않고 지연 → AI가 IsDead 감지해 dead 클립 재생(사망 모션). DeadAnimDelay 후 소멸.
		self.Entity:Destroy(self.DeadAnimDelay)
	end

	@ExecSpace("Multicast")
	method void PlayHitEffect()
		-- 전 클라: 피격 지점(적 중심)에 히트 이펙트 버스트 1회 재생. 서버 TakeDamage가 매 피격 호출.
		if isvalid(self.Entity) == false then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local center = Vector3(pos.x, pos.y + _GameConstants.EnemyHitEffectYOffset, pos.z)
		local s = _GameConstants.EnemyHitEffectScale
		local options = {}
		options["Alpha"] = 1.0
		_EffectService:PlayEffect(_GameConstants.EnemyHitEffectClip, self.Entity, center, 0, Vector3(s, s, 1), false, options)
		-- 적 피격음 (SoundTable: sfx_enemy_hit). Multicast라 전 클라에서 재생.
		_SoundManager:PlaySFXKey("sfx_enemy_hit")
	end

	@ExecSpace("Multicast")
	method void PlayDeathSfx(string key)
		-- 전 클라: 보스 사망음 재생 (서버 발단 이벤트).
		_SoundManager:PlaySFXKey(key)
	end

	@ExecSpace("Multicast")
	method void PlaySpeciesSfx(string action)
		-- 전 클라: 잡몹 종족음 재생. action=atk/death → sfx_<action>_<species>.
		-- Species 미지정이면 무음. 접촉형(pepe/jrbulldog) atk는 CSV enabled=FALSE라 Ruid=""=무음.
		if self.Species == "" then return end
		_SoundManager:PlaySFXKey("sfx_" .. action .. "_" .. self.Species)
	end

end
