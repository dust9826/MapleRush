@Component
script GroggyGauge extends Component

	-- 게이지 최대치 = 보스 전체(최대) 체력의 1/5 (stage_design §1.4.2)
	@Sync
	property number GaugeMax = 100.0

	@Sync
	property number Gauge = 0.0

	@Sync
	property boolean IsGroggy = false

	-- 그로기 종료 시각 (ServerElapsedSeconds)
	property number groggyEndAt = -999.0

	-- 서버: GaugeMax를 EnemyHealth 층 스케일링 완료 후 1회 재확정했는지. OnBeginPlay 실행순서 레이스 방지.
	@HideFromInspector property boolean gaugeMaxResolved = false

	-- 클라 전용: 그로기 표시 이펙트(보스 머리 위 루프) serial. IsGroggy 동기화에 맞춰 부착/제거.
	@HideFromInspector property any groggyFxSerial = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 게이지 최대치 = MaxHP × 1/5.
		---@type EnemyHealth
		local hp = self.Entity:GetComponent("script.EnemyHealth")
		if hp ~= nil then
			self.GaugeMax = hp.MaxHP * _GameConstants.GroggyGaugeRatio
		end
		self.Gauge = 0
		log("[GroggyGauge] init: max=" .. tostring(self.GaugeMax))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 자동 감소 초당 2% (서버 실시간 — 슬로우 무관) / 그로기 지속 3초 처리. 섬광탄 시 감소만 정지.
		-- ★GaugeMax 재확정: GroggyGauge.OnBeginPlay가 EnemyHealth의 층 스케일링(OnBeginPlay)보다 먼저 돌면
		--   스케일 전 기본 MaxHP로 게이지 최대치가 잡힌다. 모든 OnBeginPlay가 끝난 첫 OnUpdate엔 MaxHP가 확정돼
		--   있으므로 여기서 1회 재확정한다(그로기 충전은 전투 개시 grace 이후라 이 시점보다 항상 늦음).
		if self.gaugeMaxResolved == false then
			self.gaugeMaxResolved = true
			---@type EnemyHealth
			local hp = self.Entity:GetComponent("script.EnemyHealth")
			if hp ~= nil then
				self.GaugeMax = hp.MaxHP * _GameConstants.GroggyGaugeRatio
				log("[GroggyGauge] gaugeMax 재확정(post-scale): " .. tostring(self.GaugeMax))
			end
		end
		-- 일시정지: 게이지 자동감소(delta 기반)를 프리즈. 그로기 지속(groggyEndAt)은 게임 시계(WallClock)로 판정하므로 자동 정지 — 여기선 early-return으로 감소만 막으면 됨.
		if _StageManager:IsCombatPaused() then return end
		if self.IsGroggy then
			if _WallClock:ServerNow() >= self.groggyEndAt then
				self.IsGroggy = false
				self.Gauge = 0
				log("[GroggyGauge] groggy END — gauge reset")
			end
			return
		end
		if self.Gauge > 0 and _BattlefieldFx:IsGroggyDecayPaused() == false then
			self.Gauge = self.Gauge - self.GaugeMax * _GameConstants.GroggyDecayPerSec * delta
			if self.Gauge < 0 then self.Gauge = 0 end
		end
	end

	@ExecSpace("ServerOnly")
	method void Charge(number amount, string source)
		-- 게이지 충전. 그로기 중에는 충전 안 됨 (§1.4.4). 100% → 그로기 3초 발동.
		if self.IsGroggy then return end
		self.Gauge = self.Gauge + amount
		log("[GroggyGauge] +" .. tostring(amount) .. " (" .. source .. ") -> " .. string.format("%.1f", self.Gauge) .. "/" .. tostring(self.GaugeMax))
		if self.Gauge >= self.GaugeMax - 0.5 then
			self.IsGroggy = true
			self.groggyEndAt = _WallClock:ServerNow() + _GameConstants.GroggyDuration
			self:PlayGroggySfx()
			-- 콤보 +1: 그로기 "새 진입" 1회만. 위 `if self.IsGroggy then return end` 가드 덕분에
			-- 같은 그로기 구간의 반복 충전/이벤트는 여기 도달하지 않는다 (combo_doc §4.5/4.6).
			_ComboManager:OnBossGroggy()
			log("[GroggyGauge] *** GROGGY TRIGGERED *** (" .. tostring(_GameConstants.GroggyDuration) .. "s)")
		end
	end

	@ExecSpace("Multicast")
	method void PlayGroggySfx()
		-- 전 클라: 보스 그로기 발생음 (sfx_boss_groggy).
		_SoundManager:PlaySFXKey("sfx_boss_groggy")
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 그로기 상태 동기화에 맞춰 표시 이펙트 부착(true)/제거(false). effect_list #19(boss_groggy).
		if name == "IsGroggy" then
			if self.IsGroggy then
				self:ShowGroggyFx()
			else
				self:HideGroggyFx()
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowGroggyFx()
		-- 그로기 표시: 보스 머리 위에 부착 루프. 재발동 대비 이전 것 먼저 제거.
		self:HideGroggyFx()
		local clip = _EffectTable:Clip("boss_groggy")
		if clip == "" then return end
		local sc = _EffectTable:Scale("boss_groggy")
		local fo = _EffectTable:Offset("boss_groggy")
		self.groggyFxSerial = _EffectService:PlayEffectAttached(clip, self.Entity, Vector3(fo.x, fo.y, 0), _EffectTable:Rot("boss_groggy"), Vector3(sc.x, sc.y, 1), true, _EffectTable:Options("boss_groggy"))
		log("[GroggyGauge] groggy FX shown")
	end

	@ExecSpace("ClientOnly")
	method void HideGroggyFx()
		-- 그로기 표시 이펙트 제거(그로기 종료/보스 소멸).
		if self.groggyFxSerial ~= nil then
			_EffectService:RemoveEffect(self.groggyFxSerial)
			self.groggyFxSerial = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 보스 소멸 시 표시 이펙트 정리.
		self:HideGroggyFx()
	end

end
