@Logic
script BossConfig extends Logic

	-- 보스 전용 튜닝 설정 캡슐. GameConstants에서 보스 전투/패턴 수치를 분리해 가독성·수정 편의를 높인다.
	-- 접근은 전역 _BossConfig.<name> (PlayerConfig와 동일 패턴). 인스펙터에서 값 편집 가능.
	-- 이름은 GameConstants 시절과 동일 유지(접근 prefix만 _GameConstants → _BossConfig). 소비처: BossController / CombatGizmo.
	-- 경제(MesoPerBossClear)·맵 라우팅(MapBoss)·섬광 상호작용(FlashBossGroggyPause)은 보스 전투 튜닝이 아니라 GameConstants에 잔류.

	-- ===== 공용 / 거리밴드 (§1.6) =====
	property number BossHP = 500.0

	-- 패턴 간 공통 간격(초). resolve 후 delay.
	property number BossPatternDelay = 1.5

	-- 거리밴드 경계(가로거리 d): d≤Close=CLOSE(광역>근접>원거리) / d≤Mid=MID(광역>원거리) / 그외=FAR(원거리만).
	property number BossBandClose = 4.0

	property number BossBandMid = 7.5

	-- 좌우 쐐기(O3) 보스 발밑 안전지대 반폭(박스 중심 오프셋 = 이 값 + BoxHW). 자쿰 용암 랜덤 가로 분포 반경(보스중심 ±).
	property number BossSidesSafeHalf = 1.0

	property number BossMultiSpreadX = 6.0

	-- 3부채꼴(fan) 원거리 상하 벌림각 간격.
	property number BossTripleSpread = 0.6

	-- (보스 모션 클립 BossMove/Attack/Skill/GroggyClip는 CSV 이관 중인 레거시 폴백이라 GameConstants에 잔류)

	-- ===== 기본(더미) 보스 패턴 — slam / redSmash 골격 =====
	property number BossSlamBoxForward = 2.5

	property number BossSlamBoxHeight = 2.0

	property number BossRedSmashBoxHalfW = 3.5

	property number BossRedSmashBoxHalfH = 1.2

	-- ===== 엘리쟈(오르비스, O): O1 암흑구체(원거리 3부채꼴) / O2 암흑강림(추적 광역) / O3 그림자쐐기(좌우 2광역) =====
	property number BossO1Windup = 0.6

	property number BossO1Cd = 1.0

	property number BossO2Windup = 1.0

	property number BossO2Cd = 2.5

	property number BossO2BoxHW = 2.0

	property number BossO2BoxHH = 1.5

	property number BossO3Windup = 1.1

	property number BossO3Cd = 2.8

	property number BossO3BoxHW = 2.0

	property number BossO3BoxHH = 1.5

	-- ===== 스노우맨(엘나스, E): E1 눈주먹(근접) / E2 고드름(원거리 단발) / E3 블리자드(대형 광역) =====
	property number BossE1Windup = 0.9

	property number BossE1Cd = 1.2

	property number BossE1BoxHW = 1.8

	property number BossE1BoxHH = 1.0

	property number BossE2Windup = 0.7

	property number BossE2Cd = 1.1

	property number BossE3Windup = 1.1

	property number BossE3Cd = 2.8

	property number BossE3BoxHW = 3.5

	property number BossE3BoxHH = 2.0

	-- ===== 자쿰(폐광, Z): Z1 팔후려치기(근접) / Z2 박수레이저(수평 단발) / Z3 용암분출(다지점) =====
	property number BossZ1Windup = 0.7

	property number BossZ1Cd = 1.0

	-- P-Z1 팔 후려치기: 이펙트 폭에 맞춰 너비 ×0.5 (2.0→1.0). 높이는 유지.
	property number BossZ1BoxHW = 1.0

	property number BossZ1BoxHH = 1.0

	property number BossZ2Windup = 0.8

	property number BossZ2Cd = 1.0

	-- P-Z2 박수 레이저 발사 지점 오프셋(보스 발사방향 중심 이동, 월드유닛). 빔 비주얼은 EffectTable boss_zakum_beam.
	property number BossZakumBeamOffsetX = 4.0

	property number BossZ3Windup = 1.0

	property number BossZ3Cd = 2.5

	-- P-Z3 용암 분출: 이펙트(세로 기둥)에 맞춰 너비 ×0.5(1.5→0.75) / 높이 ×2(1.5→3.0).
	property number BossZ3BoxHW = 0.75

	property number BossZ3BoxHH = 3.0

	property integer BossZ3Points = 3

	-- P-Z3 용암(불기둥) 히트박스·예고를 세로 길이(2×HH)의 이 비율만큼 위로 올림. 이펙트는 바닥 유지(판정만 상향).
	property number BossZ3BoxYUpFactor = 0.3

end
